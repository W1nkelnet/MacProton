From 88e0e140ff6d1ce1adc01a5745815689c4b7df54 Mon Sep 17 00:00:00 2001
From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Wed, 28 Oct 2026 13:52:23 +0100
Subject: [PATCH 2/3] vkd3d: Bind a zeroed buffer for null vertex buffers
 without nullDescriptor.

MoltenVK has no nullDescriptor and dereferences every buffer passed to
vkCmdBindVertexBuffers2. A null VBO only worked by chance under Wine,
whose mapped low memory made the null MVKBuffer read as empty. Substitute
a small zeroed buffer at the one place that binds VBOs, which also covers
slots a pipeline uses but the application never set.

Null descriptors themselves need nothing: MoltenVK writes them as nil and
Metal reads zero, so correct the warning that promised dummy resources.
---
 libs/vkd3d/command.c       |  8 +++++++
 libs/vkd3d/device.c        | 44 +++++++++++++++++++++++++++++++++++++-
 libs/vkd3d/vkd3d_private.h |  4 ++++
 3 files changed, 55 insertions(+), 1 deletion(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index e30a09a..7a868fe 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -8061,6 +8061,14 @@ static void d3d12_command_list_update_dynamic_state(struct d3d12_command_list *l
 
             for (i = 0; i < range.count; i++)
             {
+                if (!dyn_state->vertex_buffers[i + range.offset] && list->device->null_vbo)
+                {
+                    /* Without nullDescriptor, a null VBO must still be a real buffer */
+                    dyn_state->vertex_buffers[i + range.offset] = list->device->null_vbo;
+                    dyn_state->vertex_offsets[i + range.offset] = 0;
+                    dyn_state->vertex_sizes[i + range.offset] = VKD3D_NULL_BUFFER_SIZE;
+                }
+
                 if (dyn_state->vertex_offsets[i + range.offset] & stride_align_masks[i + range.offset])
                 {
                     FIXME("Binding VBO at offset %"PRIu64", but required alignment is %u.\n",
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 308a50f..de6e663 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -3285,7 +3285,7 @@ static HRESULT vkd3d_init_device_caps(struct d3d12_device *device,
             ERR("Null descriptor in VK_EXT_robustness2 is not supported by this implementation. This is required for correct operation.\n");
             return E_INVALIDARG;
         }
-        WARN("Null descriptor not supported by portability device, using dummy resources.\n");
+        WARN("Null descriptor not supported by portability device, null descriptors stay unbound and null VBOs read zero.\n");
     }
 
     if (vulkan_info->KHR_fragment_shading_rate)
@@ -4636,6 +4636,45 @@ static void vkd3d_null_rtas_allocation_cleanup(
     }
 }
 
+static void d3d12_device_init_null_vbo(struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    void *data;
+
+    if (device->device_info.robustness2_features.nullDescriptor)
+        return;
+
+    if (FAILED(vkd3d_create_buffer_explicit_usage(device, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT,
+            VKD3D_NULL_BUFFER_SIZE, "null-vbo", &device->null_vbo)))
+    {
+        ERR("Failed to create null VBO.\n");
+        return;
+    }
+
+    if (FAILED(vkd3d_allocate_internal_buffer_memory(device, device->null_vbo,
+            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, &device->null_vbo_alloc)) ||
+            VK_CALL(vkMapMemory(device->vk_device, device->null_vbo_alloc.vk_memory, 0, VK_WHOLE_SIZE, 0, &data)) != VK_SUCCESS)
+    {
+        ERR("Failed to allocate null VBO memory.\n");
+        VK_CALL(vkDestroyBuffer(device->vk_device, device->null_vbo, NULL));
+        vkd3d_free_device_memory(device, &device->null_vbo_alloc);
+        device->null_vbo = VK_NULL_HANDLE;
+        return;
+    }
+
+    /* Null vertex buffers read as zero */
+    memset(data, 0, VKD3D_NULL_BUFFER_SIZE);
+    VK_CALL(vkUnmapMemory(device->vk_device, device->null_vbo_alloc.vk_memory));
+}
+
+static void d3d12_device_cleanup_null_vbo(struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+
+    VK_CALL(vkDestroyBuffer(device->vk_device, device->null_vbo, NULL));
+    vkd3d_free_device_memory(device, &device->null_vbo_alloc);
+}
+
 static void d3d12_device_destroy(struct d3d12_device *device)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
@@ -4681,6 +4720,7 @@ static void d3d12_device_destroy(struct d3d12_device *device)
     d3d12_device_destroy_vkd3d_queues(device);
     VK_CALL(vkDestroySemaphore(device->vk_device, device->sparse_init_timeline, NULL));
     vkd3d_null_rtas_allocation_cleanup(&device->null_rtas_allocation, device);
+    d3d12_device_cleanup_null_vbo(device);
     vkd3d_memory_allocator_cleanup(&device->memory_allocator, device);
     vkd3d_memory_transfer_queue_cleanup(&device->memory_transfers);
     vkd3d_global_descriptor_buffer_cleanup(&device->global_descriptor_buffer, device);
@@ -10552,6 +10592,7 @@ static HRESULT d3d12_device_init(struct d3d12_device *device,
     if (FAILED(hr = vkd3d_address_binding_tracker_init(&device->address_binding_tracker, device)))
         goto out_cleanup_queue_timeline_trace;
 
+    d3d12_device_init_null_vbo(device);
     vkd3d_scratch_pool_init(device);
 
 #ifdef VKD3D_ENABLE_BREADCRUMBS
@@ -10619,6 +10660,7 @@ out_cleanup_breadcrumb_tracer:
         vkd3d_breadcrumb_tracer_cleanup(&device->breadcrumb_tracer, device);
 out_cleanup_address_binding_tracker:
 #endif
+    d3d12_device_cleanup_null_vbo(device);
     vkd3d_address_binding_tracker_cleanup(&device->address_binding_tracker, device);
 out_cleanup_queue_timeline_trace:
     vkd3d_queue_timeline_trace_cleanup(&device->queue_timeline_trace);
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 9616a3a..44815a5 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -5490,6 +5490,10 @@ struct d3d12_device
     struct vkd3d_memory_allocator memory_allocator;
     struct vkd3d_null_rtas_allocation null_rtas_allocation;
 
+    /* Bound in place of null vertex buffers if the device lacks nullDescriptor */
+    VkBuffer null_vbo;
+    struct vkd3d_device_memory_allocation null_vbo_alloc;
+
     struct vkd3d_queue *internal_sparse_queue;
     VkSemaphore sparse_init_timeline;
     uint64_t sparse_init_timeline_value;
-- 
