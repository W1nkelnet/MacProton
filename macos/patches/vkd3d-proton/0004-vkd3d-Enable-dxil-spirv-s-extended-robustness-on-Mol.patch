From 304c8202fb57ba9642500e76d4a5b4fbeeb250f0 Mon Sep 17 00:00:00 2001
From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Wed, 28 Oct 2026 16:40:43 +0100
Subject: [PATCH] vkd3d: Enable dxil-spirv's extended robustness on MoltenVK.

Out of bounds accesses to local arrays and constant tables, which D3D12
drivers tolerate, can fault on Apple GPUs. dxil-spirv bounds checks them
with DXIL_SPV_OPTION_EXTENDED_ROBUSTNESS; group shared memory is not
implemented there yet. The shader interface key includes the switch, so
cached SPIR-V without the checks is not reused.
---
 include/vkd3d_shader.h   |  3 +++
 libs/vkd3d-shader/dxil.c | 11 +++++++++++
 libs/vkd3d/device.c      |  2 ++
 libs/vkd3d/state.c       |  3 +++
 4 files changed, 19 insertions(+)

diff --git a/include/vkd3d_shader.h b/include/vkd3d_shader.h
index c40923b..2baae9b 100644
--- a/include/vkd3d_shader.h
+++ b/include/vkd3d_shader.h
@@ -261,6 +261,9 @@ enum vkd3d_shader_interface_flag
     VKD3D_SHADER_INTERFACE_INSTRUCTION_QA_BUFFER_EXPECT_ASSUME = 0x00000200u,
     VKD3D_SHADER_INTERFACE_INSTRUCTION_QA_BUFFER_SYNC          = 0x00000400u,
     VKD3D_SHADER_INTERFACE_INSTRUCTION_QA_BUFFER_SYNC_COMPUTE  = 0x00000800u,
+    /* Bounds check local arrays and constant tables (and group shared memory,
+     * once dxil-spirv implements it) */
+    VKD3D_SHADER_INTERFACE_EXTENDED_ROBUSTNESS                 = 0x00001000u,
 };
 
 struct vkd3d_shader_stage_io_entry
diff --git a/libs/vkd3d-shader/dxil.c b/libs/vkd3d-shader/dxil.c
index bdad5e8..43ff727 100644
--- a/libs/vkd3d-shader/dxil.c
+++ b/libs/vkd3d-shader/dxil.c
@@ -739,6 +739,17 @@ static int vkd3d_dxil_converter_set_options(dxil_spv_converter converter,
         }
     }
 
+    if (shader_interface_info->flags & VKD3D_SHADER_INTERFACE_EXTENDED_ROBUSTNESS)
+    {
+        const struct dxil_spv_option_extended_robustness helper =
+                { { DXIL_SPV_OPTION_EXTENDED_ROBUSTNESS }, DXIL_SPV_TRUE, DXIL_SPV_TRUE, DXIL_SPV_TRUE };
+        if (dxil_spv_converter_add_option(converter, &helper.base) != DXIL_SPV_SUCCESS)
+        {
+            ERR("dxil-spirv does not support EXTENDED_ROBUSTNESS.\n");
+            return VKD3D_ERROR_NOT_IMPLEMENTED;
+        }
+    }
+
     if (shader_interface_info->flags & VKD3D_SHADER_INTERFACE_TYPED_OFFSET_BUFFER)
     {
         const struct dxil_spv_option_bindless_typed_buffer_offsets helper =
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 52796a6..d0c6485 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -10327,6 +10327,8 @@ static void vkd3d_compute_shader_interface_key(struct d3d12_device *device)
     key = hash_fnv1_iterate_u32(key, device->device_info.vulkan_1_3_properties.minSubgroupSize);
     key = hash_fnv1_iterate_u32(key, device->device_info.vulkan_1_3_properties.maxSubgroupSize);
     key = hash_fnv1_iterate_u32(key, device->bindless_state.flags);
+    /* Enables VKD3D_SHADER_INTERFACE_EXTENDED_ROBUSTNESS */
+    key = hash_fnv1_iterate_u32(key, device->device_info.vulkan_1_2_properties.driverID == VK_DRIVER_ID_MOLTENVK);
     key = hash_fnv1_iterate_u32(key, device->bindless_state.cbv_srv_uav_count);
     key = hash_fnv1_iterate_u32(key, device->bindless_state.set_count);
     for (i = 0; i < device->bindless_state.set_count; i++)
diff --git a/libs/vkd3d/state.c b/libs/vkd3d/state.c
index 577d3b0..6dbd864 100644
--- a/libs/vkd3d/state.c
+++ b/libs/vkd3d/state.c
@@ -1845,6 +1845,9 @@ unsigned int d3d12_root_signature_get_shader_interface_flags(const struct d3d12_
         flags |= VKD3D_SHADER_INTERFACE_BINDLESS_CBV_AS_STORAGE_BUFFER;
     if (d3d12_device_use_embedded_mutable_descriptors(root_signature->device))
         flags |= VKD3D_SHADER_INTERFACE_RAW_VA_ALIAS_DESCRIPTOR_BUFFER;
+    /* Out of bounds accesses that D3D12 drivers tolerate fault on Apple GPUs */
+    if (root_signature->device->device_info.vulkan_1_2_properties.driverID == VK_DRIVER_ID_MOLTENVK)
+        flags |= VKD3D_SHADER_INTERFACE_EXTENDED_ROBUSTNESS;
 
     return flags;
 }
-- 
