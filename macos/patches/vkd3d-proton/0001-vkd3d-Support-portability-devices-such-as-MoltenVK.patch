From 73d15384c2937e49a63e4855aec04cb95d5e9dfc Mon Sep 17 00:00:00 2001
From: Mark <mrmarkap61@gmail.com>
Date: Wed, 28 Oct 2026 13:13:19 +0100
Subject: [PATCH] vkd3d: Support portability devices such as MoltenVK.

MoltenVK lacks robustBufferAccess2, nullDescriptor, transform feedback
and single texel buffer alignment. On a portability device these only
produce warnings: out-of-bounds access is undefined, stream output is
unavailable and texel buffer views need aligned offsets.

vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR is optional, since it
belongs to an extension and is only called when that is supported.

The memory decompression shaders keep the dispatch size in separate
members instead of a uvec3, as MSL has no atomics on vector elements.
---
 libs/vkd3d/device.c                           | 35 ++++++++++++++-----
 ..._emit_nv_memory_decompression_regions.comp |  7 ++--
 ...it_nv_memory_decompression_workgroups.comp |  9 +++--
 libs/vkd3d/vulkan_procs.h                     |  2 +-
 4 files changed, 40 insertions(+), 13 deletions(-)

diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 6c713c9..308a50f 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -3082,6 +3082,8 @@ static HRESULT vkd3d_init_device_caps(struct d3d12_device *device,
     VkPhysicalDeviceFeatures *features;
     bool single_storage_texel;
     bool single_uniform_texel;
+    /* MoltenVK lacks some required features; run with what it has rather than not at all */
+    bool portability = physical_device_info->vulkan_1_2_properties.driverID == VK_DRIVER_ID_MOLTENVK;
 
     vkd3d_trace_physical_device(physical_device, physical_device_info, vk_procs);
     vkd3d_trace_physical_device_features(physical_device_info);
@@ -3122,8 +3124,12 @@ static HRESULT vkd3d_init_device_caps(struct d3d12_device *device,
 
     if (!physical_device_info->xfb_properties.transformFeedbackQueries)
     {
-        ERR("Lacking support for transform feedback.\n");
-        return E_INVALIDARG;
+        if (!portability)
+        {
+            ERR("Lacking support for transform feedback.\n");
+            return E_INVALIDARG;
+        }
+        WARN("Transform feedback not supported by portability device, stream output is unavailable.\n");
     }
 
     single_storage_texel =
@@ -3137,8 +3143,13 @@ static HRESULT vkd3d_init_device_caps(struct d3d12_device *device,
 
     if (!single_storage_texel || !single_uniform_texel)
     {
-        ERR("Lacking support for single texel alignment.\n");
-        return E_INVALIDARG;
+        if (!portability)
+        {
+            ERR("Lacking support for single texel alignment.\n");
+            return E_INVALIDARG;
+        }
+        WARN("Portability device needs %"PRIu64"-byte aligned texel buffer offsets.\n",
+                (uint64_t)physical_device_info->vulkan_1_3_properties.storageTexelBufferOffsetAlignmentBytes);
     }
 
     /* Disable unused Vulkan features. The following features need to remain enabled
@@ -3259,14 +3270,22 @@ static HRESULT vkd3d_init_device_caps(struct d3d12_device *device,
     if (!physical_device_info->robustness2_features.robustBufferAccess2 ||
             !physical_device_info->robustness2_features.robustImageAccess2)
     {
-        ERR("Robustness2 features not supported. This is required.\n");
-        return E_INVALIDARG;
+        if (!portability)
+        {
+            ERR("Robustness2 features not supported. This is required.\n");
+            return E_INVALIDARG;
+        }
+        WARN("Robustness2 features not supported by portability device, out-of-bounds access is undefined.\n");
     }
 
     if (!physical_device_info->robustness2_features.nullDescriptor)
     {
-        ERR("Null descriptor in VK_EXT_robustness2 is not supported by this implementation. This is required for correct operation.\n");
-        return E_INVALIDARG;
+        if (!portability)
+        {
+            ERR("Null descriptor in VK_EXT_robustness2 is not supported by this implementation. This is required for correct operation.\n");
+            return E_INVALIDARG;
+        }
+        WARN("Null descriptor not supported by portability device, using dummy resources.\n");
     }
 
     if (vulkan_info->KHR_fragment_shading_rate)
diff --git a/libs/vkd3d/shaders/cs_emit_nv_memory_decompression_regions.comp b/libs/vkd3d/shaders/cs_emit_nv_memory_decompression_regions.comp
index 2978f0b..a754800 100644
--- a/libs/vkd3d/shaders/cs_emit_nv_memory_decompression_regions.comp
+++ b/libs/vkd3d/shaders/cs_emit_nv_memory_decompression_regions.comp
@@ -43,7 +43,10 @@ struct memory_region_t {
 
 layout(buffer_reference, scalar)
 buffer memory_regions_t {
-  uvec3 region_count;
+  /* Dispatch size x, y, z. Separate members, as MSL has no atomics on vector elements. */
+  uint  region_count_x;
+  uint  region_count_y;
+  uint  region_count_z;
   uint  reserved;
   memory_region_t memory_regions[];
 };
@@ -102,7 +105,7 @@ void main() {
 
   // Allocate an output region structure from the scratch buffer
   memory_regions_t region_buffer = memory_regions_t(scratch_buffer);
-  uint out_index = atomicAdd(region_buffer.region_count.x, 1);
+  uint out_index = atomicAdd(region_buffer.region_count_x, 1);
 
   // Compute absolute VAs for vkCmdDecompressMemoryIndirectCountNV
   region_buffer.memory_regions[out_index] = memory_region_t(
diff --git a/libs/vkd3d/shaders/cs_emit_nv_memory_decompression_workgroups.comp b/libs/vkd3d/shaders/cs_emit_nv_memory_decompression_workgroups.comp
index aea1124..d5ebeb4 100644
--- a/libs/vkd3d/shaders/cs_emit_nv_memory_decompression_workgroups.comp
+++ b/libs/vkd3d/shaders/cs_emit_nv_memory_decompression_workgroups.comp
@@ -48,7 +48,10 @@ struct memory_region_t {
 
 layout(buffer_reference, scalar)
 writeonly buffer memory_regions_t {
-  uvec3 region_count;
+  /* Dispatch size x, y, z. Separate members, as MSL has no atomics on vector elements. */
+  uint  region_count_x;
+  uint  region_count_y;
+  uint  region_count_z;
   uint  reserved;
   memory_region_t memory_regions[];
 };
@@ -70,7 +73,9 @@ void main() {
   // Reset memory region count that is later passed the decompression command.
   if (stream_index == 0u) {
     memory_regions_t region_buffer = memory_regions_t(scratch_buffer);
-    region_buffer.region_count = uvec3(0u, 1u, 1u);
+    region_buffer.region_count_x = 0u;
+    region_buffer.region_count_y = 1u;
+    region_buffer.region_count_z = 1u;
   }
 
   if (stream_index >= stream_count)
diff --git a/libs/vkd3d/vulkan_procs.h b/libs/vkd3d/vulkan_procs.h
index fe09f4d..04bea21 100644
--- a/libs/vkd3d/vulkan_procs.h
+++ b/libs/vkd3d/vulkan_procs.h
@@ -382,7 +382,7 @@ VK_DEVICE_EXT_PFN(vkGetLatencyTimingsNV)
 VK_DEVICE_EXT_PFN(vkQueueNotifyOutOfBandNV)
 
 /* VK_KHR_cooperative_matrix */
-VK_INSTANCE_PFN(vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR)
+VK_INSTANCE_EXT_PFN(vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR)
 
 /* VK_EXT_opacity_micromap */
 VK_DEVICE_EXT_PFN(vkGetMicromapBuildSizesEXT)
-- 
2.56.0

