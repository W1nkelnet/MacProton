From 0d472b563916d94c327870cec6960a11aa0386ce Mon Sep 17 00:00:00 2001
From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Wed, 28 Oct 2026 18:00:34 +0100
Subject: [PATCH 5/7] vkd3d-shader: Bump the shader revision for clamped group
 shared access.

dxil-spirv now clamps group shared array indices with extended
robustness. Cached SPIR-V from before has no clamps, so do not reuse it.
---
 libs/vkd3d-shader/vkd3d_shader_main.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libs/vkd3d-shader/vkd3d_shader_main.c b/libs/vkd3d-shader/vkd3d_shader_main.c
index a4c19d1..53487e3 100644
--- a/libs/vkd3d-shader/vkd3d_shader_main.c
+++ b/libs/vkd3d-shader/vkd3d_shader_main.c
@@ -545,7 +545,7 @@ uint64_t vkd3d_shader_get_revision(vkd3d_shader_quirks_t *aux_quirks)
     if (aux_quirks)
         *aux_quirks = quirks;
 
-    return quirk_hash ^ 1;
+    return quirk_hash ^ 2;
 }
 
 struct vkd3d_shader_stage_io_entry *vkd3d_shader_stage_io_map_append(struct vkd3d_shader_stage_io_map *map,
-- 
2.56.0

