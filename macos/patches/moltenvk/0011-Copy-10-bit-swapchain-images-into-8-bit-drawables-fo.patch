+#pragma mark Format conversion
+
+// Steam's overlay for macOS games, which Wine games load too, draws into the
+// drawable as if it had 8 bits per channel, and garbles the 10-bit drawables
+// that games such as Unreal ones with Direct3D 12 use. With the overlay loaded,
+// such a swapchain renders to textures of its own format, and each present
+// copies one into an 8-bit drawable. The values are the same, only rounded.
+static bool mvkIsSteamOverlayLoaded() {
+	static bool isLoaded = [] {
+		for (uint32_t i = 0; i < _dyld_image_count(); i++) {
+			const char* name = _dyld_get_image_name(i);
+			if (name && strstr(name, "gameoverlayrenderer")) { return true; }
+		}
+		return false;
+	}();
+	return isLoaded;
+}
+
+void MVKSwapchain::initFormatConversion(MTLPixelFormat mtlPixFmt) {
+	[_mtlConversionPipeline release];
+	_mtlConversionPipeline = nil;
+
+	if (isHeadless() || !mvkIsSteamOverlayLoaded()) { return; }
+	if (mtlPixFmt != MTLPixelFormatRGB10A2Unorm && mtlPixFmt != MTLPixelFormatBGR10A2Unorm) { return; }
+
+	@autoreleasepool {
+		NSString* source = @"#include <metal_stdlib>\n"
+			"using namespace metal;\n"
+			"struct V { float4 position [[position]]; };\n"
+			"vertex V mvkCopyVertex(uint vid [[vertex_id]]) {\n"
+			"    float2 uv = float2((vid << 1) & 2, vid & 2);\n"
+			"    return { float4(uv * float2(2, -2) + float2(-1, 1), 0, 1) };\n"
+			"}\n"
+			"fragment float4 mvkCopyFragment(V in [[stage_in]], texture2d<float> src [[texture(0)]]) {\n"
+			"    return src.read(uint2(in.position.xy));\n"
+			"}\n";
+		NSError* err = nil;
+		id<MTLLibrary> lib = [[getMTLDevice() newLibraryWithSource: source options: nil error: &err] autorelease];
+		if ( !lib) {
+			reportWarning(VK_ERROR_FEATURE_NOT_PRESENT, "Could not compile the swapchain format conversion: %s", err.localizedDescription.UTF8String);
+			return;
+		}
+		MTLRenderPipelineDescriptor* desc = [[MTLRenderPipelineDescriptor new] autorelease];
+		desc.vertexFunction = [[lib newFunctionWithName: @"mvkCopyVertex"] autorelease];
+		desc.fragmentFunction = [[lib newFunctionWithName: @"mvkCopyFragment"] autorelease];
+		desc.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
+		_mtlConversionPipeline = [getMTLDevice() newRenderPipelineStateWithDescriptor: desc error: &err];	// retained
+		if ( !_mtlConversionPipeline) {
+			reportWarning(VK_ERROR_FEATURE_NOT_PRESENT, "Could not create the swapchain format conversion: %s", err.localizedDescription.UTF8String);
+			return;
+		}
+	}
+	MVKLogInfo("Copying %s swapchain images into 8-bit drawables for the Steam overlay.", getPixelFormats()->getName(mtlPixFmt));
+}
+
+void MVKSwapchain::encodeConversion(id<MTLTexture> mtlSrcTex, id<MTLTexture> mtlDstTex, id<MTLCommandBuffer> mtlCmdBuff) {
+	MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+	pass.colorAttachments[0].texture = mtlDstTex;
+	pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+	pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+	id<MTLRenderCommandEncoder> encoder = [mtlCmdBuff renderCommandEncoderWithDescriptor: pass];
+	[encoder setRenderPipelineState: _mtlConversionPipeline];
+	[encoder setFragmentTexture: mtlSrcTex atIndex: 0];
+	[encoder drawPrimitives: MTLPrimitiveTypeTriangle vertexStart: 0 vertexCount: 3];
+	[encoder endEncoding];
+}
+
 MTLTextureUsage MVKSwapchain::getUpscalerInputUsage() {
 	return ((id<MTLFXSpatialScaler>)_mtlUpscaler).colorTextureUsage;
 }
