index d7b59cc7..eb93fe2f 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
@@ -27,7 +27,13 @@
 #include "MVKGeometryShaderEmulation.h"
 #include "mvk_datatypes.hpp"
 #include <sys/stat.h>
+#include <sys/file.h>
 #include <sstream>
+#include <dirent.h>
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <mach-o/loader.h>
 
