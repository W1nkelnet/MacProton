index c5b74991..601baf83 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.h
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.h
@@ -24,6 +24,7 @@
 #include "MVKSmallVector.h"
 #include <MoltenVKShaderConverter/SPIRVToMSLConverter.h>
 #include <mutex>
+#include <unordered_map>
 
 #import <Metal/Metal.h>
 
@@ -236,6 +237,63 @@ namespace std {
 	};
 }
 
+#pragma mark -
+#pragma mark MVKShaderDiskCache
+
+/**
+ * Keeps the results of SPIR-V to MSL conversions in a file, so later runs skip the conversion,
+ * when the MVK_CONFIG_SHADER_CACHE_DIR environment variable names a directory. Entries are keyed
+ * by the SPIR-V code and the shader conversion configuration a pipeline requests. Each build of
+ * MoltenVK and each device has a file of its own, and files of other builds are removed.
+ */
+class MVKShaderDiskCache {
+
+public:
+
+	/** Returns the cache for the device of the object, or null if there is none. */
+	static MVKShaderDiskCache* get(MVKBaseDeviceObject* obj);
+
+	/** Returns the key of a requested shader conversion configuration, before conversion. */
+	uint64_t getRequestHash(const mvk::SPIRVToMSLConversionConfiguration& request);
+
+	/** Looks up a conversion, returning the configuration after conversion with its results. */
+	bool find(MVKShaderModuleKey smKey, uint64_t requestHash,
+			  mvk::SPIRVToMSLConversionConfiguration& config,
+			  mvk::SPIRVToMSLConversionResultInfo& resultInfo,
+			  MVKCompressor<std::string>& compressedMSL);
+
+	/** Adds a conversion, with the configuration after conversion. */
+	void add(MVKShaderModuleKey smKey, uint64_t requestHash,
+			 const mvk::SPIRVToMSLConversionConfiguration& config,
+			 const mvk::SPIRVToMSLConversionResultInfo& resultInfo,
+			 const std::string& msl);
+
+protected:
+	struct Key {
+		uint64_t codeSize;
+		uint64_t codeHash;
+		uint64_t requestHash;
+		bool operator==(const Key& rhs) const {
+			return codeSize == rhs.codeSize && codeHash == rhs.codeHash && requestHash == rhs.requestHash;
+		}
+	};
+	struct KeyHash {
+		std::size_t operator()(const Key& k) const { return k.codeHash ^ (k.requestHash * 0x9E3779B97F4A7C15ull) ^ k.codeSize; }
+	};
+	struct Entry {
+		uint64_t offset;
+		uint32_t size;
+		uint64_t checksum;
+	};
+
+	MVKShaderDiskCache(const char* dir, const char* name, const void* fileHeader, size_t fileHeaderSize);
+
+	std::unordered_map<Key, Entry, KeyHash> _index;
+	std::mutex _lock;
+	int _fd = -1;
+};
+
+
 /** Represents a Vulkan shader module. */
 class MVKShaderModule : public MVKVulkanAPIDeviceObject {
 
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm
index 3aa44a44..657defa2 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKShaderModule.mm
@@ -323,10 +323,29 @@ MVKShaderLibrary* MVKShaderLibraryCache::getShaderLibrary(SPIRVToMSLConversionCo
 														  uint64_t startTime) {
 	bool wasAdded = false;
 	MVKShaderLibrary* shLib = findShaderLibrary(pShaderConfig, pShaderFeedback, startTime);
+	auto* diskCache = shLib ? nullptr : MVKShaderDiskCache::get(this);
+	uint64_t requestHash = diskCache ? diskCache->getRequestHash(*pShaderConfig) : 0;
+	if (diskCache) {
+		SPIRVToMSLConversionConfiguration cachedConfig;
+		SPIRVToMSLConversionResultInfo cachedResultInfo;
+		MVKCompressor<std::string> cachedMSL;
+		if (diskCache->find(shaderModule->getKey(), requestHash, cachedConfig, cachedResultInfo, cachedMSL)) {
+			pShaderConfig->alignWith(cachedConfig);
+			shLib = addShaderLibrary(&cachedConfig, cachedResultInfo, cachedMSL);
+			addPerformanceInterval(getPerformanceStats().shaderCompilation.shaderLibraryFromCache, startTime);
+			if (pShaderFeedback) {
+				pShaderFeedback->duration += mvkGetElapsedNanoseconds(startTime);
+			}
+			wasAdded = true;
+		}
+	}
 	if ( !shLib && !pipeline->shouldFailOnPipelineCompileRequired() ) {
 		SPIRVToMSLConversionResult conversionResult;
 		if (shaderModule->convert(pShaderConfig, conversionResult)) {
 			shLib = addShaderLibrary(pShaderConfig, conversionResult);
+			if (diskCache) {
+				diskCache->add(shaderModule->getKey(), requestHash, *pShaderConfig, conversionResult.resultInfo, conversionResult.msl);
+			}
 			if (pShaderFeedback) {
 				pShaderFeedback->duration += mvkGetElapsedNanoseconds(startTime);
 			}
