 #define MVK_USE_CEREAL (1)
@@ -3624,6 +3630,239 @@ void serialize(Archive & archive, MVKCompressor<C>& comp) {
 }
 
 
+#pragma mark -
+#pragma mark MVKShaderDiskCache
+
+// The file starts with a header naming the build of MoltenVK and the device. Records follow, each
+// a fixed-size header and a payload, appended as soon as a conversion completes. A record cut
+// short, because the process ended while writing it, ends the file.
+
+static const char kMVKShaderDiskCacheMagic[8] = { 'M', 'V', 'K', 'S', 'H', 'D', 'C', '1' };
+static const uint32_t kMVKShaderDiskCacheRecordMagic = 0x4352564D;
+
+typedef struct {
+	char magic[8];
+	uint8_t buildUUID[16];
+	uint8_t pipelineCacheUUID[VK_UUID_SIZE];
+	uint32_t vendorID;
+	uint32_t deviceID;
+} MVKShaderDiskCacheFileHeader;
+
+typedef struct {
+	uint32_t magic;
+	uint32_t payloadSize;
+	uint64_t codeSize;
+	uint64_t codeHash;
+	uint64_t requestHash;
+	uint64_t checksum;
+} MVKShaderDiskCacheRecordHeader;
+
+static uint64_t mvkShaderDiskCacheHash(const void* data, size_t size) {
+	auto* bytes = (const uint8_t*)data;
+	uint64_t hash = 0xcbf29ce484222325ull;		// FNV-1a
+	for (size_t i = 0; i < size; i++) { hash = (hash ^ bytes[i]) * 0x100000001b3ull; }
+	return hash;
+}
+
+// The UUID of the image holding MoltenVK, which changes with any change to its code.
+static bool mvkGetBuildUUID(uint8_t* uuid) {
+	Dl_info info;
+	if ( !dladdr((const void*)&mvkGetBuildUUID, &info) || !info.dli_fbase) { return false; }
+	auto* header = (const struct mach_header_64*)info.dli_fbase;
+	if (header->magic != MH_MAGIC_64) { return false; }
+	auto* cmd = (const struct load_command*)(header + 1);
+	for (uint32_t i = 0; i < header->ncmds; i++) {
+		if (cmd->cmd == LC_UUID) {
+			memcpy(uuid, ((const struct uuid_command*)cmd)->uuid, 16);
+			return true;
+		}
+		cmd = (const struct load_command*)((const uint8_t*)cmd + cmd->cmdsize);
+	}
+	return false;
+}
+
+MVKShaderDiskCache* MVKShaderDiskCache::get(MVKBaseDeviceObject* obj) {
+#if MVK_USE_CEREAL
+	static const char* dir = getenv("MVK_CONFIG_SHADER_CACHE_DIR");
+	if ( !dir || !*dir ) { return nullptr; }
+
+	static uint8_t buildUUID[16];
+	static bool hasBuildUUID = mvkGetBuildUUID(buildUUID);
+	if ( !hasBuildUUID ) { return nullptr; }
+
+	MVKShaderDiskCacheFileHeader hdr;
+	memset(&hdr, 0, sizeof(hdr));
+	memcpy(hdr.magic, kMVKShaderDiskCacheMagic, sizeof(hdr.magic));
+	memcpy(hdr.buildUUID, buildUUID, sizeof(hdr.buildUUID));
+	auto& props = obj->getDeviceProperties();
+	memcpy(hdr.pipelineCacheUUID, props.pipelineCacheUUID, VK_UUID_SIZE);
+	hdr.vendorID = props.vendorID;
+	hdr.deviceID = props.deviceID;
+
+	char name[64];
+	snprintf(name, sizeof(name), "moltenvk-%016llx.cache", mvkShaderDiskCacheHash(&hdr, sizeof(hdr)));
+
+	// Caches live as long as the process
+	static mutex cachesLock;
+	static unordered_map<string, MVKShaderDiskCache*> caches;
+	lock_guard<mutex> lock(cachesLock);
+	auto& cache = caches[name];
+	if ( !cache ) { cache = new MVKShaderDiskCache(dir, name, &hdr, sizeof(hdr)); }
+	return cache->_fd >= 0 ? cache : nullptr;
+#else
+	return nullptr;
+#endif
+}
+
+MVKShaderDiskCache::MVKShaderDiskCache(const char* dir, const char* name, const void* fileHeader, size_t fileHeaderSize) {
+	auto& hdr = *(const MVKShaderDiskCacheFileHeader*)fileHeader;
+	mkdir(dir, 0755);
+
+	// Remove the files of other builds, and keep those of other devices
+	if (DIR* dirStream = opendir(dir)) {
+		while (struct dirent* ent = readdir(dirStream)) {
+			size_t len = strlen(ent->d_name);
+			if (strncmp(ent->d_name, "moltenvk-", 9) != 0 || len < 6 || strcmp(ent->d_name + len - 6, ".cache") != 0) { continue; }
+			string path = string(dir) + "/" + ent->d_name;
+			MVKShaderDiskCacheFileHeader other;
+			int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+			if (fd < 0) { continue; }
+			bool isStale = (read(fd, &other, sizeof(other)) == sizeof(other) &&
+							memcmp(other.magic, hdr.magic, sizeof(hdr.magic)) == 0 &&
+							memcmp(other.buildUUID, hdr.buildUUID, sizeof(hdr.buildUUID)) != 0);
+			close(fd);
+			if (isStale) { unlink(path.c_str()); }
+		}
+		closedir(dirStream);
+	}
+
+	string path = string(dir) + "/" + name;
+	_fd = open(path.c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+	if (_fd < 0) {
+		MVKBaseObject::reportMessage(nullptr, MVK_CONFIG_LOG_LEVEL_WARNING, "Could not open the shader cache %s: %s", path.c_str(), strerror(errno));
+		return;
+	}
+
+	// Other processes may append to the same file
+	flock(_fd, LOCK_EX);
+	MVKShaderDiskCacheFileHeader fileHdr;
+	if (pread(_fd, &fileHdr, sizeof(fileHdr), 0) != sizeof(fileHdr) || memcmp(&fileHdr, &hdr, sizeof(hdr)) != 0) {
+		if (ftruncate(_fd, 0) != 0 || pwrite(_fd, &hdr, sizeof(hdr), 0) != sizeof(hdr)) {
+			MVKBaseObject::reportMessage(nullptr, MVK_CONFIG_LOG_LEVEL_WARNING, "Could not write the shader cache %s: %s", path.c_str(), strerror(errno));
+			flock(_fd, LOCK_UN);
+			close(_fd);
+			_fd = -1;
+			return;
+		}
+	}
+
+	struct stat st;
+	fstat(_fd, &st);
+	uint64_t end = sizeof(hdr);
+	MVKShaderDiskCacheRecordHeader rec;
+	while (end + sizeof(rec) <= (uint64_t)st.st_size &&
+		   pread(_fd, &rec, sizeof(rec), end) == sizeof(rec) &&
+		   rec.magic == kMVKShaderDiskCacheRecordMagic &&
+		   end + sizeof(rec) + rec.payloadSize <= (uint64_t)st.st_size) {
+		_index[{rec.codeSize, rec.codeHash, rec.requestHash}] = {end + sizeof(rec), rec.payloadSize, rec.checksum};
+		end += sizeof(rec) + rec.payloadSize;
+	}
+	if (end < (uint64_t)st.st_size) { ftruncate(_fd, end); }
+	flock(_fd, LOCK_UN);
+
+	MVKBaseObject::reportMessage(nullptr, MVK_CONFIG_LOG_LEVEL_INFO, "Shader cache %s holds %zu conversions.", path.c_str(), _index.size());
+}
+
+uint64_t MVKShaderDiskCache::getRequestHash(const SPIRVToMSLConversionConfiguration& request) {
+#if MVK_USE_CEREAL
+	// MoltenVK compares options bytewise, padding included, so hash their serialized form instead
+	auto config = request;
+	ostringstream stream;
+	try {
+		cereal::BinaryOutputArchive writer(stream);
+		writer(config);
+	} catch (cereal::Exception&) {
+		return 0;
+	}
+	string bytes = stream.str();
+	return mvkShaderDiskCacheHash(bytes.data(), bytes.size());
+#else
+	return 0;
+#endif
+}
+
+bool MVKShaderDiskCache::find(MVKShaderModuleKey smKey, uint64_t requestHash,
+							  SPIRVToMSLConversionConfiguration& config,
+							  SPIRVToMSLConversionResultInfo& resultInfo,
+							  MVKCompressor<string>& compressedMSL) {
+#if MVK_USE_CEREAL
+	Entry entry;
+	{
+		lock_guard<mutex> lock(_lock);
+		auto iter = _index.find({smKey.codeSize, smKey.codeHash, requestHash});
+		if (iter == _index.end()) { return false; }
+		entry = iter->second;
+	}
+	string payload(entry.size, '\0');
+	if (pread(_fd, payload.data(), entry.size, entry.offset) != (ssize_t)entry.size ||
+		mvkShaderDiskCacheHash(payload.data(), payload.size()) != entry.checksum) { return false; }
+	try {
+		mvk::membuf mb(payload.data(), payload.size());
+		istream inStream(&mb);
+		cereal::BinaryInputArchive reader(inStream);
+		reader(config, resultInfo, compressedMSL);
+	} catch (cereal::Exception&) {
+		return false;
+	}
+	return true;
+#else
+	return false;
+#endif
+}
+
+void MVKShaderDiskCache::add(MVKShaderModuleKey smKey, uint64_t requestHash,
+							 const SPIRVToMSLConversionConfiguration& config,
+							 const SPIRVToMSLConversionResultInfo& resultInfo,
+							 const string& msl) {
+#if MVK_USE_CEREAL
+	auto cfg = config;
+	auto info = resultInfo;
+	MVKCompressor<string> compressedMSL;
+	compressedMSL.compress(msl, MVK_CONFIG_COMPRESSION_ALGORITHM_LZFSE);
+
+	MVKShaderDiskCacheRecordHeader rec;
+	string record(sizeof(rec), '\0');
+	{
+		ostringstream stream;
+		try {
+			cereal::BinaryOutputArchive writer(stream);
+			writer(cfg, info, compressedMSL);
+		} catch (cereal::Exception&) {
+			return;
+		}
+		record += stream.str();
+	}
+	rec.magic = kMVKShaderDiskCacheRecordMagic;
+	rec.payloadSize = uint32_t(record.size() - sizeof(rec));
+	rec.codeSize = smKey.codeSize;
+	rec.codeHash = smKey.codeHash;
+	rec.requestHash = requestHash;
+	rec.checksum = mvkShaderDiskCacheHash(record.data() + sizeof(rec), rec.payloadSize);
+	memcpy(record.data(), &rec, sizeof(rec));
+
+	Key key = {smKey.codeSize, smKey.codeHash, requestHash};
+	lock_guard<mutex> lock(_lock);
+	if (_index.count(key)) { return; }
+	flock(_fd, LOCK_EX);
+	struct stat st;
+	if (fstat(_fd, &st) == 0 && pwrite(_fd, record.data(), record.size(), st.st_size) == (ssize_t)record.size()) {
+		_index[key] = {uint64_t(st.st_size) + sizeof(rec), rec.payloadSize, rec.checksum};
+	}
+	flock(_fd, LOCK_UN);
+#endif
+}
+
+
