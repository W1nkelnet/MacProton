+// Returns a retained MTLRenderPipelineDescriptor for drawing what the geometry stage emitted, or nil if an error occurs.
+// Its vertex shader replays the emitted vertices, with the resources of the tessellation evaluation stage.
+MTLRenderPipelineDescriptor* MVKGraphicsPipeline::newMTLGeometryRasterStageDescriptor(const VkGraphicsPipelineCreateInfo* pCreateInfo,
+																					  SPIRVToMSLConversionConfiguration& shaderConfig,
+																					  const VkPipelineShaderStageCreateInfo* pGeometrySS,
+																					  const VkPipelineShaderStageCreateInfo* pFragmentSS,
+																					  VkPipelineCreationFeedback* pFragmentFB) {
+	SPIRVShaderOutputs replayOutputs;
+	std::string errorLog;
+	if ( !getShaderOutputs(_geometryReplayModule->getSPIRV(), spv::ExecutionModelVertex, pGeometrySS->pName, replayOutputs, errorLog)) {
+		setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "Failed to get geometry outputs: %s", errorLog.c_str()));
+		return nil;
+	}
+
+	const auto& implicit = _stageResources[kMVKShaderStageTessEval].implicitBuffers.ids;
+	auto& opts = shaderConfig.options.mslOptions;
+	shaderConfig.options.entryPointStage = spv::ExecutionModelVertex;
+	shaderConfig.options.entryPointName = pGeometrySS->pName;
+	addCommonImplicitBuffersToShaderConfig(shaderConfig, implicit);
+	opts.capture_output_to_buffer = false;
+	opts.vertex_for_tessellation = false;
+	opts.vertex_index_type = CompilerMSL::Options::IndexType::None;
+	opts.disable_rasterization = !_isRasterizing;
+	setEmulatedReversedDepthViewportConfig(shaderConfig, implicit, getPhysicalDevice()->shouldEmulateReversedDepthViewport());
+	setDepthClipConfig(shaderConfig, implicit, _isRasterizing && isPossibleBothDepthClipClamp(_dynamicStateFlags, _staticStateData, false));
+	shaderConfig.shaderInputs.clear();
+	shaderConfig.shaderOutputs.clear();
+	addGeometryEmulationBinding(shaderConfig, spv::ExecutionModelVertex, mvk_gs::kBindingOutVertices, getMetalBufferIndexForVertexAttributeBinding(kMVKTessEvalInputBufferBinding));
+
+	MVKMTLFunction func = getMTLFunction(shaderConfig, pGeometrySS, nullptr, _geometryReplayModule, "Geometry replay");
+	removeGeometryEmulationBindings(shaderConfig);
+	id<MTLFunction> mtlFunc = func.getMTLFunction();
+	if ( !mtlFunc ) { return nil; }
+
+	MTLRenderPipelineDescriptor* plDesc = [MTLRenderPipelineDescriptor new];	// retained
+	plDesc.vertexFunction = mtlFunc;
+	auto& funcRslts = func.shaderConversionResults;
+	plDesc.rasterizationEnabled = !funcRslts.isRasterizationDisabled;
