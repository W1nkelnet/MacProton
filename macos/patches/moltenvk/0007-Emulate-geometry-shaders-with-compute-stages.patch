+// Like for tessellation, compiles the vertex stage in three variants, then the geometry stage and rasterization.
+void MVKGraphicsPipeline::initMTLGeometryPipelineStates(const VkGraphicsPipelineCreateInfo* pCreateInfo,
+														const SPIRVTessReflectionData& reflectData,
+														const VkPipelineShaderStageCreateInfo* pVertexSS,
+														VkPipelineCreationFeedback* pVertexFB,
+														const VkPipelineShaderStageCreateInfo* pGeometrySS,
+														const VkPipelineShaderStageCreateInfo* pFragmentSS,
+														VkPipelineCreationFeedback* pFragmentFB) {
+	SPIRVToMSLConversionConfiguration shaderConfig;
+	initShaderConversionConfig(shaderConfig, pCreateInfo, reflectData);
+
+	MVKMTLFunction vtxFunctions[3] = {};
+	MTLComputePipelineDescriptor* vtxPLDesc = newMTLTessVertexStageDescriptor(pCreateInfo, reflectData, shaderConfig, pVertexSS, pVertexFB, nullptr, vtxFunctions);	// temp retained
+	MTLComputePipelineDescriptor* gsPLDesc = vtxPLDesc ? newMTLGeometryStageDescriptor(pCreateInfo, shaderConfig, pGeometrySS) : nil;							// temp retained
+	MTLRenderPipelineDescriptor* rastPLDesc = gsPLDesc ? newMTLGeometryRasterStageDescriptor(pCreateInfo, shaderConfig, pGeometrySS, pFragmentSS, pFragmentFB) : nil;	// temp retained
+	bool compiled = (vtxPLDesc && gsPLDesc && rastPLDesc &&
+					 compileTessVertexStageState(vtxPLDesc, vtxFunctions, pVertexFB) &&
+					 getOrCompilePipeline(gsPLDesc, _mtlTessControlStageState, "Geometry") &&
+					 getOrCompilePipeline(rastPLDesc, _mtlPipelineState) &&
+					 _hasValidMTLPipelineStates);
+	[vtxPLDesc release];	// temp release
+	[gsPLDesc release];		// temp release
+	[rastPLDesc release];	// temp release
+
+	// A pipeline that must not be compiled now is no reason to leave the geometry shader out.
+	if (compiled || getConfigurationResult() == VK_PIPELINE_COMPILE_REQUIRED) { return; }
+
+	reportWarning(VK_ERROR_FEATURE_NOT_PRESENT, "The emulated geometry shader could not be compiled, so it is ignored.");
+	[_mtlTessVertexStageState release];
+	[_mtlTessVertexStageIndex16State release];
+	[_mtlTessVertexStageIndex32State release];
+	[_mtlTessControlStageState release];
+	[_mtlPipelineState release];
+	_mtlTessVertexStageState = nil;
+	_mtlTessVertexStageIndex16State = nil;
+	_mtlTessVertexStageIndex32State = nil;
+	_mtlTessControlStageState = nil;
+	_mtlPipelineState = nil;
+	for (auto& res : _stageResources) { res = {}; }
+	endGeometryEmulation();
+	_hasValidMTLPipelineStates = true;
+	clearConfigurationResult();
+}
