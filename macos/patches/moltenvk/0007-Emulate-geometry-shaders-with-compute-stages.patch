+// Returns a retained MTLComputePipelineDescriptor for the geometry stage, or nil if an error occurs.
+// The geometry stage runs as a compute kernel, with the resources of the tessellation control stage.
+MTLComputePipelineDescriptor* MVKGraphicsPipeline::newMTLGeometryStageDescriptor(const VkGraphicsPipelineCreateInfo* pCreateInfo,
+																				 SPIRVToMSLConversionConfiguration& shaderConfig,
+																				 const VkPipelineShaderStageCreateInfo* pGeometrySS) {
+	SPIRVToMSLConversionConfiguration gsConfig = shaderConfig;
+	const auto& implicit = _stageResources[kMVKShaderStageTessCtl].implicitBuffers.ids;
+	auto& opts = gsConfig.options.mslOptions;
+	gsConfig.options.entryPointStage = spv::ExecutionModelGLCompute;
+	gsConfig.options.entryPointName = pGeometrySS->pName;
+	addCommonImplicitBuffersToShaderConfig(gsConfig, implicit);
+	opts.capture_output_to_buffer = false;
+	opts.vertex_for_tessellation = false;
+	opts.disable_rasterization = false;
+	opts.vertex_index_type = CompilerMSL::Options::IndexType::None;
+	setEmulatedReversedDepthViewportConfig(gsConfig, implicit, false);
+	setDepthClipConfig(gsConfig, implicit, false);
+	gsConfig.shaderInputs.clear();
+	gsConfig.shaderOutputs.clear();
+
+	// The bindings of the geometry shader are those of the tessellation control stage, for a compute kernel.
+	auto& rbs = gsConfig.resourceBindings;
+	rbs.erase(std::remove_if(rbs.begin(), rbs.end(), [](const mvk::MSLResourceBinding& rb) {
+		return rb.resourceBinding.stage == spv::ExecutionModelGLCompute;
+	}), rbs.end());
+	for (size_t i = 0, n = rbs.size(); i < n; i++) {
+		if (rbs[i].resourceBinding.stage == spv::ExecutionModelTessellationControl) {
+			mvk::MSLResourceBinding rb = rbs[i];
+			rb.resourceBinding.stage = spv::ExecutionModelGLCompute;
+			rbs.push_back(rb);
+		}
+	}
+	auto& dbs = gsConfig.dynamicBufferDescriptors;
+	dbs.erase(std::remove_if(dbs.begin(), dbs.end(), [](const mvk::DescriptorBinding& db) {
+		return db.stage == spv::ExecutionModelGLCompute;
+	}), dbs.end());
+	for (size_t i = 0, n = dbs.size(); i < n; i++) {
+		if (dbs[i].stage == spv::ExecutionModelTessellationControl) {
+			mvk::DescriptorBinding db = dbs[i];
+			db.stage = spv::ExecutionModelGLCompute;
+			dbs.push_back(db);
+		}
+	}
+	addGeometryEmulationBinding(gsConfig, spv::ExecutionModelGLCompute, mvk_gs::kBindingVertices, getMetalBufferIndexForVertexAttributeBinding(kMVKTessCtlInputBufferBinding));
+	addGeometryEmulationBinding(gsConfig, spv::ExecutionModelGLCompute, mvk_gs::kBindingOutVertices, implicit[MVKImplicitBuffer::Output]);
+	addGeometryEmulationBinding(gsConfig, spv::ExecutionModelGLCompute, mvk_gs::kBindingOutIndices, implicit[MVKImplicitBuffer::PatchOutput]);
+	addGeometryEmulationBinding(gsConfig, spv::ExecutionModelGLCompute, mvk_gs::kBindingParams, implicit[MVKImplicitBuffer::IndirectParams]);
+
+	MVKMTLFunction func = getMTLFunction(gsConfig, pGeometrySS, nullptr, _geometryModule, "Geometry");
+	id<MTLFunction> mtlFunc = func.getMTLFunction();
+	if ( !mtlFunc ) { return nil; }
+
+	MTLComputePipelineDescriptor* plDesc = [MTLComputePipelineDescriptor new];	// retained
+	plDesc.computeFunction = mtlFunc;
+	removeGeometryEmulationBindings(gsConfig);
+	auto& res = _stageResources[kMVKShaderStageTessCtl];
+	res.implicitBuffers.needed.addAll({ // Bound by the draw
+		MVKImplicitBuffer::IndirectParams,
+		MVKImplicitBuffer::Output,
+		MVKImplicitBuffer::PatchOutput,
+	});
+	populateResourceUsage(res, gsConfig, func.shaderConversionResults, spv::ExecutionModelGLCompute);
+	_layout->populateBindOperations(res.bindScript, gsConfig, spv::ExecutionModelGLCompute);
+	setMetalObjectLabel(plDesc, ((MVKPipelineLayout*)pCreateInfo->layout)->getDebugName());
+
+	if ( !verifyImplicitBuffers(kMVKShaderStageTessCtl)) {
+		[plDesc release];
+		return nil;
+	}
+	return plDesc;
+}
