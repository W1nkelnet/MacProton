+#pragma once
+
+#ifndef SPV_ENABLE_UTILITY_CODE
+#	define SPV_ENABLE_UTILITY_CODE
+#endif
+#include <spirv.hpp>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <initializer_list>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+// Metal has no geometry stage. A geometry shader runs here as a compute kernel between two other stages.
+// The vertex shader runs first, as a compute kernel like for tessellation, and writes its outputs packed
+// into an array of uint4 per vertex. The kernel runs one thread per input primitive and invocation, reads
+// the vertices of its primitive, and writes each vertex it emits, packed the same way, into a fixed range of
+// OutputVertices slots, along with an index for it. Ending a primitive writes a restart index, so the
+// rasterization draw renders strips from that index buffer, through a vertex shader that replays the
+// emitted vertices with the outputs of the geometry shader.
+//
+// All three are SPIR-V modules derived from the vertex and geometry shaders, compiled to MSL as usual.
+
+namespace mvk_gs {
+
+/** Descriptor set of the buffers the emulation adds, which is not one of the pipeline layout. */
+static constexpr uint32_t kDescSet = 24;
+static constexpr uint32_t kBindingVertices = 0;		// Vertex stage outputs, read by the kernel
+static constexpr uint32_t kBindingOutVertices = 1;	// Emitted vertices, read by the replay vertex shader
+static constexpr uint32_t kBindingOutIndices = 2;	// Indices of emitted vertices and strip restarts
+static constexpr uint32_t kBindingParams = 3;
+static constexpr uint32_t kRestartIndex = 0xFFFFFFFFu;
+
+/** The parameters of a draw, matching the parameter block of the kernel. */
+struct Params {
+	uint32_t threadCount;			// Primitives * instances * invocations
+	uint32_t primitivesPerInstance;
+	uint32_t primitiveStride;		// Vertices from one input primitive to the next
+	uint32_t triangleStrip;			// Odd triangles of a strip swap their second and third vertex
+	uint32_t verticesPerInstance;	// Records the vertex stage wrote per instance
+};
+
+struct Emulation {
+	std::vector<uint32_t> vertexSPIRV;		// The vertex shader, writing its outputs packed
+	std::vector<uint32_t> geometrySPIRV;	// The geometry shader as compute kernel
+	std::vector<uint32_t> replaySPIRV;		// The vertex shader of the rasterization stage
+	uint32_t inputVertices = 0;				// Vertices of an input primitive
+	uint32_t maxOutputVertices = 0;
+	uint32_t invocations = 1;
+	uint32_t outputPrimitive = 0;			// spv::ExecutionModeOutputPoints, OutputLineStrip or OutputTriangleStrip
+	uint32_t inputSlots = 0;				// uint4 per vertex written by the vertex stage
+	uint32_t outputSlots = 0;				// uint4 per vertex emitted by the kernel
+	uint32_t indicesPerThread = 0;
+	bool writesLayer = false;
+	bool writesViewportIndex = false;
+	std::string error;
+};
+
+namespace detail {
+
+typedef std::vector<uint32_t> Words;
+
+struct Inst {
+	Words w;
+	uint32_t op() const { return w[0] & 0xffff; }
+};
+
+inline Inst makeInst(uint32_t op, const Words& operands) {
+	Inst in;
+	in.w.reserve(operands.size() + 1);
+	in.w.push_back(uint32_t((operands.size() + 1) << 16) | op);
+	in.w.insert(in.w.end(), operands.begin(), operands.end());
+	return in;
+}
+
+inline Words stringWords(const char* str) {
+	size_t len = strlen(str);
+	Words w((len + 4) / 4, 0);
+	memcpy(w.data(), str, len);
+	return w;
+}
+
+inline uint32_t stringWordCount(const Inst& in, size_t pos) {
+	const char* str = reinterpret_cast<const char*>(&in.w[pos]);
+	size_t maxLen = (in.w.size() - pos) * 4;
+	return uint32_t(strnlen(str, maxLen) / 4 + 1);
+}
+
+inline uint32_t resultId(const Inst& in) {
+	bool hasResult = false, hasType = false;
+	spv::HasResultAndType(spv::Op(in.op()), &hasResult, &hasType);
+	if ( !hasResult || in.w.size() < (hasType ? 3u : 2u)) { return 0; }
+	return in.w[hasType ? 2 : 1];
+}
+
+inline uint32_t resultType(const Inst& in) {
+	bool hasResult = false, hasType = false;
+	spv::HasResultAndType(spv::Op(in.op()), &hasResult, &hasType);
+	return hasType && in.w.size() > 1 ? in.w[1] : 0;
+}
+
+enum Kind { kKindNone, kKindFloat, kKindInt, kKindUInt };
+
+// Interface keys: a location is location * 4 + component; built-ins follow.
+static constexpr uint32_t kMaxLocations = 32;
+static constexpr uint32_t kKeyPosition = kMaxLocations * 4;	// Four components
+static constexpr uint32_t kKeyPointSize = kKeyPosition + 4;
+static constexpr uint32_t kKeyLayer = kKeyPosition + 5;
+static constexpr uint32_t kKeyViewportIndex = kKeyPosition + 6;
+static constexpr uint32_t kKeyClipDistance = kKeyPosition + 8;	// Eight floats
+static constexpr uint32_t kKeyCullDistance = kKeyPosition + 16;	// Eight floats
+static constexpr uint32_t kKeyNone = UINT32_MAX;
+
+inline uint32_t builtinKey(uint32_t builtin, uint32_t index) {
+	switch (builtin) {
+		case spv::BuiltInPosition:      return index < 4 ? kKeyPosition + index : kKeyNone;
+		case spv::BuiltInPointSize:     return kKeyPointSize;
+		case spv::BuiltInLayer:         return kKeyLayer;
+		case spv::BuiltInViewportIndex: return kKeyViewportIndex;
+		case spv::BuiltInClipDistance:  return index < 8 ? kKeyClipDistance + index : kKeyNone;
+		default:                        return kKeyNone;	// Metal has no cull distances
+	}
+}
+
+/** A scalar of an interface variable, reached by indexing the variable with path. */
+struct Leaf {
+	Words path;
+	uint32_t type = 0;
+	Kind kind = kKindNone;
+	uint32_t key = kKeyNone;
+};
+
+struct Var {
+	uint32_t id = 0;
+	uint32_t type = 0;			// Pointee type
+	uint32_t storage = 0;
+	uint32_t builtin = UINT32_MAX;
+	std::vector<Leaf> leaves;	// For per-vertex inputs, of one vertex
+};
+
+class Module {
+public:
+	uint32_t version = 0, generator = 0, bound = 0, schema = 0;
+	std::vector<Inst> preamble, entryPoints, execModes, debug, annotations, globals, functions;
+	std::string error;
+
+	bool fail(const std::string& msg) { if (error.empty()) { error = msg; } return false; }
+
+	bool parse(const Words& spv) {
+		if (spv.size() < 5 || spv[0] != spv::MagicNumber) { return fail("Not a SPIR-V module"); }
+		version = spv[1]; generator = spv[2]; bound = spv[3]; schema = spv[4];
+		bool inFunctions = false;
+		for (size_t pos = 5; pos < spv.size(); ) {
+			uint32_t len = spv[pos] >> 16;
+			if (len == 0 || pos + len > spv.size()) { return fail("Truncated SPIR-V module"); }
+			Inst in;
+			in.w.assign(spv.begin() + pos, spv.begin() + pos + len);
+			pos += len;
+			uint32_t op = in.op();
+			if (op == spv::OpFunction) { inFunctions = true; }
+			if (inFunctions) { functions.push_back(std::move(in)); continue; }
+			switch (op) {
+				case spv::OpCapability: case spv::OpExtension: case spv::OpExtInstImport: case spv::OpMemoryModel:
+					preamble.push_back(std::move(in)); break;
+				case spv::OpEntryPoint:
+					entryPoints.push_back(std::move(in)); break;
+				case spv::OpExecutionMode: case spv::OpExecutionModeId:
+					execModes.push_back(std::move(in)); break;
+				case spv::OpString: case spv::OpSourceExtension: case spv::OpSource: case spv::OpSourceContinued:
+				case spv::OpName: case spv::OpMemberName: case spv::OpModuleProcessed:
+					debug.push_back(std::move(in)); break;
+				case spv::OpDecorate: case spv::OpMemberDecorate: case spv::OpDecorationGroup: case spv::OpGroupDecorate:
+				case spv::OpGroupMemberDecorate: case spv::OpDecorateId: case spv::OpDecorateString: case spv::OpMemberDecorateString:
+					annotations.push_back(std::move(in)); break;
+				default:
+					globals.push_back(std::move(in)); break;
+			}
+		}
+		reindex();
+		return true;
+	}
+
+	Words serialize() const {
+		Words out = { spv::MagicNumber, version, generator, bound, schema };
+		for (auto* section : { &preamble, &entryPoints, &execModes, &debug, &annotations, &globals, &functions }) {
+			for (auto& in : *section) { out.insert(out.end(), in.w.begin(), in.w.end()); }
+		}
+		return out;
+	}
+
+	uint32_t newId() { return bound++; }
+
+	void reindex() {
+		_globalDefs.clear();
+		for (uint32_t i = 0; i < globals.size(); i++) {
+			if (uint32_t id = resultId(globals[i])) { _globalDefs[id] = i; }
+		}
+	}
+
+	const Inst* def(uint32_t id) const {
+		auto it = _globalDefs.find(id);
+		return it == _globalDefs.end() ? nullptr : &globals[it->second];
+	}
+
+	uint32_t addGlobal(Inst in) {
+		uint32_t id = resultId(in);
+		_globalDefs[id] = uint32_t(globals.size());
+		globals.push_back(std::move(in));
+		return id;
+	}
+
+	uint32_t findOrAddType(uint32_t op, const Words& operands) {
+		for (auto& g : globals) {
+			if (g.op() == op && g.w.size() == operands.size() + 2 && std::equal(operands.begin(), operands.end(), g.w.begin() + 2)) {
+				return g.w[1];
+			}
+		}
+		return addType(op, operands);
+	}
+
+	uint32_t addType(uint32_t op, const Words& operands) {
+		Words w = { newId() };
+		w.insert(w.end(), operands.begin(), operands.end());
+		return addGlobal(makeInst(op, w));
+	}
+
+	uint32_t typeVoid() { return findOrAddType(spv::OpTypeVoid, {}); }
+	uint32_t typeBool() { return findOrAddType(spv::OpTypeBool, {}); }
+	uint32_t typeUInt() { return findOrAddType(spv::OpTypeInt, { 32, 0 }); }
+	uint32_t typeInt() { return findOrAddType(spv::OpTypeInt, { 32, 1 }); }
+	uint32_t typeFloat() { return findOrAddType(spv::OpTypeFloat, { 32 }); }
+	uint32_t typeVector(uint32_t elem, uint32_t count) { return findOrAddType(spv::OpTypeVector, { elem, count }); }
+	uint32_t typePointer(uint32_t storage, uint32_t type) { return findOrAddType(spv::OpTypePointer, { storage, type }); }
+	uint32_t typeFunctionVoid() { return findOrAddType(spv::OpTypeFunction, { typeVoid() }); }
+
+	/** A pointer type declared before the given global, which is to use it. */
+	uint32_t typePointerBefore(uint32_t storage, uint32_t type, uint32_t user) {
+		for (auto& g : globals) {
+			if (g.op() == spv::OpTypePointer && g.w[2] == storage && g.w[3] == type) {
+				if (_globalDefs[g.w[1]] < _globalDefs[user]) { return g.w[1]; }
+				break;
+			}
+		}
+		uint32_t id = newId();
+		globals.insert(globals.begin() + _globalDefs[user], makeInst(spv::OpTypePointer, { id, storage, type }));
+		reindex();
+		return id;
+	}
+
+	uint32_t constant(uint32_t type, uint32_t value) {
+		for (auto& g : globals) {
+			if (g.op() == spv::OpConstant && g.w.size() == 4 && g.w[1] == type && g.w[3] == value) { return g.w[2]; }
+		}
+		return addGlobal(makeInst(spv::OpConstant, { type, newId(), value }));
+	}
+	uint32_t constUInt(uint32_t value) { return constant(typeUInt(), value); }
+
+	/** The value of a 32-bit integer constant, or UINT32_MAX. */
+	uint32_t constantValue(uint32_t id) const {
+		const Inst* c = def(id);
+		return c && c->op() == spv::OpConstant && c->w.size() == 4 ? c->w[3] : UINT32_MAX;
+	}
+
+	Kind kind(uint32_t type) const {
+		const Inst* t = def(type);
+		if ( !t ) { return kKindNone; }
+		if (t->op() == spv::OpTypeFloat && t->w[2] == 32) { return kKindFloat; }
+		if (t->op() == spv::OpTypeInt && t->w[2] == 32) { return t->w[3] ? kKindInt : kKindUInt; }
+		return kKindNone;
+	}
+
+	bool decoration(uint32_t id, uint32_t dec, uint32_t* value = nullptr) const {
+		for (auto& a : annotations) {
+			if (a.op() == spv::OpDecorate && a.w.size() >= 3 && a.w[1] == id && a.w[2] == dec) {
+				if (value) { *value = a.w.size() > 3 ? a.w[3] : 0; }
+				return true;
+			}
+		}
+		return false;
+	}
+
+	bool memberDecoration(uint32_t type, uint32_t member, uint32_t dec, uint32_t* value = nullptr) const {
+		for (auto& a : annotations) {
+			if (a.op() == spv::OpMemberDecorate && a.w.size() >= 4 && a.w[1] == type && a.w[2] == member && a.w[3] == dec) {
+				if (value) { *value = a.w.size() > 4 ? a.w[4] : 0; }
+				return true;
+			}
+		}
+		return false;
+	}
+
+	void decorate(uint32_t id, uint32_t dec, std::initializer_list<uint32_t> values = {}) {
+		Words w = { id, dec };
+		w.insert(w.end(), values);
+		annotations.push_back(makeInst(spv::OpDecorate, w));
+	}
+
+	void memberDecorate(uint32_t type, uint32_t member, uint32_t dec, std::initializer_list<uint32_t> values = {}) {
+		Words w = { type, member, dec };
+		w.insert(w.end(), values);
+		annotations.push_back(makeInst(spv::OpMemberDecorate, w));
+	}
+
+	void name(uint32_t id, const char* str) {
+		Words w = { id };
+		Words s = stringWords(str);
+		w.insert(w.end(), s.begin(), s.end());
+		debug.push_back(makeInst(spv::OpName, w));
+	}
+
+	void addCapability(uint32_t cap) {
+		for (auto& p : preamble) { if (p.op() == spv::OpCapability && p.w[1] == cap) { return; } }
+		preamble.insert(preamble.begin(), makeInst(spv::OpCapability, { cap }));
+	}
+
+	void addExtension(const char* ext) {
+		Words s = stringWords(ext);
+		for (auto& p : preamble) { if (p.op() == spv::OpExtension && Words(p.w.begin() + 1, p.w.end()) == s) { return; } }
+		auto it = preamble.begin();
+		while (it != preamble.end() && it->op() == spv::OpCapability) { ++it; }
+		preamble.insert(it, makeInst(spv::OpExtension, s));
+	}
+
+	/** Finds the entry point of the given model and name. */
+	Inst* entryPoint(uint32_t model, const char* entryName) {
+		for (auto& ep : entryPoints) {
+			if (ep.w[1] == model && (!entryName || strcmp(reinterpret_cast<const char*>(&ep.w[3]), entryName) == 0)) { return &ep; }
+		}
+		return nullptr;
+	}
+
+	static Words entryInterface(const Inst& ep) {
+		uint32_t start = 3 + stringWordCount(ep, 3);
+		return Words(ep.w.begin() + std::min<size_t>(start, ep.w.size()), ep.w.end());
+	}
+
+	static std::string entryName(const Inst& ep) { return reinterpret_cast<const char*>(&ep.w[3]); }
+
+	/** Replaces all entry points with one. */
+	void setEntryPoint(uint32_t model, uint32_t func, const std::string& entryName, const Words& iface) {
+		Words w = { model, func };
+		Words s = stringWords(entryName.c_str());
+		w.insert(w.end(), s.begin(), s.end());
+		w.insert(w.end(), iface.begin(), iface.end());
+		entryPoints.clear();
+		entryPoints.push_back(makeInst(spv::OpEntryPoint, w));
+	}
+
+	/** The pointee and storage class of a variable. */
+	bool variable(uint32_t id, uint32_t& pointee, uint32_t& storage) const {
+		const Inst* v = def(id);
+		if ( !v || v->op() != spv::OpVariable) { return false; }
+		const Inst* p = def(v->w[1]);
+		if ( !p || p->op() != spv::OpTypePointer) { return false; }
+		pointee = p->w[3];
+		storage = v->w[3];
+		return true;
+	}
+
+	/** Collects the scalars of an interface variable of the given type. */
+	bool collectLeaves(uint32_t type, Words& path, uint32_t& location, uint32_t component,
+					   uint32_t builtin, std::vector<Leaf>& leaves) {
+		const Inst* t = def(type);
+		if ( !t ) { return fail("Unknown interface type"); }
+		switch (t->op()) {
+			case spv::OpTypeFloat:
+			case spv::OpTypeInt:
+			case spv::OpTypeVector: {
+				uint32_t elem = t->op() == spv::OpTypeVector ? t->w[2] : type;
+				uint32_t count = t->op() == spv::OpTypeVector ? t->w[3] : 1;
+				Kind k = kind(elem);
+				if (k == kKindNone) { return fail("Interface variable of unsupported type"); }
+				if (builtin == UINT32_MAX && (component + count > 4 || location >= kMaxLocations)) { return fail("Interface location out of range"); }
+				for (uint32_t i = 0; i < count; i++) {
+					Leaf leaf;
+					leaf.path = path;
+					if (t->op() == spv::OpTypeVector) { leaf.path.push_back(i); }
+					leaf.type = elem;
+					leaf.kind = k;
+					leaf.key = builtin != UINT32_MAX ? builtinKey(builtin, i) : location * 4 + component + i;
+					if (leaf.key != kKeyNone) { leaves.push_back(leaf); }
+				}
+				if (builtin == UINT32_MAX) { location++; }
+				return true;
+			}
+			case spv::OpTypeMatrix:
+				for (uint32_t c = 0; c < t->w[3]; c++) {
+					path.push_back(c);
+					bool ok = collectLeaves(t->w[2], path, location, 0, builtin, leaves);
+					path.pop_back();
+					if ( !ok ) { return false; }
+				}
+				return true;
+			case spv::OpTypeArray: {
+				uint32_t len = constantValue(t->w[3]);
+				if (len == UINT32_MAX || len > 64) { return fail("Interface array of unknown size"); }
+				for (uint32_t i = 0; i < len; i++) {
+					path.push_back(i);
+					bool ok;
+					if (builtin != UINT32_MAX && kind(t->w[2]) != kKindNone) {
+						// Clip and cull distances are arrays of scalars
+						Kind k = kind(t->w[2]);
+						Leaf leaf;
+						leaf.path = path;
+						leaf.type = t->w[2];
+						leaf.kind = k;
+						leaf.key = builtinKey(builtin, i);
+						if (leaf.key != kKeyNone) { leaves.push_back(leaf); }
+						ok = true;
+					} else {
+						ok = collectLeaves(t->w[2], path, location, component, builtin, leaves);
+					}
+					path.pop_back();
+					if ( !ok ) { return false; }
+				}
+				return true;
+			}
+			case spv::OpTypeStruct:
+				for (uint32_t m = 0; m + 2 < t->w.size(); m++) {
+					uint32_t memberBuiltin = UINT32_MAX, memberLocation = 0, memberComponent = 0;
+					memberDecoration(type, m, spv::DecorationBuiltIn, &memberBuiltin);
+					if (memberDecoration(type, m, spv::DecorationLocation, &memberLocation)) { location = memberLocation; }
+					memberDecoration(type, m, spv::DecorationComponent, &memberComponent);
+					path.push_back(m);
+					bool ok = collectLeaves(t->w[2 + m], path, location, memberComponent,
+											memberBuiltin != UINT32_MAX ? memberBuiltin : builtin, leaves);
+					path.pop_back();
+					if ( !ok ) { return false; }
+				}
+				return true;
+			default:
+				return fail("Interface variable of unsupported type");
+		}
+	}
+
+	/** Describes an interface variable. With perVertex, its outermost array is the vertices of a primitive. */
+	bool describeVar(uint32_t id, bool perVertex, Var& var) {
+		var.id = id;
+		if ( !variable(id, var.type, var.storage)) { return fail("Interface variable not found"); }
+		decoration(id, spv::DecorationBuiltIn, &var.builtin);
+		uint32_t type = var.type;
+		if (perVertex) {
+			const Inst* t = def(type);
+			if ( !t || t->op() != spv::OpTypeArray) { return fail("Per-vertex input is not an array"); }
+			type = t->w[2];
+		}
+		uint32_t location = 0, component = 0;
+		decoration(id, spv::DecorationLocation, &location);
+		decoration(id, spv::DecorationComponent, &component);
+		Words path;
+		if ( !collectLeaves(type, path, location, component, var.builtin, var.leaves)) { return false; }
+
+		// Leave out what the shader does not access, such as the members of gl_PerVertex it does not write.
+		const Inst* t = def(type);
+		if (t && t->op() == spv::OpTypeStruct) {
+			std::unordered_set<uint32_t> members;
+			if ( !accessesAllMembers(id, perVertex ? 1 : 0, members)) {
+				var.leaves.erase(std::remove_if(var.leaves.begin(), var.leaves.end(), [&](const Leaf& leaf) {
+					return leaf.path.empty() || !members.count(leaf.path[0]);
+				}), var.leaves.end());
+			}
+		} else if ( !isAccessed(id)) {
+			var.leaves.clear();
+		}
+		return true;
+	}
+
+	bool isAccessed(uint32_t id) const {
+		for (auto& in : functions) {
+			for (size_t i = 1; i < in.w.size(); i++) { if (in.w[i] == id && resultId(in) != id) { return true; } }
+		}
+		return false;
+	}
+
+	/** Whether a struct variable is accessed as a whole; if not, collects the members it accesses. */
+	bool accessesAllMembers(uint32_t id, uint32_t memberIndexPos, std::unordered_set<uint32_t>& members) const {
+		std::unordered_map<uint32_t, uint32_t> constants;
+		for (auto& g : globals) { if (g.op() == spv::OpConstant && g.w.size() == 4) { constants[g.w[2]] = g.w[3]; } }
+		for (auto& in : functions) {
+			uint32_t op = in.op();
+			bool chain = op == spv::OpAccessChain || op == spv::OpInBoundsAccessChain;
+			if (chain && in.w[3] == id) {
+				if (in.w.size() <= 4 + memberIndexPos) { return true; }
+				auto c = constants.find(in.w[4 + memberIndexPos]);
+				if (c == constants.end()) { return true; }
+				members.insert(c->second);
+				continue;
+			}
+			for (size_t i = 1; i < in.w.size(); i++) { if (in.w[i] == id) { return true; } }
+		}
+		return false;
+	}
+
+	/** Interface variables of an entry point, which for SPIR-V before 1.4 are only inputs and outputs. */
+	std::vector<uint32_t> interfaceVars(const Inst& ep, uint32_t storage) const {
+		std::vector<uint32_t> vars;
+		for (uint32_t id : entryInterface(ep)) {
+			uint32_t pointee, sc;
+			if (variable(id, pointee, sc) && sc == storage) { vars.push_back(id); }
+		}
+		return vars;
+	}
+
+	/** Struct types contained in a type. */
+	void containedStructs(uint32_t type, std::unordered_set<uint32_t>& structs) const {
+		const Inst* t = def(type);
+		if ( !t ) { return; }
+		switch (t->op()) {
+			case spv::OpTypeArray: case spv::OpTypeRuntimeArray:
+				containedStructs(t->w[2], structs);
+				break;
+			case spv::OpTypeStruct:
+				if (structs.insert(type).second) {
+					for (size_t m = 2; m < t->w.size(); m++) { containedStructs(t->w[m], structs); }
+				}
+				break;
+			default:
+				break;
+		}
+	}
+
+	/** Turns interface variables into private ones, along with the pointers derived from them. */
+	bool makePrivate(const std::unordered_set<uint32_t>& vars) {
+		std::unordered_set<uint32_t> derived(vars.begin(), vars.end());
+		std::unordered_set<uint32_t> structs;
+		for (uint32_t id : vars) {
+			auto it = _globalDefs.find(id);
+			if (it == _globalDefs.end()) { return fail("Interface variable not found"); }
+			uint32_t pointee, storage;
+			variable(id, pointee, storage);
+			containedStructs(pointee, structs);
+			uint32_t ptr = typePointerBefore(spv::StorageClassPrivate, pointee, id);
+			Inst& v = globals[_globalDefs[id]];
+			v.w[1] = ptr;
+			v.w[3] = spv::StorageClassPrivate;
+		}
+
+		for (auto& in : functions) {
+			uint32_t op = in.op();
+			switch (op) {
+				case spv::OpAccessChain: case spv::OpInBoundsAccessChain: case spv::OpPtrAccessChain:
+				case spv::OpInBoundsPtrAccessChain: case spv::OpCopyObject: {
+					if ( !derived.count(in.w[3])) { break; }
+					for (size_t i = 4; i < in.w.size(); i++) {
+						if (derived.count(in.w[i])) { return fail("Interface pointer used as index"); }
+					}
+					const Inst* p = def(in.w[1]);
+					if ( !p || p->op() != spv::OpTypePointer) { return fail("Access chain without pointer type"); }
+					in.w[1] = typePointer(spv::StorageClassPrivate, p->w[3]);
+					derived.insert(in.w[2]);
+					continue;
+				}
+				case spv::OpLoad:
+					continue;
+				case spv::OpStore:
+					if (derived.count(in.w[2])) { return fail("Interface pointer stored"); }
+					continue;
+				case spv::OpCopyMemory: case spv::OpCopyMemorySized:
+				case spv::OpCompositeExtract: case spv::OpCompositeInsert: case spv::OpVectorShuffle:
+				case spv::OpExtInst: case spv::OpSwitch: case spv::OpSelectionMerge: case spv::OpLoopMerge:
+				case spv::OpLine: case spv::OpNoLine: case spv::OpLabel: case spv::OpBranch: case spv::OpFunction:
+				case spv::OpFunctionEnd: case spv::OpReturn: case spv::OpUnreachable: case spv::OpKill:
+					continue;
+				default:
+					break;
+			}
+			for (size_t i = 1; i < in.w.size(); i++) {
+				if (derived.count(in.w[i])) { return fail("Interface pointer escapes"); }
+			}
+		}
+
+		// Interface decorations do not apply to private variables
+		annotations.erase(std::remove_if(annotations.begin(), annotations.end(), [&](const Inst& a) {
+			if (a.op() == spv::OpDecorate || a.op() == spv::OpDecorateId || a.op() == spv::OpDecorateString) {
+				return vars.count(a.w[1]) || (structs.count(a.w[1]) && a.w[2] == spv::DecorationBlock);
+			}
+			if (a.op() == spv::OpMemberDecorate || a.op() == spv::OpMemberDecorateString) {
+				if ( !structs.count(a.w[1])) { return false; }
+				switch (a.w[3]) {
+					case spv::DecorationBuiltIn: case spv::DecorationLocation: case spv::DecorationComponent:
+					case spv::DecorationFlat: case spv::DecorationNoPerspective: case spv::DecorationCentroid:
+					case spv::DecorationSample: case spv::DecorationInvariant: case spv::DecorationStream:
+					case spv::DecorationXfbBuffer: case spv::DecorationXfbStride: case spv::DecorationOffset:
+						return true;
+					default:
+						return false;
+				}
+			}
+			return false;
+		}), annotations.end());
+		return true;
+	}
+
+	/** Rewrites the uses of the given execution modes, or drops them where the target is zero. */
+	void retargetExecutionModes(uint32_t from, uint32_t to, const std::unordered_set<uint32_t>& drop) {
+		execModes.erase(std::remove_if(execModes.begin(), execModes.end(), [&](const Inst& m) {
+			return m.w[1] == from && drop.count(m.w[2]);
+		}), execModes.end());
+		for (auto& m : execModes) { if (m.w[1] == from) { m.w[1] = to; } }
+	}
+
+	/** SPIR-V 1.4 lists all global variables an entry point uses in its interface. */
+	bool listsAllGlobals() const { return version >= 0x00010400; }
+
+	/** Uses the StorageBuffer storage class, which modules before SPIR-V 1.3 need an extension for. */
+	void enableStorageBuffers() {
+		if (version < 0x00010300) { addExtension("SPV_KHR_storage_buffer_storage_class"); }
+	}
+
+private:
+	std::unordered_map<uint32_t, uint32_t> _globalDefs;
+};
+
+/** Appends instructions of a new function. */
+class Builder {
+public:
+	Builder(Module& m) : mod(m) {}
+
+	Module& mod;
+	std::vector<Inst> code;
+
+	uint32_t op(uint32_t opcode, uint32_t type, const Words& args) {
+		uint32_t id = mod.newId();
+		Words w = { type, id };
+		w.insert(w.end(), args.begin(), args.end());
+		code.push_back(makeInst(opcode, w));
+		return id;
+	}
+	void opNoResult(uint32_t opcode, const Words& args) { code.push_back(makeInst(opcode, args)); }
+
+	uint32_t label() { uint32_t id = mod.newId(); code.push_back(makeInst(spv::OpLabel, { id })); return id; }
+	void label(uint32_t id) { code.push_back(makeInst(spv::OpLabel, { id })); }
+	void branch(uint32_t target) { opNoResult(spv::OpBranch, { target }); }
+
+	uint32_t u(uint32_t v) { return mod.constUInt(v); }
+	uint32_t add(uint32_t a, uint32_t b) { return op(spv::OpIAdd, mod.typeUInt(), { a, b }); }
+	uint32_t sub(uint32_t a, uint32_t b) { return op(spv::OpISub, mod.typeUInt(), { a, b }); }
+	uint32_t mul(uint32_t a, uint32_t b) { return op(spv::OpIMul, mod.typeUInt(), { a, b }); }
+	uint32_t div(uint32_t a, uint32_t b) { return op(spv::OpUDiv, mod.typeUInt(), { a, b }); }
+	uint32_t mod_(uint32_t a, uint32_t b) { return op(spv::OpUMod, mod.typeUInt(), { a, b }); }
+	uint32_t load(uint32_t type, uint32_t ptr) { return op(spv::OpLoad, type, { ptr }); }
+	void store(uint32_t ptr, uint32_t val) { opNoResult(spv::OpStore, { ptr, val }); }
+
+	uint32_t chain(uint32_t storage, uint32_t type, uint32_t base, const Words& constIndices, const Words& idIndices = {}) {
+		if (constIndices.empty() && idIndices.empty()) { return base; }
+		Words args = { base };
+		args.insert(args.end(), idIndices.begin(), idIndices.end());
+		for (uint32_t i : constIndices) { args.push_back(u(i)); }
+		return op(spv::OpAccessChain, mod.typePointer(storage, type), args);
+	}
+
+	/** Reinterprets a 32-bit scalar as another kind. */
+	uint32_t bitcast(uint32_t val, Kind from, uint32_t toType, Kind to) {
+		return from == to ? val : op(spv::OpBitcast, toType, { val });
+	}
+
+	/** Begins a function without parameters returning void. */
+	uint32_t beginFunction() {
+		uint32_t id = mod.newId();
+		code.push_back(makeInst(spv::OpFunction, { mod.typeVoid(), id, spv::FunctionControlMaskNone, mod.typeFunctionVoid() }));
+		label();
+		return id;
+	}
+	void endFunction() {
+		opNoResult(spv::OpReturn, {});
+		opNoResult(spv::OpFunctionEnd, {});
+		mod.functions.insert(mod.functions.end(), code.begin(), code.end());
+		code.clear();
+	}
+};
+
+/** A storage buffer of a runtime array, decorated as such. */
+inline uint32_t addStorageBuffer(Module& m, uint32_t elemType, uint32_t stride, uint32_t binding, bool readOnly, const char* name) {
+	m.enableStorageBuffers();
+	uint32_t arr = m.addType(spv::OpTypeRuntimeArray, { elemType });
+	m.decorate(arr, spv::DecorationArrayStride, { stride });
+	uint32_t block = m.addType(spv::OpTypeStruct, { arr });
+	m.decorate(block, spv::DecorationBlock);
+	m.memberDecorate(block, 0, spv::DecorationOffset, { 0 });
+	if (readOnly) { m.memberDecorate(block, 0, spv::DecorationNonWritable); }
+	uint32_t var = m.addGlobal(makeInst(spv::OpVariable, { m.typePointer(spv::StorageClassStorageBuffer, block), m.newId(), spv::StorageClassStorageBuffer }));
+	m.decorate(var, spv::DecorationDescriptorSet, { kDescSet });
+	m.decorate(var, spv::DecorationBinding, { binding });
+	m.name(var, name);
+	return var;
+}
+
+/** Maps interface keys to uint4 slots, a slot per four consecutive keys in use. */
+struct Slots {
+	std::map<uint32_t, uint32_t> slotOfGroup;
+
+	void add(uint32_t key) { slotOfGroup[key / 4] = 0; }
+	uint32_t finish() {
+		uint32_t n = 0;
+		for (auto& s : slotOfGroup) { s.second = n++; }
+		return std::max(n, 1u);
+	}
+	bool has(uint32_t key) const { return slotOfGroup.count(key / 4); }
+	uint32_t slot(uint32_t key) const { return slotOfGroup.at(key / 4); }
+};
+
+/** Loads a packed scalar of an interface variable from a uint4 element of a storage buffer. */
+inline uint32_t loadPacked(Builder& b, uint32_t buffer, uint32_t base, const Slots& slots, const Leaf& leaf) {
+	Module& m = b.mod;
+	uint32_t elem = b.add(base, b.u(slots.slot(leaf.key)));
+	uint32_t ptr = b.chain(spv::StorageClassStorageBuffer, m.typeUInt(), buffer, { leaf.key % 4 }, { b.u(0), elem });
+	uint32_t val = b.load(m.typeUInt(), ptr);
+	return b.bitcast(val, kKindUInt, leaf.type, leaf.kind);
+}
+
+/** Stores a scalar of an interface variable packed into a uint4 element of a storage buffer. */
+inline void storePacked(Builder& b, uint32_t buffer, uint32_t base, const Slots& slots, const Leaf& leaf, uint32_t val) {
+	Module& m = b.mod;
+	uint32_t elem = b.add(base, b.u(slots.slot(leaf.key)));
+	uint32_t ptr = b.chain(spv::StorageClassStorageBuffer, m.typeUInt(), buffer, { leaf.key % 4 }, { b.u(0), elem });
+	b.store(ptr, b.bitcast(val, leaf.kind, m.typeUInt(), kKindUInt));
+}
+
+/** Renames the entry function, to be called by a new entry point wrapping it. */
+inline uint32_t entryFunction(const Inst& ep) { return ep.w[2]; }
+
+static const std::unordered_set<uint32_t> kGeometryExecutionModes = {
+	spv::ExecutionModeInputPoints, spv::ExecutionModeInputLines, spv::ExecutionModeInputLinesAdjacency,
+	spv::ExecutionModeTriangles, spv::ExecutionModeInputTrianglesAdjacency, spv::ExecutionModeInvocations,
+	spv::ExecutionModeOutputVertices, spv::ExecutionModeOutputPoints, spv::ExecutionModeOutputLineStrip,
+	spv::ExecutionModeOutputTriangleStrip,
+};
+
+}	// namespace detail
+
+/**
+ * Builds the vertex shader, geometry kernel and replay vertex shader that emulate a geometry stage.
+ * Returns false, with the reason in emu.error, for shaders it cannot handle.
+ */
+inline bool buildEmulation(const std::vector<uint32_t>& vsSPIRV, const char* vsEntry,
+						   const std::vector<uint32_t>& gsSPIRV, const char* gsEntry, Emulation& emu) {
+	using namespace detail;
+
+	// Geometry shader
+	Module gs;
+	if ( !gs.parse(gsSPIRV)) { emu.error = gs.error; return false; }
+	Inst* gsEP = gs.entryPoint(spv::ExecutionModelGeometry, gsEntry);
+	if ( !gsEP) { emu.error = "Geometry entry point not found"; return false; }
+	uint32_t gsFunc = entryFunction(*gsEP);
+	std::string gsName = Module::entryName(*gsEP);
+	Words gsIface = Module::entryInterface(*gsEP);
+	for (auto& m : gs.execModes) {
+		if (m.w[1] != gsFunc) { continue; }
+		switch (m.w[2]) {
+			case spv::ExecutionModeInputPoints:             emu.inputVertices = 1; break;
+			case spv::ExecutionModeInputLines:              emu.inputVertices = 2; break;
+			case spv::ExecutionModeInputLinesAdjacency:     emu.inputVertices = 4; break;
+			case spv::ExecutionModeTriangles:               emu.inputVertices = 3; break;
+			case spv::ExecutionModeInputTrianglesAdjacency: emu.inputVertices = 6; break;
+			case spv::ExecutionModeInvocations:             emu.invocations = std::max(m.w[3], 1u); break;
+			case spv::ExecutionModeOutputVertices:          emu.maxOutputVertices = m.w[3]; break;
+			case spv::ExecutionModeOutputPoints:
+			case spv::ExecutionModeOutputLineStrip:
+			case spv::ExecutionModeOutputTriangleStrip:     emu.outputPrimitive = m.w[2]; break;
+			default: break;
+		}
+	}
+	if ( !emu.inputVertices || !emu.maxOutputVertices || !emu.outputPrimitive) { emu.error = "Incomplete geometry execution modes"; return false; }
+	bool strips = emu.outputPrimitive != spv::ExecutionModeOutputPoints;
+	emu.indicesPerThread = strips ? emu.maxOutputVertices * 2 : emu.maxOutputVertices;
+
+	std::vector<Var> gsInputs, gsOutputs;
+	uint32_t primIdVar = 0, invIdVar = 0;
+	std::unordered_set<uint32_t> gsIfaceVars;
+	Slots inSlots, outSlots;
+	for (uint32_t id : gs.interfaceVars(*gsEP, spv::StorageClassInput)) {
+		gsIfaceVars.insert(id);
+		uint32_t builtin = UINT32_MAX;
+		gs.decoration(id, spv::DecorationBuiltIn, &builtin);
+		if (builtin == spv::BuiltInPrimitiveId) { primIdVar = id; continue; }
+		if (builtin == spv::BuiltInInvocationId) { invIdVar = id; continue; }
+		Var var;
+		if ( !gs.describeVar(id, true, var)) { emu.error = gs.error; return false; }
+		for (auto& leaf : var.leaves) { inSlots.add(leaf.key); }
+		gsInputs.push_back(var);
+	}
+	for (uint32_t id : gs.interfaceVars(*gsEP, spv::StorageClassOutput)) {
+		gsIfaceVars.insert(id);
+		Var var;
+		if ( !gs.describeVar(id, false, var)) { emu.error = gs.error; return false; }
+		for (auto& leaf : var.leaves) {
+			outSlots.add(leaf.key);
+			if (leaf.key == kKeyLayer) { emu.writesLayer = true; }
+			if (leaf.key == kKeyViewportIndex) { emu.writesViewportIndex = true; }
+		}
+		gsOutputs.push_back(var);
+	}
+	emu.inputSlots = inSlots.finish();
+	emu.outputSlots = outSlots.finish();
+
+	// The replay vertex shader starts from the geometry shader, before it changes.
+	Module replay = gs;
+
+	// Vertex shader: run as before, then write the outputs the geometry shader reads, packed.
+	{
+		Module vs;
+		if ( !vs.parse(vsSPIRV)) { emu.error = vs.error; return false; }
+		Inst* ep = vs.entryPoint(spv::ExecutionModelVertex, vsEntry);
+		if ( !ep) { emu.error = "Vertex entry point not found"; return false; }
+		uint32_t func = entryFunction(*ep);
+		std::string name = Module::entryName(*ep);
+		Words iface = Module::entryInterface(*ep);
+		std::vector<Var> outputs;
+		std::unordered_set<uint32_t> outVars;
+		for (uint32_t id : vs.interfaceVars(*ep, spv::StorageClassOutput)) {
+			Var var;
+			if ( !vs.describeVar(id, false, var)) { emu.error = vs.error; return false; }
+			outputs.push_back(var);
+			outVars.insert(id);
+		}
+		if ( !vs.makePrivate(outVars)) { emu.error = vs.error; return false; }
+
+		uint32_t uint4 = vs.typeVector(vs.typeUInt(), 4);
+		uint32_t packedType = vs.addType(spv::OpTypeArray, { uint4, vs.constUInt(emu.inputSlots) });
+		uint32_t packed = vs.addGlobal(makeInst(spv::OpVariable, { vs.typePointer(spv::StorageClassOutput, packedType), vs.newId(), spv::StorageClassOutput }));
+		vs.decorate(packed, spv::DecorationLocation, { 0 });
+		vs.name(packed, "mvkPackedOutput");
+
+		Builder b(vs);
+		uint32_t main = b.beginFunction();
+		b.op(spv::OpFunctionCall, vs.typeVoid(), { func });
+		std::unordered_set<uint32_t> written;
+		for (auto& var : outputs) {
+			for (auto& leaf : var.leaves) {
+				if ( !inSlots.has(leaf.key) || !written.insert(leaf.key).second) { continue; }
+				uint32_t src = b.chain(spv::StorageClassPrivate, leaf.type, var.id, leaf.path);
+				uint32_t val = b.bitcast(b.load(leaf.type, src), leaf.kind, vs.typeUInt(), kKindUInt);
+				uint32_t dst = b.chain(spv::StorageClassOutput, vs.typeUInt(), packed, { inSlots.slot(leaf.key), leaf.key % 4 });
+				b.store(dst, val);
+			}
+		}
+		b.endFunction();
+		vs.name(main, "mvkPackOutputs");
+
+		Words newIface;
+		for (uint32_t id : iface) { if (vs.listsAllGlobals() || !outVars.count(id)) { newIface.push_back(id); } }
+		newIface.push_back(packed);
+		vs.setEntryPoint(spv::ExecutionModelVertex, main, name, newIface);
+		vs.retargetExecutionModes(func, main, {});
+		emu.vertexSPIRV = vs.serialize();
+	}
+
+	// Geometry kernel
+	{
+		if ( !gs.makePrivate(gsIfaceVars)) { emu.error = gs.error; return false; }
+		uint32_t u32 = gs.typeUInt(), uint4 = gs.typeVector(u32, 4), boolT = gs.typeBool();
+		uint32_t inBuf = addStorageBuffer(gs, uint4, 16, kBindingVertices, true, "mvkVertices");
+		uint32_t outBuf = addStorageBuffer(gs, uint4, 16, kBindingOutVertices, false, "mvkOutVertices");
+		uint32_t idxBuf = addStorageBuffer(gs, u32, 4, kBindingOutIndices, false, "mvkOutIndices");
+
+		uint32_t paramsType = gs.addType(spv::OpTypeStruct, { u32, u32, u32, u32, u32 });
+		gs.decorate(paramsType, spv::DecorationBlock);
+		for (uint32_t i = 0; i < 5; i++) { gs.memberDecorate(paramsType, i, spv::DecorationOffset, { i * 4 }); }
+		uint32_t params = gs.addGlobal(makeInst(spv::OpVariable, { gs.typePointer(spv::StorageClassUniform, paramsType), gs.newId(), spv::StorageClassUniform }));
+		gs.decorate(params, spv::DecorationDescriptorSet, { kDescSet });
+		gs.decorate(params, spv::DecorationBinding, { kBindingParams });
+		gs.name(params, "mvkParams");
+
+		uint32_t uint3 = gs.typeVector(u32, 3);
+		uint32_t gidIn = gs.addGlobal(makeInst(spv::OpVariable, { gs.typePointer(spv::StorageClassInput, uint3), gs.newId(), spv::StorageClassInput }));
+		gs.decorate(gidIn, spv::DecorationBuiltIn, { spv::BuiltInGlobalInvocationId });
+		auto privateUInt = [&](const char* name) {
+			uint32_t v = gs.addGlobal(makeInst(spv::OpVariable, { gs.typePointer(spv::StorageClassPrivate, u32), gs.newId(), spv::StorageClassPrivate }));
+			gs.name(v, name);
+			return v;
+		};
+		uint32_t threadVar = privateUInt("mvkThread"), vertexCountVar = privateUInt("mvkVertexCount");
+		uint32_t indexCountVar = privateUInt("mvkIndexCount"), stripLengthVar = privateUInt("mvkStripLength");
+		uint32_t M = emu.maxOutputVertices, IS = emu.indicesPerThread;
+
+		// EmitVertex: write the outputs and an index, as long as there are slots left.
+		Builder b(gs);
+		uint32_t emitFunc = b.beginFunction();
+		{
+			uint32_t vc = b.load(u32, vertexCountVar);
+			uint32_t room = b.op(spv::OpULessThan, boolT, { vc, b.u(M) });
+			uint32_t body = gs.newId(), done = gs.newId();
+			b.opNoResult(spv::OpSelectionMerge, { done, spv::SelectionControlMaskNone });
+			b.opNoResult(spv::OpBranchConditional, { room, body, done });
+			b.label(body);
+			uint32_t thread = b.load(u32, threadVar);
+			uint32_t vertex = b.add(b.mul(thread, b.u(M)), vc);
+			uint32_t base = b.mul(vertex, b.u(emu.outputSlots));
+			std::unordered_set<uint32_t> written;
+			for (auto& var : gsOutputs) {
+				for (auto& leaf : var.leaves) {
+					if ( !written.insert(leaf.key).second) { continue; }
+					uint32_t src = b.chain(spv::StorageClassPrivate, leaf.type, var.id, leaf.path);
+					storePacked(b, outBuf, base, outSlots, leaf, b.load(leaf.type, src));
+				}
+			}
+			uint32_t ic = b.load(u32, indexCountVar);
+			uint32_t idxPtr = b.chain(spv::StorageClassStorageBuffer, u32, idxBuf, {}, { b.u(0), b.add(b.mul(thread, b.u(IS)), ic) });
+			b.store(idxPtr, vertex);
+			b.store(indexCountVar, b.add(ic, b.u(1)));
+			b.store(vertexCountVar, b.add(vc, b.u(1)));
+			b.store(stripLengthVar, b.add(b.load(u32, stripLengthVar), b.u(1)));
+			b.branch(done);
+			b.label(done);
+		}
+		b.endFunction();
+		gs.name(emitFunc, "mvkEmitVertex");
+
+		// EndPrimitive: restart the strip, unless it is empty.
+		uint32_t endFunc = b.beginFunction();
+		if (strips) {
+			uint32_t len = b.load(u32, stripLengthVar);
+			uint32_t open = b.op(spv::OpINotEqual, boolT, { len, b.u(0) });
+			uint32_t body = gs.newId(), done = gs.newId();
+			b.opNoResult(spv::OpSelectionMerge, { done, spv::SelectionControlMaskNone });
+			b.opNoResult(spv::OpBranchConditional, { open, body, done });
+			b.label(body);
+			uint32_t thread = b.load(u32, threadVar);
+			uint32_t ic = b.load(u32, indexCountVar);
+			uint32_t idxPtr = b.chain(spv::StorageClassStorageBuffer, u32, idxBuf, {}, { b.u(0), b.add(b.mul(thread, b.u(IS)), ic) });
+			b.store(idxPtr, b.u(kRestartIndex));
+			b.store(indexCountVar, b.add(ic, b.u(1)));
+			b.store(stripLengthVar, b.u(0));
+			b.branch(done);
+			b.label(done);
+		}
+		b.endFunction();
+		gs.name(endFunc, "mvkEndPrimitive");
+
+		// Calls replace the emit instructions, of stream 0 only.
+		for (auto& in : gs.functions) {
+			uint32_t op = in.op();
+			bool emit = op == spv::OpEmitVertex || op == spv::OpEmitStreamVertex;
+			bool end = op == spv::OpEndPrimitive || op == spv::OpEndStreamPrimitive;
+			if ( !emit && !end) { continue; }
+			bool stream0 = (op != spv::OpEmitStreamVertex && op != spv::OpEndStreamPrimitive) || gs.constantValue(in.w[1]) == 0;
+			if (stream0) {
+				in = makeInst(spv::OpFunctionCall, { gs.typeVoid(), gs.newId(), emit ? emitFunc : endFunc });
+			} else {
+				in = makeInst(spv::OpNop, {});
+			}
+		}
+		gs.functions.erase(std::remove_if(gs.functions.begin(), gs.functions.end(), [](const Inst& in) { return in.op() == spv::OpNop; }), gs.functions.end());
+
+		// The kernel: one thread per primitive of an instance and invocation.
+		uint32_t main = b.beginFunction();
+		{
+			uint32_t counter = b.op(spv::OpVariable, gs.typePointer(spv::StorageClassFunction, u32), { spv::StorageClassFunction });
+			uint32_t gid = b.op(spv::OpCompositeExtract, u32, { b.load(uint3, gidIn), 0 });
+			auto param = [&](uint32_t member) {
+				return b.load(u32, b.chain(spv::StorageClassUniform, u32, params, { member }));
+			};
+			uint32_t total = param(0);
+			uint32_t inRange = b.op(spv::OpULessThan, boolT, { gid, total });
+			uint32_t body = gs.newId(), done = gs.newId();
+			b.opNoResult(spv::OpSelectionMerge, { done, spv::SelectionControlMaskNone });
+			b.opNoResult(spv::OpBranchConditional, { inRange, body, done });
+			b.label(body);
+
+			b.store(threadVar, gid);
+			uint32_t I = emu.invocations;
+			uint32_t perInstance = param(1);
+			uint32_t invocation = b.mod_(gid, b.u(I));
+			uint32_t t = b.div(gid, b.u(I));
+			uint32_t prim = b.mod_(t, perInstance);
+			uint32_t instance = b.div(t, perInstance);
+			auto storeBuiltin = [&](uint32_t var, uint32_t val) {
+				if ( !var) { return; }
+				uint32_t pointee, storage;
+				gs.variable(var, pointee, storage);
+				b.store(var, b.bitcast(val, kKindUInt, pointee, gs.kind(pointee)));
+			};
+			storeBuiltin(primIdVar, prim);
+			storeBuiltin(invIdVar, invocation);
+
+			uint32_t first = b.add(b.mul(instance, param(4)), b.mul(prim, param(2)));
+			uint32_t swap = b.mul(b.op(spv::OpBitwiseAnd, u32, { prim, b.u(1) }), param(3));
+			for (uint32_t v = 0; v < emu.inputVertices; v++) {
+				uint32_t vertex = b.add(first, b.u(v));
+				if (v == 1) { vertex = b.add(vertex, swap); }
+				if (v == 2) { vertex = b.sub(vertex, swap); }
+				uint32_t base = b.mul(vertex, b.u(emu.inputSlots));
+				for (auto& var : gsInputs) {
+					for (auto& leaf : var.leaves) {
+						Words path = { v };
+						path.insert(path.end(), leaf.path.begin(), leaf.path.end());
+						uint32_t dst = b.chain(spv::StorageClassPrivate, leaf.type, var.id, path);
+						b.store(dst, loadPacked(b, inBuf, base, inSlots, leaf));
+					}
+				}
+			}
+			b.store(vertexCountVar, b.u(0));
+			b.store(indexCountVar, b.u(0));
+			b.store(stripLengthVar, b.u(0));
+			b.op(spv::OpFunctionCall, gs.typeVoid(), { gsFunc });
+
+			// Restart indices fill the slots left.
+			b.store(counter, b.load(u32, indexCountVar));
+			uint32_t header = gs.newId(), cond = gs.newId(), loop = gs.newId(), cont = gs.newId(), merge = gs.newId();
+			b.branch(header);
+			b.label(header);
+			b.opNoResult(spv::OpLoopMerge, { merge, cont, spv::LoopControlMaskNone });
+			b.branch(cond);
+			b.label(cond);
+			uint32_t i = b.load(u32, counter);
+			b.opNoResult(spv::OpBranchConditional, { b.op(spv::OpULessThan, boolT, { i, b.u(IS) }), loop, merge });
+			b.label(loop);
+			uint32_t idxPtr = b.chain(spv::StorageClassStorageBuffer, u32, idxBuf, {}, { b.u(0), b.add(b.mul(gid, b.u(IS)), i) });
+			b.store(idxPtr, b.u(kRestartIndex));
+			b.branch(cont);
+			b.label(cont);
+			b.store(counter, b.add(i, b.u(1)));
+			b.branch(header);
+			b.label(merge);
+			b.branch(done);
+			b.label(done);
+		}
+		b.endFunction();
+		gs.name(main, "mvkGeometryKernel");
+
+		Words iface = { gidIn };
+		if (gs.listsAllGlobals()) {
+			for (auto& g : gs.globals) {
+				if (g.op() == spv::OpVariable && g.w[3] != spv::StorageClassFunction && g.w[2] != gidIn) { iface.push_back(g.w[2]); }
+			}
+		}
+		gs.setEntryPoint(spv::ExecutionModelGLCompute, main, gsName, iface);
+		gs.retargetExecutionModes(gsFunc, main, kGeometryExecutionModes);
+		gs.execModes.push_back(makeInst(spv::OpExecutionMode, { main, spv::ExecutionModeLocalSize, 64, 1, 1 }));
+		emu.geometrySPIRV = gs.serialize();
+	}
+
+	// Replay vertex shader: the outputs of the geometry shader, read from the vertex its index names.
+	{
+		Module& r = replay;
+		std::unordered_set<uint32_t> removed;
+		for (auto& in : r.functions) { if (uint32_t id = resultId(in)) { removed.insert(id); } }
+		std::unordered_set<uint32_t> keptOutputs;
+		for (auto& var : gsOutputs) { if (var.builtin != spv::BuiltInPrimitiveId) { keptOutputs.insert(var.id); } }
+		for (uint32_t id : gsIfaceVars) { if ( !keptOutputs.count(id)) { removed.insert(id); } }
+		r.functions.clear();
+		r.execModes.clear();
+		r.globals.erase(std::remove_if(r.globals.begin(), r.globals.end(), [&](const Inst& g) { return removed.count(resultId(g)); }), r.globals.end());
+		r.reindex();
+		r.debug.erase(std::remove_if(r.debug.begin(), r.debug.end(), [&](const Inst& d) {
+			return (d.op() == spv::OpName || d.op() == spv::OpMemberName) && removed.count(d.w[1]);
+		}), r.debug.end());
+		r.annotations.erase(std::remove_if(r.annotations.begin(), r.annotations.end(), [&](const Inst& a) {
+			return a.w.size() > 1 && (removed.count(a.w[1]) || (a.op() == spv::OpDecorate && a.w[2] == spv::DecorationStream) ||
+									  (a.op() == spv::OpMemberDecorate && a.w[3] == spv::DecorationStream));
+		}), r.annotations.end());
+		if (emu.writesLayer || emu.writesViewportIndex) {
+			r.addCapability(spv::CapabilityShaderViewportIndexLayerEXT);
+			r.addExtension("SPV_EXT_shader_viewport_index_layer");
+		}
+
+		uint32_t u32 = r.typeUInt(), i32 = r.typeInt(), uint4 = r.typeVector(u32, 4), boolT = r.typeBool();
+		uint32_t vtxBuf = addStorageBuffer(r, uint4, 16, kBindingOutVertices, true, "mvkOutVertices");
+		uint32_t vidIn = r.addGlobal(makeInst(spv::OpVariable, { r.typePointer(spv::StorageClassInput, i32), r.newId(), spv::StorageClassInput }));
+		r.decorate(vidIn, spv::DecorationBuiltIn, { spv::BuiltInVertexIndex });
+
+		Builder b(r);
+		uint32_t main = b.beginFunction();
+		uint32_t vid = b.op(spv::OpBitcast, u32, { b.load(i32, vidIn) });
+		// Point lists do not restart, so restart indices reach the shader, which moves them off screen.
+		uint32_t isRestart = 0;
+		if ( !strips) {
+			isRestart = b.op(spv::OpIEqual, boolT, { vid, b.u(kRestartIndex) });
+			vid = b.op(spv::OpSelect, u32, { isRestart, b.u(0), vid });
+		}
+		uint32_t base = b.mul(vid, b.u(emu.outputSlots));
+		std::unordered_set<uint32_t> written;
+		for (auto& var : gsOutputs) {
+			if ( !keptOutputs.count(var.id)) { continue; }
+			for (auto& leaf : var.leaves) {
+				uint32_t val = loadPacked(b, vtxBuf, base, outSlots, leaf);
+				if (isRestart && leaf.key >= kKeyPosition && leaf.key < kKeyPosition + 4 && leaf.kind == kKindFloat) {
+					float off = leaf.key == kKeyPosition + 3 ? 1.0f : 2.0f;
+					uint32_t bits;
+					memcpy(&bits, &off, 4);
+					val = b.op(spv::OpSelect, leaf.type, { isRestart, r.constant(leaf.type, bits), val });
+				}
+				b.store(b.chain(spv::StorageClassOutput, leaf.type, var.id, leaf.path), val);
+			}
+		}
+		b.endFunction();
+		r.name(main, "mvkReplayVertices");
+
+		Words iface(keptOutputs.begin(), keptOutputs.end());
+		std::sort(iface.begin(), iface.end());
+		iface.push_back(vidIn);
+		if (r.listsAllGlobals()) { iface.push_back(vtxBuf); }
+		r.setEntryPoint(spv::ExecutionModelVertex, main, gsName, iface);
+		emu.replaySPIRV = r.serialize();
+	}
+	return true;
+}
+
+}	// namespace mvk_gs
