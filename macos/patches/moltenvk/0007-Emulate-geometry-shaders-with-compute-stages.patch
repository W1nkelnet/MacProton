+// Emulates the geometry shader with compute stages, if it can be.
+void MVKGraphicsPipeline::initGeometryEmulation(MVKShaderModule* geometryModule,
+												const VkPipelineShaderStageCreateInfo* pVertexSS,
+												const VkPipelineShaderStageCreateInfo* pGeometrySS) {
+	const char* enable = getenv("MVK_CONFIG_EMULATE_GEOMETRY_SHADERS");
+	if (enable && *enable == '0') { return; }
+
+	mvk_gs::Emulation emu;
+	if ( !mvk_gs::buildEmulation(_vertexModule->getSPIRV(), pVertexSS->pName, geometryModule->getSPIRV(), pGeometrySS->pName, emu)) {
+		reportWarning(VK_ERROR_FEATURE_NOT_PRESENT, "The geometry shader cannot be emulated, so it is ignored: %s", emu.error.c_str());
+		return;
+	}
+
+	auto newModule = [this](const std::vector<uint32_t>& spv) {
+		VkShaderModuleCreateInfo smInfo = {};
+		smInfo.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+		smInfo.codeSize = spv.size() * sizeof(uint32_t);
+		smInfo.pCode = spv.data();
+		return new MVKShaderModule(getDevice(), &smInfo);
+	};
+	_unemulatedVertexModule = _vertexModule;
+	_ownsUnemulatedVertexModule = _ownsVertexModule;
+	_unemulatedPrimitiveTopologyClass = _primitiveTopologyClass;
+	_vertexModule = newModule(emu.vertexSPIRV);
+	_ownsVertexModule = true;
+	_geometryModule = newModule(emu.geometrySPIRV);
+	_geometryReplayModule = newModule(emu.replaySPIRV);
+
+	_geometryStage.inputVertices = emu.inputVertices;
+	_geometryStage.maxOutputVertices = emu.maxOutputVertices;
+	_geometryStage.invocations = emu.invocations;
+	_geometryStage.inputSlots = emu.inputSlots;
+	_geometryStage.outputSlots = emu.outputSlots;
+	_geometryStage.indicesPerThread = emu.indicesPerThread;
+	switch (emu.outputPrimitive) {
+		case spv::ExecutionModeOutputPoints:
+			_geometryStage.outputPrimitiveType = MTLPrimitiveTypePoint;
+			_primitiveTopologyClass = MTLPrimitiveTopologyClassPoint;
+			break;
+		case spv::ExecutionModeOutputLineStrip:
+			_geometryStage.outputPrimitiveType = MTLPrimitiveTypeLineStrip;
+			_primitiveTopologyClass = MTLPrimitiveTopologyClassLine;
+			break;
+		default:
+			_geometryStage.outputPrimitiveType = MTLPrimitiveTypeTriangleStrip;
+			_primitiveTopologyClass = MTLPrimitiveTopologyClassTriangle;
+			break;
+	}
+	_isGeometryPipeline = true;
+	MVKLogInfo("Emulating a geometry shader with %u input vertices, up to %u output vertices and %u invocations.",
+				emu.inputVertices, emu.maxOutputVertices, emu.invocations);
+}
+
+// Goes back to ignoring the geometry shader.
+void MVKGraphicsPipeline::endGeometryEmulation() {
+	if ( !_isGeometryPipeline) { return; }
+	if (_ownsVertexModule) { delete _vertexModule; }
+	_vertexModule = _unemulatedVertexModule;
+	_ownsVertexModule = _ownsUnemulatedVertexModule;
+	_unemulatedVertexModule = nullptr;
+	_ownsUnemulatedVertexModule = false;
+	delete _geometryModule;
+	delete _geometryReplayModule;
+	_geometryModule = nullptr;
+	_geometryReplayModule = nullptr;
+	_primitiveTopologyClass = _unemulatedPrimitiveTopologyClass;
+	_isGeometryPipeline = false;
+}
+
+// Adds the resource bindings of the buffers that connect the emulated geometry stages.
+static void addGeometryEmulationBinding(SPIRVToMSLConversionConfiguration& shaderConfig, spv::ExecutionModel stage, uint32_t binding, uint32_t mtlBuffer) {
+	mvk::MSLResourceBinding rb;
+	auto& rbb = rb.resourceBinding;
+	rbb.stage = stage;
+	rbb.basetype = SPIRType::Void;
+	rbb.desc_set = mvk_gs::kDescSet;
+	rbb.binding = binding;
+	rbb.count = 1;
+	rbb.msl_buffer = mtlBuffer;
+	shaderConfig.resourceBindings.push_back(rb);
+}
+
+// They are bound by the draw, not from descriptor sets.
+static void removeGeometryEmulationBindings(SPIRVToMSLConversionConfiguration& shaderConfig) {
+	auto& rbs = shaderConfig.resourceBindings;
+	rbs.erase(std::remove_if(rbs.begin(), rbs.end(), [](const mvk::MSLResourceBinding& rb) {
+		return rb.resourceBinding.desc_set == mvk_gs::kDescSet;
+	}), rbs.end());
+}
