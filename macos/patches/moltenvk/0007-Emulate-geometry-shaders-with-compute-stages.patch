+/** The buffers and parameters of a draw through an emulated geometry shader. */
+struct MVKGeometryDraw {
+	mvk_gs::Params params = {};
+	const MVKMTLBufferAllocation* gsOutBuff = nullptr;
+	const MVKMTLBufferAllocation* gsIdxBuff = nullptr;
+};
+
+// Finds the input primitives of a draw of vertexCount vertices per instance. Returns false if there are none.
+static bool mvkGetGeometryParams(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline,
+								 uint32_t vertexCount, uint32_t instanceCount, mvk_gs::Params& params) {
+	const auto& gsInfo = pipeline->getGeometryStageInfo();
+	VkPrimitiveTopology topology = pipeline->getVkPrimitiveTopology();
+	switch (topology) {
+		case VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY:
+		case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY:
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST_WITH_ADJACENCY:
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY:
+			break;
+		default:
+			// The topology may be dynamic, within its class
+			switch (cmdEncoder->getVkGraphics().pickRenderState(MVKRenderStateFlag::PrimitiveTopology).primitiveType) {
+				case MTLPrimitiveTypePoint:         topology = VK_PRIMITIVE_TOPOLOGY_POINT_LIST; break;
+				case MTLPrimitiveTypeLine:          topology = VK_PRIMITIVE_TOPOLOGY_LINE_LIST; break;
+				case MTLPrimitiveTypeLineStrip:     topology = VK_PRIMITIVE_TOPOLOGY_LINE_STRIP; break;
+				case MTLPrimitiveTypeTriangle:      topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST; break;
+				case MTLPrimitiveTypeTriangleStrip: topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP; break;
+				default: break;
+			}
+			break;
+	}
+	uint32_t n = gsInfo.inputVertices;
+	params = {};
+	switch (topology) {
+		case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP:
+		case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY:
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP:
+			params.primitivesPerInstance = vertexCount >= n ? vertexCount - n + 1 : 0;
+			params.primitiveStride = 1;
+			params.triangleStrip = topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP;
+			break;
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY:
+			MVKLogWarnOnce("Geometry shaders are not supported with triangle strips with adjacency.");
+			return false;
+		default:
+			params.primitivesPerInstance = vertexCount / n;
+			params.primitiveStride = n;
+			break;
+	}
+	params.verticesPerInstance = vertexCount;
+	uint64_t threads = uint64_t(params.primitivesPerInstance) * instanceCount * gsInfo.invocations;
+	params.threadCount = uint32_t(std::min<uint64_t>(threads, UINT32_MAX / std::max(gsInfo.indicesPerThread, 1u)));
+	return params.threadCount > 0;
+}
+
+// The size of the buffer the vertex stage writes to, for a geometry or tessellation pipeline.
+static NSUInteger mvkGetVertexOutputSize(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline, NSUInteger vertexCount) {
+	if (pipeline->isGeometryPipeline()) { return vertexCount * 16 * pipeline->getGeometryStageInfo().inputSlots; }
+	return vertexCount * 4 * cmdEncoder->getDeviceProperties().limits.maxVertexOutputComponents;
+}
+
+// Runs the geometry stage on what the vertex stage wrote to vtxOutBuff.
+static void mvkEncodeGeometryStage(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline,
+								   const MVKMTLBufferAllocation* vtxOutBuff, MVKGeometryDraw& gs) {
+	const auto& gsInfo = pipeline->getGeometryStageInfo();
+	const auto& implicit = pipeline->getImplicitBuffers(kMVKShaderStageTessCtl).ids;
+	id<MTLComputeCommandEncoder> mtlEncoder = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+	NSUInteger threads = gs.params.threadCount;
+	gs.gsOutBuff = cmdEncoder->getTempMTLBuffer(threads * gsInfo.maxOutputVertices * gsInfo.outputSlots * 16, true);
+	gs.gsIdxBuff = cmdEncoder->getTempMTLBuffer(threads * gsInfo.indicesPerThread * sizeof(uint32_t), true);
+	[mtlEncoder setBuffer: vtxOutBuff->_mtlBuffer
+				   offset: vtxOutBuff->_offset
+				  atIndex: cmdEncoder->getDevice()->getMetalBufferIndexForVertexAttributeBinding(kMVKTessCtlInputBufferBinding)];
+	[mtlEncoder setBuffer: gs.gsOutBuff->_mtlBuffer offset: gs.gsOutBuff->_offset atIndex: implicit[MVKImplicitBuffer::Output]];
+	[mtlEncoder setBuffer: gs.gsIdxBuff->_mtlBuffer offset: gs.gsIdxBuff->_offset atIndex: implicit[MVKImplicitBuffer::PatchOutput]];
+	cmdEncoder->setComputeBytes(mtlEncoder, &gs.params, sizeof(gs.params), implicit[MVKImplicitBuffer::IndirectParams]);
+	NSUInteger wgSize = pipeline->getTessControlStageState().threadExecutionWidth;
+	if (cmdEncoder->getMetalFeatures().nonUniformThreadgroups) {
+		[mtlEncoder dispatchThreads: MTLSizeMake(threads, 1, 1) threadsPerThreadgroup: MTLSizeMake(wgSize, 1, 1)];
+	} else {
+		[mtlEncoder dispatchThreadgroups: MTLSizeMake(mvkCeilingDivide<NSUInteger>(threads, wgSize), 1, 1)
+				   threadsPerThreadgroup: MTLSizeMake(wgSize, 1, 1)];
+	}
+	// Running this stage prematurely ended the render pass, so we have to start it up again.
+	cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+}
+
+// Kernels converting indirect draws for an emulated geometry shader into the arguments of its stages.
+static const char* kMVKGeometryIndirectSource = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct Layout {
+	uint inputVertices;		// Vertices of an input primitive
+	uint strip;				// Primitives advance by one vertex
+	uint triangleStrip;
+	uint invocations;
+	uint indicesPerThread;
+	uint vertexWidth;		// Threads per threadgroup of the vertex stage
+	uint geometryWidth;		// Threads per threadgroup of the geometry stage
+	uint maxRecords;		// Vertices the vertex stage can write
+	uint maxThreads;		// Threads the geometry stage can write for
+	uint indexed;
+	uint drawStride;		// Bytes between indirect draws
+};
+
+// Per draw, 64 words: kernel parameters, stage-in region, vertex and geometry threadgroups, and the indexed draw.
+kernel void mvkGeometryIndirectConvert(const device uchar* draws [[buffer(0)]],
+									   device uint* out [[buffer(1)]],
+									   constant Layout& l [[buffer(2)]],
+									   constant uint& drawCount [[buffer(3)]],
+									   const device uint* countBuffer [[buffer(4)]],	// Draws to run, at most drawCount
+									   uint i [[thread_position_in_grid]]) {
+	if (i >= drawCount) { return; }
+	const device uint* a = (const device uint*)(draws + i * l.drawStride);
+	uint count = i < countBuffer[0] ? min(a[0], l.maxRecords) : 0;
+	uint instances = a[1];
+	uint origin = l.indexed ? a[3] : a[2];
+	uint firstInstance = l.indexed ? a[4] : a[3];
+	// The vertex stage writes the vertices of each instance after those of the previous one.
+	instances = count ? min(instances, l.maxRecords / count) : 0;
+	uint n = l.inputVertices;
+	uint prims = l.strip ? (count >= n ? count - n + 1 : 0) : count / n;
+	uint threadsPerInstance = prims * l.invocations;
+	instances = threadsPerInstance ? min(instances, l.maxThreads / threadsPerInstance) : 0;
+	uint threads = threadsPerInstance * instances;
+
+	device uint* o = out + i * 64;
+	o[0] = threads; o[1] = prims; o[2] = l.strip ? 1 : n; o[3] = l.triangleStrip; o[4] = count;
+	o[8] = origin; o[9] = firstInstance; o[10] = 0; o[11] = count; o[12] = instances; o[13] = 1;
+	o[16] = instances ? (count + l.vertexWidth - 1) / l.vertexWidth : 0; o[17] = instances; o[18] = 1;
+	o[20] = (threads + l.geometryWidth - 1) / l.geometryWidth; o[21] = 1; o[22] = 1;
+	o[24] = threads * l.indicesPerThread; o[25] = 1; o[26] = 0; o[27] = 0; o[28] = 0;
+}
+
+// The indices of an indexed indirect draw, copied to the start of a buffer for the vertex stage.
+kernel void mvkGeometryIndirectCopyIndices(const device uint* draw [[buffer(0)]],
+										   const device uchar* src [[buffer(1)]],
+										   device uchar* dst [[buffer(2)]],
+										   constant uint4& p [[buffer(3)]],	// Index size, first index offset, max records
+										   uint i [[thread_position_in_grid]]) {
+	if (i >= min(draw[0], p.z)) { return; }
+	uint first = draw[2] + p.y;
+	if (p.x == 2) {
+		((device ushort*)dst)[i] = ((const device ushort*)src)[first + i];
+	} else {
+		((device uint*)dst)[i] = ((const device uint*)src)[first + i];
+	}
+}
+)";
+
+static id<MTLComputePipelineState> mvkGetGeometryIndirectState(MVKCommandEncoder* cmdEncoder, NSString* name) {
+	static NSMutableDictionary* states = [NSMutableDictionary new];
+	id<MTLDevice> mtlDevice = cmdEncoder->getPhysicalDevice()->getMTLDevice();
+	NSString* key = [NSString stringWithFormat: @"%p-%@", mtlDevice, name];
+	@synchronized (states) {
+		id<MTLComputePipelineState> state = states[key];
+		if (state) { return state; }
+		@autoreleasepool {
+			NSError* err = nil;
+			id<MTLLibrary> lib = [[mtlDevice newLibraryWithSource: @(kMVKGeometryIndirectSource) options: nil error: &err] autorelease];
+			id<MTLFunction> func = [[lib newFunctionWithName: name] autorelease];
+			state = func ? [[mtlDevice newComputePipelineStateWithFunction: func error: &err] autorelease] : nil;
+			if ( !state) {
+				MVKBaseObject::reportMessage(nullptr, MVK_CONFIG_LOG_LEVEL_ERROR, "Could not compile %s: %s", name.UTF8String, err.description.UTF8String);
+				return nil;
+			}
+			states[key] = state;
+			return state;
+		}
+	}
+}
+
+static const uint32_t kMVKMaxGeometryIndirectVertexCount = 128 * KIBI;
+static const NSUInteger kMVKMaxGeometryIndirectOutputBytes = 128 * MEBI;
+
+// Draws indirect draws through an emulated geometry shader. Since their counts are only known to the GPU,
+// a kernel converts them into the arguments of each stage, within buffers of a fixed size.
+static void mvkEncodeGeometryIndirect(MVKCommandEncoder* cmdEncoder, id<MTLBuffer> indBuff, VkDeviceSize indOffset,
+									  uint32_t indStride, uint32_t drawCount, id<MTLBuffer> countBuff, VkDeviceSize countOffset,
+									  const MVKIndexMTLBufferBinding* ibb) {
+	auto* pipeline = cmdEncoder->getGraphicsPipeline();
+	const auto& gsInfo = pipeline->getGeometryStageInfo();
+	if (drawCount == 0) { return; }
+	cmdEncoder->_isIndexedDraw = ibb != nullptr;
+
+	struct {
+		uint32_t inputVertices, strip, triangleStrip, invocations, indicesPerThread;
+		uint32_t vertexWidth, geometryWidth, maxRecords, maxThreads, indexed, drawStride;
+	} layout = {};
+	VkPrimitiveTopology topology = pipeline->getVkPrimitiveTopology();
+	if (topology != VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY && topology != VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY) {
+		switch (cmdEncoder->getVkGraphics().pickRenderState(MVKRenderStateFlag::PrimitiveTopology).primitiveType) {
+			case MTLPrimitiveTypeLineStrip:     topology = VK_PRIMITIVE_TOPOLOGY_LINE_STRIP; break;
+			case MTLPrimitiveTypeTriangleStrip: topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP; break;
+			default: break;
+		}
+	}
+	if (topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY) {
+		MVKLogWarnOnce("Geometry shaders are not supported with triangle strips with adjacency.");
+		return;
+	}
+	layout.inputVertices = gsInfo.inputVertices;
+	layout.strip = topology == VK_PRIMITIVE_TOPOLOGY_LINE_STRIP || topology == VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY || topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP;
+	layout.triangleStrip = topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP;
+	layout.invocations = gsInfo.invocations;
+	layout.indicesPerThread = gsInfo.indicesPerThread;
+	layout.indexed = ibb != nullptr;
+	layout.drawStride = indStride;
+	id<MTLComputePipelineState> vtxState = !ibb ? pipeline->getTessVertexStageState() :
+		ibb->mtlIndexType == MTLIndexTypeUInt16 ? pipeline->getTessVertexStageIndex16State() : pipeline->getTessVertexStageIndex32State();
+	id<MTLComputePipelineState> gsState = pipeline->getTessControlStageState();
+	layout.vertexWidth = uint32_t(vtxState.threadExecutionWidth);
+	layout.geometryWidth = uint32_t(gsState.threadExecutionWidth);
+	layout.maxRecords = kMVKMaxGeometryIndirectVertexCount;
+	NSUInteger bytesPerThread = NSUInteger(gsInfo.maxOutputVertices) * gsInfo.outputSlots * 16 + gsInfo.indicesPerThread * sizeof(uint32_t);
+	layout.maxThreads = uint32_t(std::max<NSUInteger>(std::min<NSUInteger>(kMVKMaxGeometryIndirectOutputBytes / bytesPerThread, NSUInteger(layout.maxRecords) * gsInfo.invocations), 1));
+
+	id<MTLComputePipelineState> convertState = mvkGetGeometryIndirectState(cmdEncoder, @"mvkGeometryIndirectConvert");
+	id<MTLComputePipelineState> copyState = ibb ? mvkGetGeometryIndirectState(cmdEncoder, @"mvkGeometryIndirectCopyIndices") : nil;
+	if ( !convertState || (ibb && !copyState)) { return; }
+
+	static const NSUInteger kArgsStride = 256;
+	auto* argsBuff = cmdEncoder->getTempMTLBuffer(drawCount * kArgsStride, true);
+	auto* vtxOutBuff = cmdEncoder->getTempMTLBuffer(NSUInteger(layout.maxRecords) * 16 * gsInfo.inputSlots, true);
+	auto* gsOutBuff = cmdEncoder->getTempMTLBuffer(NSUInteger(layout.maxThreads) * gsInfo.maxOutputVertices * gsInfo.outputSlots * 16, true);
+	auto* gsIdxBuff = cmdEncoder->getTempMTLBuffer(NSUInteger(layout.maxThreads) * gsInfo.indicesPerThread * sizeof(uint32_t), true);
+	uint32_t idxSize = ibb ? uint32_t(mvkMTLIndexTypeSizeInBytes((MTLIndexType)ibb->mtlIndexType)) : 0;
+	auto* idxCopyBuff = ibb ? cmdEncoder->getTempMTLBuffer(NSUInteger(layout.maxRecords) * idxSize, true) : nullptr;
+	const MVKMTLBufferAllocation* drawIDBuff = nullptr;
+	if (pipeline->needsDrawIdBuffer()) {
+		drawIDBuff = cmdEncoder->getTempMTLBuffer(drawCount * sizeof(uint32_t));
+		auto* drawIDs = (uint32_t*)drawIDBuff->getContents();
+		for (uint32_t i = 0; i < drawCount; i++) { drawIDs[i] = i; }
+	}
+	auto& mtlFeats = cmdEncoder->getMetalFeatures();
+	auto dispatch = [&](id<MTLComputeCommandEncoder> enc, NSUInteger threads, NSUInteger width) {
+		if (mtlFeats.nonUniformThreadgroups) {
+			[enc dispatchThreads: MTLSizeMake(threads, 1, 1) threadsPerThreadgroup: MTLSizeMake(width, 1, 1)];
+		} else {
+			[enc dispatchThreadgroups: MTLSizeMake(mvkCeilingDivide<NSUInteger>(threads, width), 1, 1) threadsPerThreadgroup: MTLSizeMake(width, 1, 1)];
+		}
+	};
+
+	// This must happen before finalizing draw state, so it binds the stage pipelines again afterwards.
+	cmdEncoder->encodeStoreActions(true);
+	id<MTLComputeCommandEncoder> mtlEnc = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+	MVKMetalComputeCommandEncoderState& mtlState = cmdEncoder->getMtlCompute();
+	mtlState.bindPipeline(mtlEnc, convertState);
+	mtlState.bindBuffer(mtlEnc, indBuff, indOffset, 0);
+	mtlState.bindBuffer(mtlEnc, argsBuff->_mtlBuffer, argsBuff->_offset, 1);
+	mtlState.bindBytes(mtlEnc, &layout, sizeof(layout), 2);
+	mtlState.bindBytes(mtlEnc, &drawCount, sizeof(drawCount), 3);
+	if (countBuff) {
+		mtlState.bindBuffer(mtlEnc, countBuff, countOffset, 4);
+	} else {
+		auto* countAlloc = cmdEncoder->getTempMTLBuffer(sizeof(uint32_t));
+		*(uint32_t*)countAlloc->getContents() = drawCount;
+		mtlState.bindBuffer(mtlEnc, countAlloc->_mtlBuffer, countAlloc->_offset, 4);
+	}
+	dispatch(mtlEnc, drawCount, convertState.threadExecutionWidth);
+
+	const auto& vtxImplicit = pipeline->getImplicitBuffers(kMVKShaderStageVertex).ids;
+	const auto& gsImplicit = pipeline->getImplicitBuffers(kMVKShaderStageTessCtl).ids;
+	for (uint32_t d = 0; d < drawCount; d++) {
+		NSUInteger args = argsBuff->_offset + d * kArgsStride;
+		if (ibb) {
+			// Buffer offsets must be four-byte aligned, the first index need not be.
+			uint32_t copyParams[4] = { idxSize, uint32_t(ibb->offset & 3) / idxSize, layout.maxRecords, 0 };
+			mtlEnc = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+			mtlState.bindPipeline(mtlEnc, copyState);
+			mtlState.bindBuffer(mtlEnc, indBuff, indOffset + d * indStride, 0);
+			mtlState.bindBuffer(mtlEnc, ibb->mtlBuffer, ibb->offset & ~VkDeviceSize(3), 1);
+			mtlState.bindBuffer(mtlEnc, idxCopyBuff->_mtlBuffer, idxCopyBuff->_offset, 2);
+			mtlState.bindBytes(mtlEnc, copyParams, sizeof(copyParams), 3);
+			dispatch(mtlEnc, layout.maxRecords, copyState.threadExecutionWidth);
+		}
+
+		cmdEncoder->finalizeDrawState(kMVKGraphicsStageVertex);
+		if ( !pipeline->hasValidMTLPipelineStates()) { return; }
+		mtlEnc = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+		[mtlEnc setBuffer: vtxOutBuff->_mtlBuffer offset: vtxOutBuff->_offset atIndex: vtxImplicit[MVKImplicitBuffer::Output]];
+		if (drawIDBuff) {
+			[mtlEnc setBuffer: drawIDBuff->_mtlBuffer offset: drawIDBuff->_offset + d * sizeof(uint32_t) atIndex: vtxImplicit[MVKImplicitBuffer::DrawId]];
+		}
+		if (ibb) {
+			[mtlEnc setBuffer: idxCopyBuff->_mtlBuffer offset: idxCopyBuff->_offset atIndex: vtxImplicit[MVKImplicitBuffer::Index]];
+		}
+		[mtlEnc setStageInRegion: MTLRegionMake2D(0, 0, layout.maxRecords, layout.maxRecords)];
+		[mtlEnc setStageInRegionWithIndirectBuffer: argsBuff->_mtlBuffer indirectBufferOffset: args + 8 * sizeof(uint32_t)];
+		[mtlEnc dispatchThreadgroupsWithIndirectBuffer: argsBuff->_mtlBuffer
+								  indirectBufferOffset: args + 16 * sizeof(uint32_t)
+								 threadsPerThreadgroup: MTLSizeMake(layout.vertexWidth, 1, 1)];
+
+		cmdEncoder->finalizeDrawState(kMVKGraphicsStageTessControl);
+		if ( !pipeline->hasValidMTLPipelineStates()) { return; }
+		mtlEnc = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+		[mtlEnc setBuffer: vtxOutBuff->_mtlBuffer
+				   offset: vtxOutBuff->_offset
+				  atIndex: cmdEncoder->getDevice()->getMetalBufferIndexForVertexAttributeBinding(kMVKTessCtlInputBufferBinding)];
+		[mtlEnc setBuffer: gsOutBuff->_mtlBuffer offset: gsOutBuff->_offset atIndex: gsImplicit[MVKImplicitBuffer::Output]];
+		[mtlEnc setBuffer: gsIdxBuff->_mtlBuffer offset: gsIdxBuff->_offset atIndex: gsImplicit[MVKImplicitBuffer::PatchOutput]];
+		[mtlEnc setBuffer: argsBuff->_mtlBuffer offset: args atIndex: gsImplicit[MVKImplicitBuffer::IndirectParams]];
+		[mtlEnc dispatchThreadgroupsWithIndirectBuffer: argsBuff->_mtlBuffer
+								  indirectBufferOffset: args + 20 * sizeof(uint32_t)
+								 threadsPerThreadgroup: MTLSizeMake(layout.geometryWidth, 1, 1)];
+		cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+
+		cmdEncoder->finalizeDrawState(kMVKGraphicsStageRasterization);
+		[cmdEncoder->_mtlRenderEncoder setVertexBuffer: gsOutBuff->_mtlBuffer
+												offset: gsOutBuff->_offset
+											   atIndex: cmdEncoder->getDevice()->getMetalBufferIndexForVertexAttributeBinding(kMVKTessEvalInputBufferBinding)];
+		[cmdEncoder->_mtlRenderEncoder drawIndexedPrimitives: gsInfo.outputPrimitiveType
+												   indexType: MTLIndexTypeUInt32
+												 indexBuffer: gsIdxBuff->_mtlBuffer
+										   indexBufferOffset: gsIdxBuff->_offset
+											  indirectBuffer: argsBuff->_mtlBuffer
+										indirectBufferOffset: args + 24 * sizeof(uint32_t)];
+		if (d + 1 < drawCount) {
+			cmdEncoder->encodeStoreActions(true);
+		}
+	}
+}
+
+// Draws the strips, lines or points the geometry stage emitted.
+static void mvkEncodeGeometryRasterization(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline, const MVKGeometryDraw& gs) {
+	const auto& gsInfo = pipeline->getGeometryStageInfo();
+	[cmdEncoder->_mtlRenderEncoder setVertexBuffer: gs.gsOutBuff->_mtlBuffer
+											offset: gs.gsOutBuff->_offset
+										   atIndex: cmdEncoder->getDevice()->getMetalBufferIndexForVertexAttributeBinding(kMVKTessEvalInputBufferBinding)];
+	[cmdEncoder->_mtlRenderEncoder drawIndexedPrimitives: gsInfo.outputPrimitiveType
+											  indexCount: NSUInteger(gs.params.threadCount) * gsInfo.indicesPerThread
+											   indexType: MTLIndexTypeUInt32
+											 indexBuffer: gs.gsIdxBuff->_mtlBuffer
+									   indexBufferOffset: gs.gsIdxBuff->_offset
+										   instanceCount: 1];
+}
 
 
 #pragma mark -
@@ -212,6 +556,10 @@ void MVKCmdDraw::encode(MVKCommandEncoder* cmdEncoder) {
         outControlPointCount = pipeline->getOutputControlPointCount();
         tessParams.patchCount = mvkCeilingDivide(_vertexCount, tessParams.inControlPointCount) * _instanceCount;
