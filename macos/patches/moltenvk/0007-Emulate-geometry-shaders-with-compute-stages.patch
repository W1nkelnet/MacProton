+#pragma mark -
+#pragma mark Geometry shader emulation
+
+#define MVKLogWarnOnce(fmt, ...) do { static bool warned = false; if ( !warned) { warned = true; MVKBaseObject::reportMessage(nullptr, MVK_CONFIG_LOG_LEVEL_WARNING, fmt, ##__VA_ARGS__); } } while (0)
