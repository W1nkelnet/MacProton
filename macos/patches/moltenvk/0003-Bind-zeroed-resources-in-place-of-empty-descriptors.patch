 uint64_t mvkGetLocationID(id<MTLDevice> mtlDevice);
+
+/**
+ * Zeroed resources bound in place of empty descriptors. Without nullDescriptor,
+ * applications such as vkd3d-proton still leave descriptors empty that shaders
+ * read, and Metal faults on a nil resource ("Invalid Resource") where Vulkan with
+ * nullDescriptor would return zero. All nil until a device has created them.
+ */
+struct MVKNullResources {
+	id<MTLBuffer> buffer = nil;
+	id<MTLTexture> texture = nil;
+	id<MTLSamplerState> sampler = nil;
+};
+const MVKNullResources& mvkGetNullResources();
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
index fc3924e..f8e48c4 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
@@ -5149,6 +5149,7 @@ MVKDevice::MVKDevice(MVKPhysicalDevice* physicalDevice, const VkDeviceCreateInfo
 	enableExtensions(pCreateInfo);
 	enableFeatures(pCreateInfo);
 	initQueues(pCreateInfo);
+	initNullResources();
 	reservePrivateData(pCreateInfo);
 	initConfiguration();
 
@@ -5453,6 +5454,43 @@ void MVKDevice::enableExtensions(const VkDeviceCreateInfo* pCreateInfo) {
 													 &_physicalDevice->_supportedExtensions));
 }
 
+static MVKNullResources _mvkNullResources;
+
+const MVKNullResources& mvkGetNullResources() { return _mvkNullResources; }
+
+// Large enough for any uniform buffer an application could expect
+static constexpr NSUInteger kMVKNullBufferSize = 64 * KIBI;
+
+void MVKDevice::initNullResources() {
+	static std::once_flag once;
+	id<MTLDevice> mtlDev = _physicalDevice->getMTLDevice();
+	std::call_once(once, [mtlDev]() {
+		@autoreleasepool {
+			id<MTLBuffer> buffer = [mtlDev newBufferWithLength: kMVKNullBufferSize options: MTLResourceStorageModeShared];	// retained
+			memset(buffer.contents, 0, kMVKNullBufferSize);
+			buffer.label = @"MoltenVK null descriptor buffer";
+
+			MTLTextureDescriptor* texDesc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat: MTLPixelFormatRGBA8Unorm
+																							   width: 1 height: 1 mipmapped: NO];
+			texDesc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+			texDesc.storageMode = MTLStorageModeShared;
+			id<MTLTexture> texture = [mtlDev newTextureWithDescriptor: texDesc];	// retained
+			uint32_t zero = 0;
+			[texture replaceRegion: MTLRegionMake2D(0, 0, 1, 1) mipmapLevel: 0 withBytes: &zero bytesPerRow: sizeof(zero)];
+			texture.label = @"MoltenVK null descriptor texture";
+
+			MTLSamplerDescriptor* sampDesc = [MTLSamplerDescriptor new];	// temp retained
+			sampDesc.supportArgumentBuffers = YES;
+			id<MTLSamplerState> sampler = [mtlDev newSamplerStateWithDescriptor: sampDesc];	// retained
+			[sampDesc release];
+
+			_mvkNullResources = { buffer, texture, sampler };
+		}
+	});
+	makeResident(_mvkNullResources.buffer);
+	makeResident(_mvkNullResources.texture);
+}
