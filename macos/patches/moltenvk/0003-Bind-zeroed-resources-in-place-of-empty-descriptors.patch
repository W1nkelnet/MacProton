From 39eaa7bf5a3b28612e5610ba581346a6e03d7b1d Mon Sep 17 00:00:00 2001
From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Wed, 28 Oct 2026 16:40:17 +0100
Subject: [PATCH 3/3] Bind zeroed resources in place of empty descriptors.

MoltenVK has no nullDescriptor, yet applications such as vkd3d-proton
still leave descriptors empty that shaders read, as D3D12 allows. Metal
faults on a nil resource in an argument buffer or binding. Bind a zeroed
64 KiB buffer, a 1x1 texture and a sampler instead, created once and
made resident in each device, in argument buffers, descriptor copies and
direct bindings, and for null vertex buffers, which were dereferenced.
---
 MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm      | 13 ++++--
 .../Commands/MVKCommandEncoderState.mm        | 22 ++++++++++
 .../MoltenVK/GPUObjects/MVKDescriptorSet.mm   | 44 +++++++++++--------
 MoltenVK/MoltenVK/GPUObjects/MVKDevice.h      | 14 ++++++
 MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm     | 38 ++++++++++++++++
 5 files changed, 110 insertions(+), 21 deletions(-)

diff --git a/MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm b/MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm
index 664276b..0d28d68 100644
--- a/MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm
+++ b/MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm
@@ -42,9 +42,16 @@ VkResult MVKCmdBindVertexBuffers<N>::setContent(MVKCommandBuffer* cmdBuff,
     MVKVertexMTLBufferBinding b;
     for (uint32_t bindIdx = 0; bindIdx < bindingCount; bindIdx++) {
         MVKBuffer* mvkBuffer = (MVKBuffer*)pBuffers[bindIdx];
-        b.mtlBuffer = mvkBuffer->getMTLBuffer();
-        b.offset = mvkBuffer->getMTLBufferOffset() + pOffsets[bindIdx];
-		b.size = pSizes ? uint32_t(pSizes[bindIdx] == VK_WHOLE_SIZE ? mvkBuffer->getByteCount() - pOffsets[bindIdx] : pSizes[bindIdx]) : 0;
+        if (mvkBuffer) {
+            b.mtlBuffer = mvkBuffer->getMTLBuffer();
+            b.offset = mvkBuffer->getMTLBufferOffset() + pOffsets[bindIdx];
+            b.size = pSizes ? uint32_t(pSizes[bindIdx] == VK_WHOLE_SIZE ? mvkBuffer->getByteCount() - pOffsets[bindIdx] : pSizes[bindIdx]) : 0;
+        } else {
+            // A null vertex buffer reads zero
+            b.mtlBuffer = mvkGetNullResources().buffer;
+            b.offset = 0;
+            b.size = pSizes ? uint32_t(b.mtlBuffer.length) : 0;
+        }
 		b.stride = pStrides ? (uint32_t)pStrides[bindIdx] : 0;
         _bindings.push_back(b);
     }
