+/* Builds the Metal pipelines of a compute shader or of the VS holding a
+ * graphics pipeline. A failed build leaves them NULL, and draws and dispatches
+ * with the shader are skipped. */
+static void
+kk_shader_compile_metal(struct kk_device *dev, struct kk_shader *shader)
+{
+   VkResult result = VK_SUCCESS;
+
+   if (shader->info.stage == MESA_SHADER_COMPUTE) {
+      uint32_t local_size_threads = shader->info.cs.local_size.x *
+                                    shader->info.cs.local_size.y *
+                                    shader->info.cs.local_size.z;
+      result = kk_compile_compute_pipeline(
+         dev, &shader->msl_data[MESA_SHADER_COMPUTE], local_size_threads,
+         &shader->pipeline.cs);
+   } else if (shader->info.stage == MESA_SHADER_VERTEX) {
+      result = kk_compile_graphics_pipeline(dev, shader);
+   }
+
+   if (result != VK_SUCCESS)
+      mesa_loge("kk: Metal could not build the pipeline of a %s shader",
+                mesa_shader_stage_name(shader->info.stage));
+   if (shader->info.stage == MESA_SHADER_COMPUTE ||
+       shader->info.stage == MESA_SHADER_VERTEX)
+      p_atomic_inc(&kk_stats.built);
+   kk_stats_report();
+}
+
+void
+kk_shader_wait_compiled(struct kk_shader *shader)
+{
+   if (p_atomic_read(&shader->compiled))
+      return;
+
+   struct kk_device *dev =
+      container_of(shader->vk.base.device, struct kk_device, vk);
+
+   simple_mtx_lock(&shader->compile_lock);
+   if (!shader->compiled) {
+      kk_shader_compile_metal(dev, shader);
+      p_atomic_set(&shader->compiled, true);
+   }
+   simple_mtx_unlock(&shader->compile_lock);
+}
+
+static void
+kk_shader_compile_job(void *job, UNUSED void *gdata, UNUSED int thread_index)
+{
+   kk_shader_wait_compiled(job);
+}
+
+/* The MSL must not change anymore: kk_shader_serialize reads it while the
+ * queue compiles. */
+static void
+kk_shader_queue_compile(struct kk_device *dev, struct kk_shader *shader)
+{
+   if (shader->info.stage != MESA_SHADER_COMPUTE &&
+       shader->info.stage != MESA_SHADER_VERTEX)
+      return;
+
+   util_queue_add_job(&dev->compile_queue, shader, &shader->compile_fence,
+                      kk_shader_compile_job, NULL, 0);
+}
