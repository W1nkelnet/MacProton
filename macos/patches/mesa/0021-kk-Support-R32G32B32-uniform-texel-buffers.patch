+/* Metal has no texel buffer formats with three components: kk_CreateBufferView
+ * makes R32 texel buffers of three times the width for them, and marks their
+ * descriptors. Reads of such buffers fetch the three components one by one,
+ * and size queries divide by three. Must go after descriptor lowering. */
+static void
+lower_rgb32_texel_buffer(nir_builder *b, nir_tex_instr *tex)
+{
+   int handle_idx = nir_tex_instr_src_index(tex, nir_tex_src_texture_handle);
+   nir_intrinsic_instr *load =
+      nir_instr_as_intrinsic(nir_def_instr(tex->src[handle_idx].src.ssa));
+   if (load->intrinsic != nir_intrinsic_load_texture_handle_kk)
+      return;
+
+   b->cursor = nir_before_instr(&tex->instr);
+   nir_def *flag_addr = nir_iadd_imm(
+      b, load->src[0].ssa, offsetof(struct kk_texel_buffer_descriptor, rgb32));
+   nir_def *rgb32 = nir_ine_imm(
+      b,
+      nir_load_global_constant(b, 1, 32, flag_addr, .align_mul = 4,
+                               .access = ACCESS_CAN_SPECULATE),
+      0);
+
+   if (tex->op == nir_texop_txs) {
+      b->cursor = nir_after_instr(&tex->instr);
+      nir_def *size =
+         nir_bcsel(b, rgb32, nir_udiv_imm(b, &tex->def, 3), &tex->def);
+      nir_def_rewrite_uses_after(&tex->def, size);
+      return;
+   }
+
+   int coord_idx = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   nir_def *coord = tex->src[coord_idx].src.ssa;
+   const unsigned bit_size = tex->def.bit_size;
+
+   nir_if *nif = nir_push_if(b, rgb32);
+   nir_def *base = nir_imul_imm(b, coord, 3);
+   nir_def *comps[4];
+   for (unsigned c = 0; c < 3; c++) {
+      nir_def *texel_coord = nir_iadd_imm(b, base, c);
+      nir_tex_instr *fetch =
+         nir_instr_as_tex(nir_instr_clone(b->shader, &tex->instr));
+      nir_builder_instr_insert(b, &fetch->instr);
+      nir_src_rewrite(&fetch->src[coord_idx].src, texel_coord);
+      comps[c] = nir_channel(b, &fetch->def, 0);
+   }
+   comps[3] = nir_alu_type_get_base_type(tex->dest_type) == nir_type_float
+                 ? nir_imm_floatN_t(b, 1.0, bit_size)
+                 : nir_imm_intN_t(b, 1, bit_size);
+   nir_def *rgb = nir_vec(b, comps, tex->def.num_components);
+
+   nir_push_else(b, nif);
+   nir_instr_remove(&tex->instr);
+   nir_builder_instr_insert(b, &tex->instr);
+   nir_pop_if(b, nif);
+
+   nir_def *phi = nir_if_phi(b, rgb, &tex->def);
+
+   /* nir_def_rewrite_uses_after does not work on phis: rewrite all uses and
+    * restore the phi's own */
+   nir_def_rewrite_uses(&tex->def, phi);
+   nir_phi_instr *phi_instr = nir_instr_as_phi(nir_def_instr(phi));
+   nir_src_rewrite(
+      &nir_phi_get_src_from_block(phi_instr, tex->instr.block)->src,
+      &tex->def);
+}
+
+bool
+kk_nir_lower_rgb32_texel_buffers(nir_shader *nir)
+{
+   struct util_dynarray texs;
+   util_dynarray_init(&texs, NULL);
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *tex = nir_instr_as_tex(instr);
+            if (tex->sampler_dim == GLSL_SAMPLER_DIM_BUF &&
+                (tex->op == nir_texop_txf || tex->op == nir_texop_txs) &&
+                nir_tex_instr_src_index(tex, nir_tex_src_texture_handle) >= 0)
+               util_dynarray_append(&texs, tex);
+         }
+      }
+   }
+
+   bool progress = util_dynarray_num_elements(&texs, nir_tex_instr *) > 0;
+   util_dynarray_foreach(&texs, nir_tex_instr *, tex) {
+      nir_function_impl *impl =
+         nir_cf_node_get_function(&(*tex)->instr.block->cf_node);
+      nir_builder b = nir_builder_create(impl);
+      lower_rgb32_texel_buffer(&b, *tex);
+   }
+   util_dynarray_fini(&texs);
+
+   nir_foreach_function_impl(impl, nir)
+      nir_progress(progress, impl, nir_metadata_none);
+   return progress;
+}
