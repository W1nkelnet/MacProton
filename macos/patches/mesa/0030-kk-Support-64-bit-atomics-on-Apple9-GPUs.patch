 src/kosmickrisp/vulkan/kk_format.c          |  11 ++
 src/kosmickrisp/vulkan/kk_image.c           |   5 +
 src/kosmickrisp/vulkan/kk_image_layout.c    |   8 +-
 src/kosmickrisp/vulkan/kk_physical_device.c |  10 +-
 5 files changed, 210 insertions(+), 2 deletions(-)

diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index aa071bf..1a925b3 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -753,16 +753,38 @@ tex_type_name(nir_alu_type ty)
       return "half";
    case nir_type_float32:
       return "float";
+   /* 64-bit images, for 64-bit atomics */
+   case nir_type_int64:
+   case nir_type_uint64:
+      return "ulong";
    default:
       return "BAD";
    }
 }
 
+static bool
+is_atomic64(nir_intrinsic_instr *instr)
+{
+   switch (instr->intrinsic) {
+   case nir_intrinsic_global_atomic:
+   case nir_intrinsic_global_atomic_swap:
+   case nir_intrinsic_bindless_image_atomic:
+   case nir_intrinsic_bindless_image_atomic_swap:
+      return instr->def.bit_size == 64;
+   default:
+      return false;
+   }
+}
+
 static bool
 instrinsic_needs_dest_type(nir_intrinsic_instr *instr)
 {
    const nir_intrinsic_info *info = &nir_intrinsic_infos[instr->intrinsic];
    nir_intrinsic_op op = instr->intrinsic;
+   /* 64-bit atomics, swaps included, have their own codegen that assigns the
+    * declared value */
+   if (is_atomic64(instr))
+      return true;
    if (op == nir_intrinsic_decl_reg || op == nir_intrinsic_load_reg ||
        /* Atomic swaps have a custom codegen */
        op == nir_intrinsic_global_atomic_swap ||
@@ -1036,6 +1058,157 @@ atomic_swap_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr,
    P(ctx, "%s t%d = ta%d;\n", type, instr->def.index, instr->def.index);
 }
 
+/* The new value of a 64-bit atomic that is not atomic in Metal, from its old
+ * value o and its data v (and new value n for swaps) */
+static const char *
+atomic64_new_value(nir_atomic_op op)
+{
+   switch (op) {
+   case nir_atomic_op_iadd:
+      return "o + v";
+   case nir_atomic_op_imin:
+      return "(ulong)min((long)o, (long)v)";
+   case nir_atomic_op_umin:
+      return "min(o, v)";
+   case nir_atomic_op_imax:
+      return "(ulong)max((long)o, (long)v)";
+   case nir_atomic_op_umax:
+      return "max(o, v)";
+   case nir_atomic_op_iand:
+      return "o & v";
+   case nir_atomic_op_ior:
+      return "o | v";
+   case nir_atomic_op_ixor:
+      return "o ^ v";
+   case nir_atomic_op_xchg:
+      return "v";
+   case nir_atomic_op_cmpxchg:
+      return "o == v ? n : o";
+   default:
+      UNREACHABLE("Unhandled 64-bit atomic op");
+   }
+}
+
+/* Read-modify-write sequences standing in for 64-bit atomics run one lane of
+ * the SIMD group after the other, so that lanes of the same group do not
+ * overwrite each other. Different SIMD groups can still race. */
+static void
+atomic64_serialize_begin(struct nir_to_msl_ctx *ctx)
+{
+   P_IND(ctx, "uint rank = simd_prefix_exclusive_sum(1u);\n");
+   P_IND(ctx, "uint count = simd_sum(1u);\n");
+   P_IND(ctx, "for (uint i = 0u; i < count; i++) {\n");
+   ctx->indentlevel++;
+   P_IND(ctx, "if (i == rank) {\n");
+   ctx->indentlevel++;
+}
+
+static void
+atomic64_serialize_end(struct nir_to_msl_ctx *ctx)
+{
+   ctx->indentlevel--;
+   P_IND(ctx, "}\n");
+   P_IND(ctx, "simdgroup_barrier(mem_flags::mem_device | "
+              "mem_flags::mem_texture);\n");
+   ctx->indentlevel--;
+   P_IND(ctx, "}\n");
+}
+
+/* Metal (Apple9) only has 64-bit atomic min and max, unsigned, without
+ * returning the old value. Those are used where the shader does not need the
+ * old value, as for Nanite's visibility buffer. Add, and, or and xor on
+ * buffers are two 32-bit atomics, which leave the right value in memory but
+ * may return a torn old value. Everything else reads and writes without
+ * being atomic. */
+static void
+atomic64_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
+{
+   const nir_atomic_op op = nir_intrinsic_atomic_op(instr);
+   const bool image = instr->intrinsic == nir_intrinsic_bindless_image_atomic ||
+                      instr->intrinsic == nir_intrinsic_bindless_image_atomic_swap;
+   const bool swap = instr->intrinsic == nir_intrinsic_global_atomic_swap ||
+                     instr->intrinsic == nir_intrinsic_bindless_image_atomic_swap;
+   const bool native = (op == nir_atomic_op_umax || op == nir_atomic_op_umin) &&
+                       nir_def_is_unused(&instr->def);
+   const unsigned data = image ? 3 : 1;
+   const unsigned index = instr->def.index;
+
+   P_IND(ctx, "{\n");
+   ctx->indentlevel++;
+   P_IND(ctx, "ulong v = as_type<ulong>(");
+   src_to_msl(ctx, &instr->src[data]);
+   P(ctx, ");\n");
+   if (swap) {
+      P_IND(ctx, "ulong n = as_type<ulong>(");
+      src_to_msl(ctx, &instr->src[data + 1]);
+      P(ctx, ");\n");
+   }
+
+   if (image) {
+      if (native) {
+         P_INDENT(ctx);
+         src_to_msl(ctx, &instr->src[0]);
+         P(ctx, ".atomic_%s(", op == nir_atomic_op_umax ? "max" : "min");
+         image_coord_swizzle(ctx, instr);
+         P(ctx, ", ulong4(v));\n");
+      } else {
+         atomic64_serialize_begin(ctx);
+         P_IND(ctx, "ulong o = ");
+         src_to_msl(ctx, &instr->src[0]);
+         P(ctx, ".read(");
+         image_coord_swizzle(ctx, instr);
+         P(ctx, ").x;\n");
+         P_INDENT(ctx);
+         src_to_msl(ctx, &instr->src[0]);
+         P(ctx, ".write(ulong4(%s), ", atomic64_new_value(op));
+         image_coord_swizzle(ctx, instr);
+         P(ctx, ");\n");
+         if (!nir_def_is_unused(&instr->def))
+            P_IND(ctx, "t%u = as_type<decltype(t%u)>(o);\n", index, index);
+         atomic64_serialize_end(ctx);
+      }
+   } else {
+      P_IND(ctx, "device ulong *p = (device ulong *)");
+      src_to_msl(ctx, &instr->src[0]);
+      P(ctx, ";\n");
+      if (native) {
+         P_IND(ctx, "atomic_%s_explicit((device atomic_ulong *)p, v, "
+                    "memory_order_relaxed);\n",
+               op == nir_atomic_op_umax ? "max" : "min");
+      } else if (op == nir_atomic_op_iadd || op == nir_atomic_op_iand ||
+                 op == nir_atomic_op_ior || op == nir_atomic_op_ixor) {
+         const char *name = op == nir_atomic_op_iadd   ? "add"
+                            : op == nir_atomic_op_iand ? "and"
+                            : op == nir_atomic_op_ior  ? "or"
+                                                       : "xor";
+         P_IND(ctx, "device atomic_uint *q = (device atomic_uint *)p;\n");
+         P_IND(ctx, "uint lo = atomic_fetch_%s_explicit(&q[0], (uint)v, "
+                    "memory_order_relaxed);\n",
+               name);
+         /* The carry of the low word goes into the high word */
+         P_IND(ctx, "uint hi = atomic_fetch_%s_explicit(&q[1], "
+                    "(uint)(v >> 32)%s, memory_order_relaxed);\n",
+               name,
+               op == nir_atomic_op_iadd ? " + (lo + (uint)v < lo ? 1u : 0u)"
+                                        : "");
+         if (!nir_def_is_unused(&instr->def))
+            P_IND(ctx, "t%u = as_type<decltype(t%u)>(as_type<ulong>(uint2(lo, hi)));\n",
+                  index, index);
+      } else {
+         atomic64_serialize_begin(ctx);
+         P_IND(ctx, "ulong o = *(volatile device ulong *)p;\n");
+         P_IND(ctx, "*(volatile device ulong *)p = %s;\n",
+               atomic64_new_value(op));
+         if (!nir_def_is_unused(&instr->def))
+            P_IND(ctx, "t%u = as_type<decltype(t%u)>(o);\n", index, index);
+         atomic64_serialize_end(ctx);
+      }
+   }
+
+   ctx->indentlevel--;
+   P_IND(ctx, "}\n");
+}
+
 static void
 memory_modes_to_msl(struct nir_to_msl_ctx *ctx, nir_variable_mode modes)
 {
@@ -1164,6 +1337,11 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
        instr->intrinsic == nir_intrinsic_load_barycentric_at_offset)
       return;
 
+   if (is_atomic64(instr)) {
+      atomic64_to_msl(ctx, instr);
+      return;
+   }
+
    const nir_intrinsic_info *info = &nir_intrinsic_infos[instr->intrinsic];
    if (instrinsic_needs_dest_type(instr)) {
       P_IND(ctx, "t%d = ", instr->def.index);
