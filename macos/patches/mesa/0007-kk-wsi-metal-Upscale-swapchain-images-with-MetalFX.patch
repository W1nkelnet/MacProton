+void
+wsi_metal_layer_display_size(const CAMetalLayer *metal_layer,
+   uint32_t *width, uint32_t *height)
+{
+   @autoreleasepool {
+      /* Wine leaves contentsScale at 1 unless its Retina mode is on, so take
+       * the pixels of the screen. NSScreen comes from AppKit, which the
+       * process that made the window has loaded. */
+      CGFloat scale = metal_layer.contentsScale;
+      Class screen_class = NSClassFromString(@"NSScreen");
+      id screen = [screen_class performSelector:@selector(mainScreen)];
+      if (screen) {
+         CGFloat (*get_scale)(id, SEL) = (void *)objc_msgSend;
+         scale = MAX(scale, get_scale(screen, @selector(backingScaleFactor)));
+      }
+
+      CGSize size = metal_layer.bounds.size;
+      *width = size.width * scale;
+      *height = size.height * scale;
+   }
+}
