 static PFN_vkVoidFunction
 kk_instance_get_proc_addr_unchecked(const struct vk_instance *instance,
                                     const char *name)
@@ -68,17 +71,51 @@ kk_bind_drawable_to_vkimage(VkImage vk_image, void *drawable)
