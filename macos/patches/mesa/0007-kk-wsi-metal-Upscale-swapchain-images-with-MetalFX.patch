+/* MetalFX spatial upscaling of a swapchain image into a drawable */
+struct mtl_upscaler;
+
+struct mtl_upscaler *mtl_new_upscaler(void);
+void mtl_destroy_upscaler(struct mtl_upscaler *upscaler);
+
+/* Scales src up into dst in cmd_buf, with alpha forced to one when opaque.
+ * Returns false if MetalFX cannot, then nothing was encoded. */
+bool mtl_upscale(struct mtl_upscaler *upscaler, mtl_device *device,
+                 mtl_compiler *compiler, mtl_command_buffer *cmd_buf,
