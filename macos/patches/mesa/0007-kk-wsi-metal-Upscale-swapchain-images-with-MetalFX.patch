diff --git a/src/kosmickrisp/bridge/mtl_upscale.m b/src/kosmickrisp/bridge/mtl_upscale.m
new file mode 100644
index 0000000..fcb7349
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_upscale.m
@@ -0,0 +1,170 @@
+/*
+ * Copyright 2026 MacProton contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "mtl_upscale.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+
+struct mtl_upscaler {
+   id<MTL4FXSpatialScaler> scaler;
+   /* MetalFX writes to a private texture, which is then copied to the
+    * drawable */
+   id<MTLTexture> output;
+   id<MTLResidencySet> residency;
+};
+
+struct mtl_upscaler *
+mtl_new_upscaler(void)
+{
+   return calloc(1, sizeof(struct mtl_upscaler));
+}
+
+static void
+release_scaler(struct mtl_upscaler *upscaler)
+{
+   [upscaler->scaler release];
+   [upscaler->output release];
+   [upscaler->residency release];
+   upscaler->scaler = nil;
+   upscaler->output = nil;
+   upscaler->residency = nil;
+}
+
+void
+mtl_destroy_upscaler(struct mtl_upscaler *upscaler)
+{
+   if (!upscaler)
+      return;
+
+   @autoreleasepool {
+      release_scaler(upscaler);
+   }
+   free(upscaler);
+}
+
+static bool
+is_srgb(MTLPixelFormat format)
+{
+   return format == MTLPixelFormatBGRA8Unorm_sRGB ||
+          format == MTLPixelFormatRGBA8Unorm_sRGB;
+}
+
+static bool
+create_scaler(struct mtl_upscaler *upscaler, id<MTLDevice> dev,
+              id<MTL4Compiler> compiler, id<MTLTexture> in, id<MTLTexture> out)
+{
+   release_scaler(upscaler);
+
+   MTLFXSpatialScalerDescriptor *desc =
+      [[MTLFXSpatialScalerDescriptor new] autorelease];
+   desc.inputWidth = in.width;
+   desc.inputHeight = in.height;
+   desc.outputWidth = out.width;
+   desc.outputHeight = out.height;
+   desc.colorTextureFormat = in.pixelFormat;
+   desc.outputTextureFormat = out.pixelFormat;
+   /* Unorm images hold gamma-encoded colors already */
+   /* sRGB formats read as linear values, and float formats may exceed 1 */
+   if (is_srgb(in.pixelFormat))
+      desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModeLinear;
+   else if (in.pixelFormat == MTLPixelFormatRGBA16Float)
+      desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModeHDR;
+   else
+      desc.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+
+   upscaler->scaler = [desc newSpatialScalerWithDevice:dev compiler:compiler];
+   if (!upscaler->scaler)
+      return false;
+
+   MTLTextureDescriptor *tex_desc =
+      [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:out.pixelFormat
+                                                         width:out.width
+                                                        height:out.height
+                                                     mipmapped:NO];
+   tex_desc.storageMode = MTLStorageModePrivate;
+   tex_desc.usage = upscaler->scaler.outputTextureUsage | MTLTextureUsageShaderRead;
+   upscaler->output = [dev newTextureWithDescriptor:tex_desc];
+
+   MTLResidencySetDescriptor *res_desc = [[MTLResidencySetDescriptor new] autorelease];
+   upscaler->residency = [dev newResidencySetWithDescriptor:res_desc error:nil];
+   if (!upscaler->output || !upscaler->residency) {
+      release_scaler(upscaler);
+      return false;
+   }
+
+   [upscaler->residency addAllocation:upscaler->output];
+   [upscaler->residency commit];
+   fprintf(stderr, "MESA-KOSMICKRISP: MetalFX scales %lux%lu to %lux%lu\n",
+           (unsigned long)in.width, (unsigned long)in.height,
+           (unsigned long)out.width, (unsigned long)out.height);
+   return true;
+}
+
+bool
+mtl_upscale(struct mtl_upscaler *upscaler, mtl_device *device,
+            mtl_compiler *compiler, mtl_command_buffer *cmd_buf,
+            mtl_texture *src, mtl_texture *dst, bool opaque)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      id<MTLTexture> in = (id<MTLTexture>)src;
+      id<MTLTexture> out = (id<MTLTexture>)dst;
+      id<MTL4CommandBuffer> cb = (id<MTL4CommandBuffer>)cmd_buf;
+
+      if (![MTLFXSpatialScalerDescriptor supportsDevice:dev])
+         return false;
+
+      id<MTL4FXSpatialScaler> scaler = upscaler->scaler;
+      if (!scaler || scaler.inputWidth != in.width ||
+          scaler.inputHeight != in.height || scaler.outputWidth != out.width ||
+          scaler.outputHeight != out.height ||
+          scaler.colorTextureFormat != in.pixelFormat ||
+          scaler.outputTextureFormat != out.pixelFormat) {
+         if (!create_scaler(upscaler, dev, (id<MTL4Compiler>)compiler, in, out))
+            return false;
+         scaler = upscaler->scaler;
+      }
+
+      /* The layer is not opaque, so the window would show what alpha the
+       * game left in its image */
+      id<MTLTexture> color = in;
+      if (opaque) {
+         MTLTextureSwizzleChannels swizzle = MTLTextureSwizzleChannelsMake(
+            MTLTextureSwizzleRed, MTLTextureSwizzleGreen, MTLTextureSwizzleBlue,
+            MTLTextureSwizzleOne);
+         color = [[in newTextureViewWithPixelFormat:in.pixelFormat
+                                        textureType:MTLTextureType2D
+                                             levels:NSMakeRange(0, 1)
+                                             slices:NSMakeRange(0, 1)
+                                            swizzle:swizzle] autorelease];
+         if (!color)
+            return false;
+      }
+
+      scaler.colorTexture = color;
+      scaler.outputTexture = upscaler->output;
+      scaler.inputContentWidth = in.width;
+      scaler.inputContentHeight = in.height;
+
+      [cb useResidencySet:upscaler->residency];
+      [scaler encodeToCommandBuffer:cb];
+
+      id<MTL4ComputeCommandEncoder> enc = [cb computeCommandEncoder];
+      [enc barrierAfterQueueStages:MTLStageAll
+                      beforeStages:MTLStageAll
+                 visibilityOptions:MTL4VisibilityOptionDevice];
+      [enc copyFromTexture:upscaler->output toTexture:out];
+      [enc barrierAfterStages:MTLStageAll
+            beforeQueueStages:MTLStageAll
+            visibilityOptions:MTL4VisibilityOptionDevice];
+      [enc endEncoding];
+   }
+
+   return true;
+}
