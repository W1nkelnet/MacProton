 }
 
+/* Scales the swapchain image up to the drawable with MetalFX */
+static bool
+kk_wsi_upscale(struct kk_cmd_buffer *cmd, struct kk_image *src,
+               struct kk_image *dst, bool opaque_alpha)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   /* MetalFX encodes its own passes: make them wait for the game's */
+   cmd->pending_barrier = true;
+   cs_get_compute(cmd);
+   cs_end(cmd);
+
+   simple_mtx_lock(&dev->upscaler_lock);
+   if (dev->upscaler == NULL)
+      dev->upscaler = mtl_new_upscaler();
+   bool done = dev->upscaler &&
+               mtl_upscale(dev->upscaler, dev->mtl_handle,
+                           dev->mtl_compiler_handle, cmd->metal.cmd_buf,
+                           src->planes[0].mtl_handle, dst->planes[0].mtl_handle,
+                           opaque_alpha);
+   simple_mtx_unlock(&dev->upscaler_lock);
+   return done;
+}
+
 static void
 kk_wsi_cmd_blit_image(VkCommandBuffer vk_cmd, const VkBlitImageInfo2 *blit_info,
                       bool opaque_alpha)
 {
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, vk_cmd);
    VK_FROM_HANDLE(kk_image, src, blit_info->srcImage);
+   VK_FROM_HANDLE(kk_image, dst, blit_info->dstImage);
 
    /* The blit samples the source through a view the meta path creates for
     * itself, and that view is where the alpha gets dropped. The value is a
     * property of the swapchain, so it never changes for a given image. */
    src->wsi_opaque_alpha = opaque_alpha;
 
+   /* The drawables are larger with MESA_WSI_METAL_UPSCALING */
+   const char *upscaling = getenv("MESA_WSI_METAL_UPSCALING");
+   bool scaled = src->vk.extent.width != dst->vk.extent.width ||
+                 src->vk.extent.height != dst->vk.extent.height;
+   if (scaled && upscaling && !strcmp(upscaling, "metalfx") &&
+       kk_wsi_upscale(cmd, src, dst, opaque_alpha))
+      return;
+
    kk_CmdBlitImage2(vk_cmd, blit_info);
 }
 
