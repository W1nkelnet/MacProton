index 0000000..67cd530
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_bounded_loads.c
@@ -0,0 +1,86 @@
+/*
+ * Copyright 2026 MacProton contributors
+ * SPDX-License-Identifier: MIT
+ */
+#include "kk_cmd_buffer.h"
+#include "kk_shader.h"
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+
+/* A robust uniform buffer load becomes off < size ? *(base + off) : 0 in MSL,
+ * which puts the load in a branch of its own, and Metal keeps the branches:
+ * Horizon Zero Dawn's full-screen lighting pass reads 400 constants this way
+ * and took 16 ms per frame on an M3 instead of 2.
+ *
+ * Load unconditionally instead, from the device's zero buffer when the offset
+ * is out of bounds, and select the result. The values are the same, there is
+ * no branch, and a null or unwritten descriptor (base 0, size 0) reads the
+ * zero buffer rather than address 0.
+ */
+
+static nir_def *
+load_zero_buffer(nir_builder *b)
+{
+   nir_def *root = nir_load_buffer_ptr_kk(b, 1, 64, .binding = 0);
+   return nir_load_global_constant(
+      b, 1, 64,
+      nir_iadd_imm(b, root,
+                   offsetof(struct kk_root_descriptor_table, zero_buffer)),
+      .align_mul = 8, .access = ACCESS_CAN_SPECULATE);
+}
+
+static bool
+lower_bounded_load(nir_builder *b, nir_intrinsic_instr *load, nir_def **zero)
+{
+   if (load->intrinsic != nir_intrinsic_load_global_constant_bounded)
+      return false;
+
+   if (*zero == NULL) {
+      b->cursor = nir_before_impl(b->impl);
+      *zero = load_zero_buffer(b);
+   }
+
+   b->cursor = nir_before_instr(&load->instr);
+   nir_def *offset = load->src[1].ssa;
+   nir_def *in_bounds = nir_ult(b, offset, load->src[2].ssa);
+   nir_def *addr = nir_bcsel(
+      b, in_bounds, nir_iadd(b, load->src[0].ssa, nir_u2u64(b, offset)),
+      *zero);
+
+   nir_def *value = nir_load_global_constant(
+      b, load->def.num_components, load->def.bit_size, addr,
+      .align_mul = nir_intrinsic_align_mul(load),
+      .align_offset = nir_intrinsic_align_offset(load),
+      .access = nir_intrinsic_access(load) | ACCESS_CAN_SPECULATE);
+
+   nir_def_replace(&load->def,
+                   nir_bcsel(b, in_bounds, value,
+                             nir_imm_zero(b, load->def.num_components,
+                                          load->def.bit_size)));
+   return true;
+}
+
+bool
+kk_nir_lower_bounded_loads(nir_shader *nir)
+{
+   bool progress = false;
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_builder b = nir_builder_create(impl);
+      nir_def *zero = NULL;
+      bool impl_progress = false;
+
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic)
+               impl_progress |= lower_bounded_load(
+                  &b, nir_instr_as_intrinsic(instr), &zero);
+         }
+      }
+
+      progress |= nir_progress(impl_progress, impl, nir_metadata_control_flow);
+   }
+
+   return progress;
+}
