+/*
+ * Copyright 2026 MacProton contributors
+ * SPDX-License-Identifier: MIT
+ */
+#include "kk_null_textures.h"
+
+#include "kk_bo.h"
+#include "kk_device.h"
+#include "kk_image_layout.h"
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+#include "kosmickrisp/bridge/mtl_format.h"
+
+#include "util/u_math.h"
+
+static const enum mtl_texture_type null_texture_types[] = {
+   [KK_NULL_TEXTURE_1D] = MTL_TEXTURE_TYPE_1D,
+   [KK_NULL_TEXTURE_1D_ARRAY] = MTL_TEXTURE_TYPE_1D_ARRAY,
+   [KK_NULL_TEXTURE_2D] = MTL_TEXTURE_TYPE_2D,
+   [KK_NULL_TEXTURE_2D_ARRAY] = MTL_TEXTURE_TYPE_2D_ARRAY,
+   [KK_NULL_TEXTURE_3D] = MTL_TEXTURE_TYPE_3D,
+   [KK_NULL_TEXTURE_CUBE] = MTL_TEXTURE_TYPE_CUBE,
+   [KK_NULL_TEXTURE_CUBE_ARRAY] = MTL_TEXTURE_TYPE_CUBE_ARRAY,
+   [KK_NULL_TEXTURE_BUFFER] = MTL_TEXTURE_TYPE_TEXTURE_BUFFER,
+};
+
+/* In the order of kk_null_texture_index: float, int, uint */
+static const struct {
+   enum pipe_format pipe;
+   enum mtl_pixel_format mtl;
+} null_texture_formats[] = {
+   {PIPE_FORMAT_R8G8B8A8_UNORM, MTL_PIXEL_FORMAT_R8G8B8A8_UNORM},
+   {PIPE_FORMAT_R32G32B32A32_SINT, MTL_PIXEL_FORMAT_R32G32B32A32_SINT},
+   {PIPE_FORMAT_R32G32B32A32_UINT, MTL_PIXEL_FORMAT_R32G32B32A32_UINT},
+};
+
+static struct kk_image_layout
+null_texture_layout(unsigned index)
+{
+   const unsigned dim = index / 3, format = index % 3;
+   /* Read and write, since storage images are declared read_write when a
+    * shader also writes them; writes through null descriptors still branch */
+   return (struct kk_image_layout){
+      .width_px = 1u,
+      .height_px = 1u,
+      .depth_px = 1u,
+      .layers = 1u,
+      .type = null_texture_types[dim],
+      .sample_count_sa = 1u,
+      .levels = 1u,
+      .linear = dim == KK_NULL_TEXTURE_BUFFER,
+      .optimized_layout = false,
+      .usage = MTL_TEXTURE_USAGE_SHADER_READ | MTL_TEXTURE_USAGE_SHADER_WRITE,
+      .format = {.pipe = null_texture_formats[format].pipe,
+                 .mtl = null_texture_formats[format].mtl},
+      .linear_stride_B = 16u,
+   };
+}
+
+VkResult
+kk_null_textures_init(struct kk_device *dev,
+                      struct kk_null_textures *null_textures)
+{
+   /* The resource IDs, then the textures, all in zeroed memory: Metal
+    * textures placed in a heap without GPU-optimized contents read their
+    * texels from it as they are */
+   uint64_t offsets[KK_NULL_TEXTURE_COUNT];
+   uint64_t size_B = KK_NULL_TEXTURE_COUNT * sizeof(uint64_t);
+   for (unsigned i = 0; i < KK_NULL_TEXTURE_COUNT; i++) {
+      struct kk_image_layout layout = null_texture_layout(i);
+      uint64_t tex_size_B, align_B;
+      if (layout.type == MTL_TEXTURE_TYPE_TEXTURE_BUFFER) {
+         tex_size_B = 16u;
+         align_B = mtl_minimum_linear_texture_alignment_for_pixel_format(
+            dev->mtl_handle, layout.format.mtl);
+      } else {
+         mtl_heap_texture_size_and_align_with_descriptor(
+            dev->mtl_handle, &layout, &tex_size_B, &align_B);
+      }
+      offsets[i] = align64(size_B, align_B);
+      size_B = offsets[i] + tex_size_B;
+   }
+
+   VkResult result = kk_alloc_bo(dev, &dev->vk.base, size_B, 0u,
+                                 &null_textures->bo);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct kk_bo *bo = null_textures->bo;
+   memset(bo->cpu, 0, bo->size_B);
+   uint64_t *ids = bo->cpu;
+   for (unsigned i = 0; i < KK_NULL_TEXTURE_COUNT; i++) {
+      struct kk_image_layout layout = null_texture_layout(i);
+      mtl_texture *texture =
+         layout.type == MTL_TEXTURE_TYPE_TEXTURE_BUFFER
+            ? mtl_new_texture_with_descriptor_linear(bo->map, &layout,
+                                                     offsets[i])
+            : mtl_new_texture_with_descriptor(bo->mtl_handle, &layout,
+                                              offsets[i]);
+      if (!texture) {
+         kk_null_textures_finish(dev, null_textures);
+         return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      }
+      null_textures->textures[i] = texture;
+      ids[i] = mtl_texture_get_gpu_resource_id(texture);
+   }
+
+   return VK_SUCCESS;
+}
+
+void
+kk_null_textures_finish(struct kk_device *dev,
+                        struct kk_null_textures *null_textures)
+{
+   for (unsigned i = 0; i < KK_NULL_TEXTURE_COUNT; i++) {
+      if (null_textures->textures[i])
+         mtl_release(null_textures->textures[i]);
+      null_textures->textures[i] = NULL;
+   }
+   if (null_textures->bo)
+      kk_destroy_bo(dev, null_textures->bo);
+   null_textures->bo = NULL;
+}
diff --git a/src/kosmickrisp/vulkan/kk_null_textures.h b/src/kosmickrisp/vulkan/kk_null_textures.h
new file mode 100644
index 0000000..85aa825
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_null_textures.h
@@ -0,0 +1,89 @@
+/*
+ * Copyright 2026 MacProton contributors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef KK_NULL_TEXTURES_H
+#define KK_NULL_TEXTURES_H 1
+
+#include "kosmickrisp/bridge/mtl_types.h"
+
+#include "compiler/nir/nir.h"
+
+#include "vulkan/vulkan_core.h"
+
+struct kk_bo;
+struct kk_device;
+
+/* Zeroed 1x1 textures, one per texture type and sample type. Reads through a
+ * null descriptor read one of these instead, see kk_nir_lower_null_images.
+ * Their resource IDs come first in the buffer object, in the order of
+ * kk_null_texture_index; the root descriptor table holds its address. */
+enum kk_null_texture_dim {
+   KK_NULL_TEXTURE_1D,
+   KK_NULL_TEXTURE_1D_ARRAY,
+   KK_NULL_TEXTURE_2D,
+   KK_NULL_TEXTURE_2D_ARRAY,
+   KK_NULL_TEXTURE_3D,
+   KK_NULL_TEXTURE_CUBE,
+   KK_NULL_TEXTURE_CUBE_ARRAY,
+   KK_NULL_TEXTURE_BUFFER,
+   KK_NULL_TEXTURE_DIM_COUNT,
+};
+
+#define KK_NULL_TEXTURE_COUNT (KK_NULL_TEXTURE_DIM_COUNT * 3)
+
+struct kk_null_textures {
+   struct kk_bo *bo;
+   mtl_texture *textures[KK_NULL_TEXTURE_COUNT];
+};
+
+/* Returns -1 for textures without a null texture: multisampled ones and
+ * sample types other than 32-bit float, int and uint, and 16-bit float */
+static inline int
+kk_null_texture_index(enum glsl_sampler_dim dim, bool array,
+                      nir_alu_type type)
+{
+   int d;
+   switch (dim) {
+   case GLSL_SAMPLER_DIM_1D:
+      d = array ? KK_NULL_TEXTURE_1D_ARRAY : KK_NULL_TEXTURE_1D;
+      break;
+   case GLSL_SAMPLER_DIM_2D:
+      d = array ? KK_NULL_TEXTURE_2D_ARRAY : KK_NULL_TEXTURE_2D;
+      break;
+   case GLSL_SAMPLER_DIM_3D:
+      if (array)
+         return -1;
+      d = KK_NULL_TEXTURE_3D;
+      break;
+   case GLSL_SAMPLER_DIM_CUBE:
+      d = array ? KK_NULL_TEXTURE_CUBE_ARRAY : KK_NULL_TEXTURE_CUBE;
+      break;
+   case GLSL_SAMPLER_DIM_BUF:
+      if (array)
+         return -1;
+      d = KK_NULL_TEXTURE_BUFFER;
+      break;
+   default:
+      return -1;
+   }
+
+   switch (type) {
+   case nir_type_float32:
+   case nir_type_float16:
+      return d * 3;
+   case nir_type_int32:
+      return d * 3 + 1;
+   case nir_type_uint32:
+      return d * 3 + 2;
+   default:
+      return -1;
+   }
+}
+
+VkResult kk_null_textures_init(struct kk_device *dev,
+                               struct kk_null_textures *null_textures);
+void kk_null_textures_finish(struct kk_device *dev,
+                             struct kk_null_textures *null_textures);
+
+#endif /* KK_NULL_TEXTURES_H */
