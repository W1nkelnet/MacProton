From f7adb2eb1c715ad75eeb44d622da4cf60597c5b3 Mon Sep 17 00:00:00 2001
From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Fri, 30 Oct 2026 19:59:28 +0100
Subject: [PATCH] kk: Fail buffer views of formats without texel buffer support

kk_CreateBufferView dereferenced the format table entry without checking
it. vkd3d-proton creates R32G32B32_SFLOAT buffer views in Rise of the Tomb
Raider without looking at the format features, and Metal has no texel
buffer format for it, so the game crashed in its benchmark. Return
VK_ERROR_FORMAT_NOT_SUPPORTED and warn instead.

Generated-by: LLM
---
 src/kosmickrisp/vulkan/kk_buffer_view.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/kosmickrisp/vulkan/kk_buffer_view.c b/src/kosmickrisp/vulkan/kk_buffer_view.c
index 3a0aa03..087bcc5 100644
--- a/src/kosmickrisp/vulkan/kk_buffer_view.c
+++ b/src/kosmickrisp/vulkan/kk_buffer_view.c
@@ -18,8 +18,11 @@
 #include "kosmickrisp/bridge/mtl_bridge.h"
 #include "kosmickrisp/bridge/mtl_format.h"
 
+#include "vk_enum_to_str.h"
 #include "vk_format.h"
 
+#include "util/log.h"
+
 VkFormatFeatureFlags2
 kk_get_buffer_format_features(struct kk_physical_device *pdev,
                               VkFormat vk_format)
@@ -65,6 +68,15 @@ kk_CreateBufferView(VkDevice _device, const VkBufferViewCreateInfo *pCreateInfo,
 
    enum pipe_format p_format = vk_format_to_pipe_format(view->vk.format);
    const struct kk_va_format *supported_format = kk_get_va_format(p_format);
+   if (!supported_format) {
+      /* Applications should check the format features first; vkd3d-proton
+       * creates R32G32B32_SFLOAT views in Rise of the Tomb Raider, which
+       * Metal has no texel buffer format for */
+      mesa_logw("kk: no texel buffer format for %s",
+                vk_Format_to_str(view->vk.format));
+      vk_buffer_view_destroy(&dev->vk, pAllocator, &view->vk);
+      return vk_error(dev, VK_ERROR_FORMAT_NOT_SUPPORTED);
+   }
 
    /* If we reached here, we support reading at least */
    enum mtl_texture_usage usage = MTL_TEXTURE_USAGE_SHADER_READ;
-- 
