--- a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
@@ -548,8 +548,13 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
    }
 
    {
+      /* See kk_sampled_image_descriptor::image_array_gpu_resource_id */
       unsigned offs =
