 src/kosmickrisp/vulkan/kk_descriptor_types.h  |  8 ++++-
 src/kosmickrisp/vulkan/kk_image_view.c        | 34 +++++++++++++++++++
 src/kosmickrisp/vulkan/kk_image_view.h        |  5 +++
 .../vulkan/kk_nir_lower_descriptors.c         |  7 +++-
 5 files changed, 56 insertions(+), 2 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_descriptor_set.c b/src/kosmickrisp/vulkan/kk_descriptor_set.c
index cd05f54..6429afb 100644
--- a/src/kosmickrisp/vulkan/kk_descriptor_set.c
+++ b/src/kosmickrisp/vulkan/kk_descriptor_set.c
@@ -71,10 +71,14 @@ get_sampled_image_view_desc(VkDescriptorType descriptor_type,
             assert(view->planes[plane].input_gpu_resource_id);
             desc[plane].image_gpu_resource_id =
                view->planes[plane].input_gpu_resource_id;
+            desc[plane].image_array_gpu_resource_id =
+               view->planes[plane].input_gpu_resource_id;
          } else {
             assert(view->planes[plane].sampled_gpu_resource_id);
             desc[plane].image_gpu_resource_id =
                view->planes[plane].sampled_gpu_resource_id;
+            desc[plane].image_array_gpu_resource_id =
+               view->planes[plane].sampled_array_gpu_resource_id;
          }
 
          float min_lod = MAX2(view->vk.min_lod - view->vk.base_mip_level, 0.0);
diff --git a/src/kosmickrisp/vulkan/kk_descriptor_types.h b/src/kosmickrisp/vulkan/kk_descriptor_types.h
index 7516899..67da9ca 100644
--- a/src/kosmickrisp/vulkan/kk_descriptor_types.h
+++ b/src/kosmickrisp/vulkan/kk_descriptor_types.h
@@ -28,7 +28,13 @@ struct kk_sampled_image_descriptor {
 
    uint16_t pad_to_64_bits;
    uint32_t border[4];
-   uint64_t pad_to_power_2[3];
+
+   /* image_gpu_resource_id as a 2D array texture for 2D and 2D array views,
+    * which Metal needs for texture2d_array declarations. image_gpu_resource_id
+    * then holds a 2D texture of the first layer, for texture2d declarations.
+    */
+   uint64_t image_array_gpu_resource_id;
+   uint64_t pad_to_power_2[2];
 };
 
 static_assert(sizeof(struct kk_sampled_image_descriptor) == 64,
diff --git a/src/kosmickrisp/vulkan/kk_image_view.c b/src/kosmickrisp/vulkan/kk_image_view.c
index 8b02902..b7c08d7 100644
--- a/src/kosmickrisp/vulkan/kk_image_view.c
+++ b/src/kosmickrisp/vulkan/kk_image_view.c
@@ -190,6 +190,37 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
          view->planes[view_plane].sampled_gpu_resource_id =
             mtl_texture_get_gpu_resource_id(
                view->planes[view_plane].mtl_handle_sampled);
+         view->planes[view_plane].sampled_array_gpu_resource_id =
+            view->planes[view_plane].sampled_gpu_resource_id;
+
+         /* D3D12 applications bind 2D array views to Texture2D declarations
+          * and the other way round, e.g. Unreal Engine 5's TSR output, which
+          * its bloom and tonemapping read as a 2D texture. Other APIs read
+          * such a view as its first layer, Metal reads garbage from a texture
+          * whose type differs from the declaration. Keep a view of the other
+          * type for the shader to pick by its declaration.
+          */
+         if (view_layout.sample_count_sa <= 1 &&
+             (view_layout.view_type == VK_IMAGE_VIEW_TYPE_2D ||
+              view_layout.view_type == VK_IMAGE_VIEW_TYPE_2D_ARRAY)) {
+            struct kk_view_layout other_layout = view_layout;
+            bool is_array = view_layout.view_type == VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+            other_layout.view_type =
+               is_array ? VK_IMAGE_VIEW_TYPE_2D : VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+            if (is_array)
+               other_layout.array_len = 1u;
+            mtl_texture *other = mtl_new_texture_view_with(mtl_handle, &other_layout);
+            view->planes[view_plane].mtl_handle_sampled_2d_other = other;
+            if (is_array) {
+               view->planes[view_plane].sampled_array_gpu_resource_id =
+                  view->planes[view_plane].sampled_gpu_resource_id;
+               view->planes[view_plane].sampled_gpu_resource_id =
+                  mtl_texture_get_gpu_resource_id(other);
+            } else {
+               view->planes[view_plane].sampled_array_gpu_resource_id =
+                  mtl_texture_get_gpu_resource_id(other);
+            }
+         }
       }
 
       if (view->vk.usage & VK_IMAGE_USAGE_STORAGE_BIT) {
@@ -259,6 +290,9 @@ kk_image_view_finish(struct kk_device *dev, struct kk_image_view *view)
       if (view->planes[plane].mtl_handle_sampled)
          mtl_release(view->planes[plane].mtl_handle_sampled);
 
+      if (view->planes[plane].mtl_handle_sampled_2d_other)
+         mtl_release(view->planes[plane].mtl_handle_sampled_2d_other);
+
       if (view->planes[plane].mtl_handle_storage)
          mtl_release(view->planes[plane].mtl_handle_storage);
 
diff --git a/src/kosmickrisp/vulkan/kk_image_view.h b/src/kosmickrisp/vulkan/kk_image_view.h
