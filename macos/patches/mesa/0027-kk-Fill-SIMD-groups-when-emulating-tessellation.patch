-         info->vs.tess_local_thread_size = s->info.tess.tcs_output_patch_size;
+         info->vs.tess_local_thread_size =
+            s->info.tess.tcs_output_patch_size *
+            kk_tcs_patches_per_group(s->info.tess.tcs_output_patch_size);
 
