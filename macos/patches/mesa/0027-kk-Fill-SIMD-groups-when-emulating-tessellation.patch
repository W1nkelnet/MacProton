diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index 896abb9..bf6c45c 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -40,6 +40,45 @@
 #include "util/u_atomic.h"
 #include "util/u_debug.h"
 
+/* poly runs a TCS with one threadgroup per patch, the patch from the
+ * workgroup ID and the invocation from the local invocation ID. Runs it with
+ * per_group patches per threadgroup instead. A patch's invocations stay in
+ * one SIMD group, which poly's subgroup barriers need. */
+static bool
+kk_nir_pack_tcs_patches(nir_shader *nir, unsigned vertices, unsigned per_group)
+{
+   if (per_group == 1)
+      return false;
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *wg = nir_load_workgroup_id(&b);
+   nir_def *lid = nir_load_local_invocation_id(&b);
+   nir_def *lid_x = nir_channel(&b, lid, 0);
+   nir_def *patch = nir_iadd(&b, nir_imul_imm(&b, nir_channel(&b, wg, 0), per_group),
+                             nir_udiv_imm(&b, lid_x, vertices));
+   nir_def *packed_wg = nir_vector_insert_imm(&b, wg, patch, 0);
+   nir_def *packed_lid =
+      nir_vector_insert_imm(&b, lid, nir_umod_imm(&b, lid_x, vertices), 0);
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic == nir_intrinsic_load_workgroup_id &&
+             &intr->def != wg) {
+            nir_def_replace(&intr->def, packed_wg);
+         } else if (intr->intrinsic == nir_intrinsic_load_local_invocation_id &&
+                    &intr->def != lid) {
+            nir_def_replace(&intr->def, packed_lid);
+         }
+      }
+   }
+
+   return nir_progress(true, impl, nir_metadata_control_flow);
+}
+
 /* MESA_KK_COMPILE_STATS=1 logs where pipeline creation spends its time every
  * two seconds: translating to MSL, compiling MSL to Metal libraries, and
  * making Metal pipelines from them, summed over all threads. */
