From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Thu, 29 Oct 2026 23:28:26 +0100
Subject: [PATCH] kk: Support transform feedback queries

poly's pre-GS program counts the primitives each stream writes and
needs; point those counters at the reports of the active query of the
stream.

DXVK creates pipeline statistics pools without checking the feature,
which hit an unreachable. Let them report zeroes.

Generated-by: LLM
---
 src/kosmickrisp/vulkan/kk_cmd_buffer.h      |  2 +
 src/kosmickrisp/vulkan/kk_cmd_draw.c        |  9 +++
 src/kosmickrisp/vulkan/kk_physical_device.c |  2 +-
 src/kosmickrisp/vulkan/kk_private.h         |  1 +
 src/kosmickrisp/vulkan/kk_query_pool.c      | 63 +++++++++++++++++----
 5 files changed, 64 insertions(+), 13 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.h b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
index 9c09168..7c26b03 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.h
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
@@ -200,6 +200,8 @@ struct kk_graphics_state {
       /* Address of the byte offsets the buffers are written at, 0 while
        * transform feedback is not active */
       uint64_t offsets;
+      /* Reports of the active query of each stream */
+      uint64_t queries[KK_MAX_XFB_STREAMS];
    } xfb;
 
    /* Needed by vk_command_buffer::dynamic_graphics_state */
diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 910a2ac..3570b5e 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1354,6 +1354,15 @@ kk_upload_geometry_params(struct kk_cmd_buffer *cmd,
    }
    params.xfb_any_overflow = sink;
 
+   /* A query reports the primitives written and the primitives needed */
+   for (uint32_t i = 0u; i < POLY_MAX_VERTEX_STREAMS; ++i) {
+      uint64_t query = gfx->xfb.queries[i];
+      if (query) {
+         params.xfb_prims_generated_counter[i] = query;
+         params.prims_generated_counter[i] = query + sizeof(uint64_t);
+      }
+   }
+
    if (kk_gs_xfb(cmd)) {
       for (uint32_t i = 0u; i < KK_MAX_XFB_BUFFERS; ++i) {
          params.xfb_base_original[i] = gfx->xfb.buffers[i].addr;
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 90289b4..f077180 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
