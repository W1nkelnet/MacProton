 #define KK_MAX_VIEWPORTS                 16
 #define KK_MAX_XFB_BUFFERS               4
+#define KK_MAX_XFB_STREAMS               4
 #define KK_MAX_DESCRIPTOR_SIZE           64
 #define KK_MAX_PUSH_DESCRIPTORS          32
 #define KK_MAX_DESCRIPTOR_SET_SIZE       (1u << 30)
diff --git a/src/kosmickrisp/vulkan/kk_query_pool.c b/src/kosmickrisp/vulkan/kk_query_pool.c
index 7cfe7be..d1eb48f 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.c
+++ b/src/kosmickrisp/vulkan/kk_query_pool.c
@@ -38,6 +38,13 @@ kk_reports_per_query(struct kk_query_pool *pool)
    case VK_QUERY_TYPE_OCCLUSION:
    case VK_QUERY_TYPE_TIMESTAMP:
       return 1;
+   case VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT:
+      /* Primitives written, primitives needed */
+      return 2;
+   case VK_QUERY_TYPE_PIPELINE_STATISTICS:
+      /* Not supported, but DXVK creates such pools without checking: they
+       * report zeroes */
+      return util_bitcount(pool->vk.pipeline_statistics);
    default:
       UNREACHABLE("Unsupported query type");
    }
@@ -76,8 +83,8 @@ kk_query_report_addr(struct kk_device *dev, struct kk_query_pool *pool,
    struct kk_bo *bo =
       kk_pool_is_oq(pool) ? dev->occlusion_queries.bo : pool->bo;
 
-   uint32_t index =
-      kk_pool_is_ts(pool) ? query : kk_pool_index_ptr(pool)[query];
+   uint32_t index = kk_pool_is_oq(pool) ? kk_pool_index_ptr(pool)[query]
+                                         : query * kk_reports_per_query(pool);
    return bo->gpu + pool->query_start + (index * sizeof(uint64_t));
 }
 
@@ -96,8 +103,8 @@ kk_query_report_map(struct kk_device *dev, struct kk_query_pool *pool,
       kk_pool_is_oq(pool) ? dev->occlusion_queries.bo : pool->bo;
 
    uint64_t *queries = (uint64_t *)(bo->cpu + pool->query_start);
-   uint32_t index =
-      kk_pool_is_ts(pool) ? query : kk_pool_index_ptr(pool)[query];
+   uint32_t index = kk_pool_is_oq(pool) ? kk_pool_index_ptr(pool)[query]
+                                         : query * kk_reports_per_query(pool);
 
    return (struct kk_query_report *)&queries[index];
 }
@@ -272,7 +279,7 @@ emit_zero_queries(struct kk_cmd_buffer *cmd, struct kk_query_pool *pool,
    struct libkk_reset_query_args info = {
       .availability = kk_pool_is_ts(pool) ? 0u : pool->bo->gpu,
       .results = results_bo->gpu + pool->query_start,
-      .oq_index = kk_pool_is_ts(pool) ? 0u : pool->bo->gpu + pool->index_start,
+      .oq_index = kk_pool_is_oq(pool) ? pool->bo->gpu + pool->index_start : 0u,
 
       .first_query = first_index,
       .reports_per_query = kk_reports_per_query(pool),
@@ -428,11 +435,24 @@ kk_CmdWriteTimestamp2(VkCommandBuffer commandBuffer,
 }
 
 VKAPI_ATTR void VKAPI_CALL
-kk_CmdBeginQuery(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
-                 uint32_t query, VkQueryControlFlags flags)
+kk_CmdBeginQueryIndexedEXT(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
+                           uint32_t query, VkQueryControlFlags flags,
+                           uint32_t index)
 {
    VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
    VK_FROM_HANDLE(kk_query_pool, pool, queryPool);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   /* GS draws count the primitives of the stream into the reports while
+    * transform feedback is active */
+   if (pool->vk.query_type == VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT) {
+      cmd->state.gfx.xfb.queries[index] = kk_query_report_addr(dev, pool, query);
+      return;
+   }
+
+   if (!kk_pool_is_oq(pool))
+      return;
+
    cmd->state.gfx.occlusion.mode = flags & VK_QUERY_CONTROL_PRECISE_BIT
                                       ? MTL_VISIBILITY_RESULT_MODE_COUNTING
                                       : MTL_VISIBILITY_RESULT_MODE_BOOLEAN;
@@ -442,13 +462,25 @@ kk_CmdBeginQuery(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
 }
 
 VKAPI_ATTR void VKAPI_CALL
-kk_CmdEndQuery(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
-               uint32_t query)
+kk_CmdBeginQuery(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
+                 uint32_t query, VkQueryControlFlags flags)
+{
+   kk_CmdBeginQueryIndexedEXT(commandBuffer, queryPool, query, flags, 0u);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndQueryIndexedEXT(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
+                         uint32_t query, uint32_t index)
 {
    VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
    VK_FROM_HANDLE(kk_query_pool, pool, queryPool);
-   cmd->state.gfx.occlusion.mode = MTL_VISIBILITY_RESULT_MODE_DISABLED;
-   cmd->state.gfx.dirty |= KK_DIRTY_OCCLUSION;
+
+   if (pool->vk.query_type == VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT) {
+      cmd->state.gfx.xfb.queries[index] = 0u;
+   } else if (kk_pool_is_oq(pool)) {
+      cmd->state.gfx.occlusion.mode = MTL_VISIBILITY_RESULT_MODE_DISABLED;
+      cmd->state.gfx.dirty |= KK_DIRTY_OCCLUSION;
+   }
 
    /* Make the query available. The Vulkan spec states:
     * If queries are used while executing a render pass instance that has
@@ -469,6 +501,13 @@ kk_CmdEndQuery(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
    }
 }
 
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndQuery(VkCommandBuffer commandBuffer, VkQueryPool queryPool,
+               uint32_t query)
+{
+   kk_CmdEndQueryIndexedEXT(commandBuffer, queryPool, query, 0u);
+}
+
 static bool
 kk_query_is_available(struct kk_device *dev, struct kk_query_pool *pool,
                       uint32_t query)
@@ -594,7 +633,7 @@ kk_CmdCopyQueryPoolResultsToMemoryKHR(
    struct libkk_copy_queries_args args = {
       .availability = kk_pool_is_ts(pool) ? 0u : pool->bo->gpu,
