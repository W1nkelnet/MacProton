-            continue;
-         }
-         if (msl_def_is_texture(ctx, def)) {
-            P_INDENT(ctx);
-            msl_emit_texture_type(ctx, nir_instr_as_intrinsic(instr));
-            P(ctx, " t%u;\n", def->index);
-         } else {
-            /* No initializer: every SSA value is written before it is read,
-             * and zeroing thousands of them costs Metal's compiler about a
-             * tenth of its time, a third on the largest shaders. */
-            const char *type = msl_type_for_def(ctx->types, def);
-            if (!type)
-               continue;
-            P_IND(ctx, "%s t%u;\n", type, def->index);
-         }
+      }
+      if (inside)
+         return loop;
+      loop = enclosing_loop(&loop->cf_node);
+   }
+   return NULL;
+}
+
+static void
+declare_ssa_value(struct nir_to_msl_ctx *ctx, nir_instr *instr, nir_def *def)
+{
+   if (msl_def_is_texture(ctx, def)) {
+      P_INDENT(ctx);
+      msl_emit_texture_type(ctx, nir_instr_as_intrinsic(instr));
+      P(ctx, " t%u;\n", def->index);
+   } else {
+      /* No initializer: every SSA value is written before it is read,
+       * and zeroing thousands of them costs Metal's compiler about a
+       * tenth of its time, a third on the largest shaders. */
+      const char *type = msl_type_for_def(ctx->types, def);
+      if (!type)
+         return;
+      P_IND(ctx, "%s t%u;\n", type, def->index);
+   }
+}
+
+/* Declares the SSA values whose scope is loop, or the function for NULL */
+static void
+declare_ssa_values(struct nir_to_msl_ctx *ctx, nir_cf_node *node,
+                   nir_loop *loop)
+{
+   nir_foreach_block_in_cf_node(block, node) {
+      nir_foreach_instr(instr, block) {
+         nir_def *def = ssa_value_to_declare(ctx, instr);
+         if (def && ssa_value_scope(def) == loop)
+            declare_ssa_value(ctx, instr, def);
       }
    }
 }
 
+static void
+predeclare_ssa_values(struct nir_to_msl_ctx *ctx, nir_function_impl *impl)
+{
+   foreach_list_typed(nir_cf_node, node, node, &impl->body)
+      declare_ssa_values(ctx, node, NULL);
+}
