+/* The innermost loop that holds every use of def, or NULL for none.
+ *
+ * Metal's compiler mishandles simdgroup functions on values that live in
+ * variables declared outside the loop computing them: in a waterfall loop
+ * such as
+ *
+ *    while (true) {
+ *       first = simd_broadcast_first(v);
+ *       if (v == first) { r = simd_sum(v); break; }
+ *    }
+ *
+ * it runs the breaking branch with every thread active, as if after the
+ * loop, so the sum covers the whole simdgroup. Declared inside the loop the
+ * same code works, so SSA values are declared in the innermost loop that
+ * holds all their uses. */
+static nir_loop *
+ssa_value_scope(nir_def *def)
+{
+   nir_loop *loop = enclosing_loop(&nir_def_instr(def)->block->cf_node);
+   while (loop) {
+      bool inside = true;
+      nir_foreach_use_including_if(src, def) {
+         nir_cf_node *node =
+            nir_src_is_if(src) ? &nir_src_use_if(src)->cf_node
+                               : &nir_src_use_instr(src)->block->cf_node;
+         if (!cf_node_is_inside(node, loop)) {
+            inside = false;
             break;
          }
