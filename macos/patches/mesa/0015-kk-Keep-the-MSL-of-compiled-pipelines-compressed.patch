index 0000000..d5cd89f
--- /dev/null
+++ b/src/kosmickrisp/bridge/lz_compression.c
@@ -0,0 +1,34 @@
+/*
+ * Copyright 2026 MacProton contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "lz_compression.h"
+
+#include <compression.h>
+#include <stdlib.h>
+
+void *
+lz_compress(const void *data, size_t size, size_t *out_size)
+{
+   void *out = malloc(size);
+   if (out == NULL)
+      return NULL;
+
+   /* Fails if the result would not be smaller */
+   *out_size = compression_encode_buffer(out, size, data, size, NULL,
+                                         COMPRESSION_LZFSE);
+   if (*out_size == 0) {
+      free(out);
+      return NULL;
+   }
+
+   return realloc(out, *out_size) ?: out;
+}
+
+bool
+lz_decompress(const void *data, size_t size, void *out, size_t out_size)
+{
+   return compression_decode_buffer(out, out_size, data, size, NULL,
+                                    COMPRESSION_LZFSE) == out_size;
+}
diff --git a/src/kosmickrisp/bridge/lz_compression.h b/src/kosmickrisp/bridge/lz_compression.h
