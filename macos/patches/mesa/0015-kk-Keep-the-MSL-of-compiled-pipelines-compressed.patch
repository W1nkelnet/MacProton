@@ -0,0 +1,21 @@
+/*
+ * Copyright 2026 MacProton contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef LZ_COMPRESSION_H
+#define LZ_COMPRESSION_H 1
+
+#include <stdbool.h>
+#include <stddef.h>
+
+/* LZFSE from Apple's libcompression: fast enough to pack shader source
+ * after each pipeline compile, and about as dense as zlib's best level */
+
+/* Returns a malloc'ed buffer with the compressed data and its size in
+ * out_size, or NULL if the data does not compress. */
+void *lz_compress(const void *data, size_t size, size_t *out_size);
+
+bool lz_decompress(const void *data, size_t size, void *out, size_t out_size);
+
+#endif /* LZ_COMPRESSION_H */
