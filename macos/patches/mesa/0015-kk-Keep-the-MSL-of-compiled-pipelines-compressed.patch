+   free(shader->gs_main.packed);
    ralloc_free((void *)shader->gs_count.entrypoint_name);
    ralloc_free((void *)shader->gs_count.code);
+   free(shader->gs_count.packed);
    ralloc_free((void *)shader->gs_pre.entrypoint_name);
    ralloc_free((void *)shader->gs_pre.code);
+   free(shader->gs_pre.packed);
 
    vk_shader_free(&dev->vk, pAllocator, &shader->vk);
 }
@@ -2063,6 +2069,8 @@ kk_compile_shaders(struct vk_device *device, uint32_t shader_count,
       /* Memset the output array */
       memset(shaders_out, 0, shader_count * sizeof(*shaders_out));
    } else {
+      for (uint32_t i = 0; i < shader_count; i++)
+         kk_shader_pack(shaders[i]);
       memcpy(shaders_out, shaders, shader_count * sizeof(*shaders_out));
    }
 
@@ -2084,11 +2092,51 @@ static void
 kk_msl_serialize(const struct msl_compile_data *data, struct blob *blob)
 {
    uint32_t entrypoint_length = strlen(data->entrypoint_name) + 1;
-   uint32_t code_length = strlen(data->code) + 1;
+   uint32_t code_length = data->code ? strlen(data->code) + 1 : data->code_size;
    blob_write_uint32(blob, entrypoint_length);
    blob_write_uint32(blob, code_length);
    blob_write_bytes(blob, data->entrypoint_name, entrypoint_length);
-   blob_write_bytes(blob, data->code, code_length);
+
+   if (data->code) {
+      blob_write_bytes(blob, data->code, code_length);
+      return;
+   }
+
+   intptr_t offset = blob_reserve_bytes(blob, code_length);
+   if (offset < 0)
+      return;
+   if (blob->data && !lz_decompress(data->packed, data->packed_size,
+                                    blob->data + offset, code_length))
+      blob->out_of_memory = true;
+}
+
+static void
+kk_msl_pack(struct msl_compile_data *data)
+{
+   if (data->code == NULL)
+      return;
+
+   size_t size = strlen(data->code) + 1, packed_size;
+   void *packed = lz_compress(data->code, size, &packed_size);
+   if (packed == NULL)
+      return;
+
+   data->packed = packed;
+   data->packed_size = packed_size;
+   data->code_size = size;
+   ralloc_free(data->code);
+   data->code = NULL;
+}
+
+/* Compresses the MSL of a shader whose Metal pipelines exist */
+static void
+kk_shader_pack(struct kk_shader *shader)
+{
+   for (uint32_t i = 0; i < ARRAY_SIZE(shader->msl_data); i++)
+      kk_msl_pack(&shader->msl_data[i]);
+   kk_msl_pack(&shader->gs_main);
+   kk_msl_pack(&shader->gs_count);
+   kk_msl_pack(&shader->gs_pre);
 }
 
 static bool
@@ -2223,6 +2271,7 @@ kk_deserialize_shader(struct vk_device *vk_dev, struct blob_reader *blob,
    if (result != VK_SUCCESS)
       goto fail;
 
+   kk_shader_pack(shader);
    if (info.stage == MESA_SHADER_COMPUTE || info.stage == MESA_SHADER_VERTEX)
       p_atomic_inc(&kk_stats.cached);
    kk_stats_report();
