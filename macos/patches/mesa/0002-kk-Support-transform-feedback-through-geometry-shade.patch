diff --git a/src/kosmickrisp/libkk/kk_geometry.cl b/src/kosmickrisp/libkk/kk_geometry.cl
index dd102f9..306c299 100644
--- a/src/kosmickrisp/libkk/kk_geometry.cl
+++ b/src/kosmickrisp/libkk/kk_geometry.cl
@@ -49,11 +49,42 @@ libkk_gs_setup_indirect(uint64_t index_buffer, constant uint *draw,
                         global struct poly_geometry_params *p,
                         global struct poly_heap *heap, uint64_t vs_outputs,
                         uint32_t index_size_B, uint32_t index_buffer_range_el,
-                        uint32_t prim, uint32_t max_indices,
-                        enum poly_gs_shape shape)
+                        uint32_t prim, uint32_t is_prefix_summing,
+                        uint32_t max_indices, enum poly_gs_shape shape)
 {
    /* Prefix summing only serves transform feedback */
    poly_gs_setup_indirect(index_buffer, draw, vp, p, heap, vs_outputs,
                           index_size_B, index_buffer_range_el, prim,
-                          false /* is_prefix_summing */, max_indices, shape);
+                          is_prefix_summing, max_indices, shape);
+}
+
+/* Sums up the counts the GS count program wrote per input primitive, one
+ * workgroup per count word, so transform feedback knows where each primitive
+ * goes */
+KERNEL(1024)
+libkk_prefix_sum_geom(global struct poly_geometry_params *p)
+{
+   local uint scratch[32];
+   poly_prefix_sum(scratch, p->count_buffer, p->input_primitives,
+                   p->count_buffer_stride / 4, cl_group_id.x, 1024);
+}
+
+/* Loads a transform feedback offset from a counter buffer, or stores one */
+KERNEL(1)
+libkk_copy_xfb_counter(global uint *dst, constant uint *src)
+{
+   *dst = *src;
+}
+
+/* The draw of vkCmdDrawIndirectByteCountEXT */
+KERNEL(1)
+libkk_draw_byte_count(global uint *draw, constant uint *byte_count,
+                      uint32_t counter_offset, uint32_t vertex_stride,
+                      uint32_t instance_count, uint32_t first_instance)
+{
+   int bytes = (int)*byte_count - (int)counter_offset;
+   draw[0] = max(bytes, 0) / vertex_stride;
+   draw[1] = instance_count;
+   draw[2] = 0;
+   draw[3] = first_instance;
 }
