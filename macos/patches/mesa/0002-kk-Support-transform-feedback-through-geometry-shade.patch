+kk_gs_xfb(struct kk_cmd_buffer *cmd)
+{
+   struct kk_shader *gs = cmd->state.shaders[MESA_SHADER_GEOMETRY];
+   return gs && gs->info.gs.xfb && cmd->state.gfx.xfb.offsets;
+}
