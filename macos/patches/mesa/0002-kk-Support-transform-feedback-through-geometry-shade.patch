+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBindTransformFeedbackBuffers2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstBinding, uint32_t bindingCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pBindingInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   for (uint32_t i = 0; i < bindingCount; i++) {
+      const VkDeviceAddressRangeKHR range = pBindingInfos[i].addressRange;
+      cmd->state.gfx.xfb.buffers[firstBinding + i] = (struct kk_addr_range){
+         .addr = range.address,
+         .range = range.size,
+      };
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginTransformFeedback2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstCounterRange,
+   uint32_t counterRangeCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   /* Writing starts at offset 0, or where the counter buffers say */
+   uint32_t size_B = KK_MAX_XFB_BUFFERS * sizeof(uint32_t);
+   struct kk_ptr offsets = kk_pool_alloc(cmd, size_B, 4);
+   if (unlikely(!offsets.gpu))
+      return;
+
+   memset(offsets.cpu, 0, size_B);
+   cmd->state.gfx.xfb.offsets = offsets.gpu;
+
+   for (uint32_t i = 0; pCounterInfos && i < counterRangeCount; i++) {
+      uint64_t counter = pCounterInfos[i].addressRange.address;
+      if (counter) {
+         uint64_t offset =
+            offsets.gpu + (firstCounterRange + i) * sizeof(uint32_t);
+         libkk_copy_xfb_counter(cmd, kk_grid_1d(1u), true, offset, counter);
+      }
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndTransformFeedback2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstCounterRange,
+   uint32_t counterRangeCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   uint64_t offsets = cmd->state.gfx.xfb.offsets;
+   for (uint32_t i = 0; offsets && pCounterInfos && i < counterRangeCount;
+        i++) {
+      uint64_t counter = pCounterInfos[i].addressRange.address;
+      if (counter) {
+         uint64_t offset = offsets + (firstCounterRange + i) * sizeof(uint32_t);
+         libkk_copy_xfb_counter(cmd, kk_grid_1d(1u), true, counter, offset);
+      }
+   }
+
+   cmd->state.gfx.xfb.offsets = 0;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdDrawIndirectByteCount2EXT(
+   VkCommandBuffer commandBuffer, uint32_t instanceCount,
+   uint32_t firstInstance,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfo,
+   uint32_t counterOffset, uint32_t vertexStride)
+{
+   if (instanceCount == 0)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   /* Turn the byte count into an indirect draw */
+   struct kk_ptr draw = kk_pool_alloc(cmd, sizeof(VkDrawIndirectCommand), 4);
+   if (unlikely(!draw.gpu))
+      return;
+
+   libkk_draw_byte_count(cmd, kk_grid_1d(1u), true, draw.gpu,
+                         pCounterInfo->addressRange.address, counterOffset,
+                         vertexStride, instanceCount, firstInstance);
+
+   const VkDrawIndirect2InfoKHR info = {
+      .sType = VK_STRUCTURE_TYPE_DRAW_INDIRECT_2_INFO_KHR,
+      .addressRange = {
+         .address = draw.gpu,
+         .size = sizeof(VkDrawIndirectCommand),
+         .stride = sizeof(VkDrawIndirectCommand),
+      },
+      .drawCount = 1u,
+   };
+   kk_CmdDrawIndirect2KHR(commandBuffer, &info);
+}
