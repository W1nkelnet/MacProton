@@ -257,6 +259,22 @@ kk_encoder_update_debug(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
       mtl_encoder_push_debug_group(encoder, label->pLabelName);
 }
 
+static bool
+kk_light_barriers(struct kk_cmd_buffer *cmd)
+{
+   return kk_device_physical(kk_cmd_buffer_device(cmd))->settings.light_barriers;
+}
+
+/* A barrier recorded while no encoder covered it */
+static void
+kk_encoder_wait(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
+{
+   if (cmd->pending_barrier) {
+      mtl_barrier_after_queue_stages(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
+      cmd->pending_barrier = false;
+   }
+}
