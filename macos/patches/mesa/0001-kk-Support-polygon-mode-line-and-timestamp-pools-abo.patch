diff --git a/src/kosmickrisp/vulkan/kk_query_pool.h b/src/kosmickrisp/vulkan/kk_query_pool.h
index 0670fd5..d98b85d 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.h
+++ b/src/kosmickrisp/vulkan/kk_query_pool.h
@@ -12,13 +12,26 @@
 
 #include "vulkan/runtime/vk_query_pool.h"
 
+/* Metal counter heaps hold at most this many timestamps */
+#define KK_TS_HEAP_SIZE 4096
+#define KK_MAX_TS_HEAPS 16
+
 struct kk_ts_state {
-   /* Metal 4 counter heap backing VK_QUERY_TYPE_TIMESTAMP pools. Timestamps are
-    * sampled into this heap and later resolved into `bo` (see kk_query_pool.c).
-    * NULL for non-timestamp pools. */
-   mtl_counter_heap *heap;
+   /* Metal 4 counter heaps backing VK_QUERY_TYPE_TIMESTAMP pools, each holding
+    * KK_TS_HEAP_SIZE queries. Timestamps are sampled into these heaps and later
+    * resolved into `bo` (see kk_query_pool.c). */
+   mtl_counter_heap *heaps[KK_MAX_TS_HEAPS];
+   uint32_t heap_count;
 };
 
+/* The heap holding a timestamp query, and the query's index in it */
+static inline mtl_counter_heap *
+kk_ts_heap(const struct kk_ts_state *ts, uint32_t query, uint32_t *index)
+{
+   *index = query % KK_TS_HEAP_SIZE;
+   return ts->heaps[query / KK_TS_HEAP_SIZE];
+}
