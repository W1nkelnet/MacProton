@@ -881,7 +881,8 @@ kk_lower_nir(struct kk_device *dev, nir_shader *nir, bool emulated_stage,
    NIR_PASS(_, nir, kk_nir_lower_textures);
 
    if (features & KK_FEAT_NULL_DESCRIPTOR)
-      NIR_PASS(_, nir, kk_nir_lower_null_images);
+      NIR_PASS(_, nir, kk_nir_lower_null_images,
