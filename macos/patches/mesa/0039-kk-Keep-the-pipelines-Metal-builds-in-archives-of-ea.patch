+      end_build(archives, built && pipeline);
 
       if (pipeline == nil) {
          fprintf(stderr, "Failed to create MTLComputePipelineState: %s\n", [error.localizedDescription UTF8String]);
@@ -192,8 +497,19 @@ mtl_new_render_pipeline(mtl_compiler *compiler, mtl_render_pass_descriptor *desc
       MTL4RenderPipelineDescriptor *desc = (MTL4RenderPipelineDescriptor *)descriptor;
 
       NSError *error = nil;
-      id<MTLRenderPipelineState> pipeline = [comp newRenderPipelineStateWithDescriptor:desc compilerTaskOptions:nil
-                                                                                 error:&error];
+      KKPipelineArchives *archives = archives_of(comp);
+      begin_build(archives);
+      id<MTLRenderPipelineState> pipeline = nil;
+      MTL4CompilerTaskOptions *options = archives ? archives->capture_options : nil;
+      for (id<MTL4Archive> archive in archives && !options ? archives->archives : nil) {
+         pipeline = [archive newRenderPipelineStateWithDescriptor:desc error:nil];
+         if (pipeline)
