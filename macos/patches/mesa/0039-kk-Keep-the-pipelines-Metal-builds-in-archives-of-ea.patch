+
+/* Pipeline archives
+ *
+ * Metal keeps the pipelines it builds in a cache of each app's, Wine's for
+ * every game, which holds a little over 2 GB. Rise of the Tomb Raider creates
+ * 13,659 pipelines at every start: when another game or driver build ran in
+ * between, Metal built them again for 4 minutes of all cores, during the
+ * game's own benchmark, and even started right after itself missed a part.
+ *
+ * So the compiler keeps the pipelines it builds in archives of the game's own:
+ * pipelines come from them when they are there, and the ones Metal builds are
+ * captured and written to a new archive every ARCHIVE_WRITE_EVERY pipelines,
+ * ARCHIVE_WRITE_IDLE seconds after the last one (at most every
+ * ARCHIVE_WRITE_GAP seconds), and when the last device goes, which Proton ends
+ * games without. Writing empties the capture and must not run while the
+ * compiler builds a pipeline (Metal crashes), hence the lock.
+ *
+ * Archives only hold the binaries for the descriptors, functions and device
+ * they were built for, so stale ones only miss, and Metal can't add to one.
+ * Once there are more than ARCHIVE_COMPACT_FILES, a process captures every
+ * pipeline it creates, archived or not, into a new generation of archives,
+ * and the next one drops the older generations when the new one holds at
+ * least half as many pipelines.
+ */
+#define ARCHIVE_WRITE_EVERY 1024
+#define ARCHIVE_WRITE_IDLE 5
+#define ARCHIVE_WRITE_GAP 30
+#define ARCHIVE_COMPACT_FILES 32
+#define ARCHIVE_MAX_FILES 128
+#define ARCHIVE_MAX_BYTES (4ull << 30)
+
+@interface KKPipelineArchives : NSObject {
+@public
+   NSString *dir;
+   NSArray<id<MTL4Archive>> *archives;
+   id<MTL4PipelineDataSetSerializer> serializer;
+   /* Looks pipelines up in the archives through the compiler, which captures
+    * them, when compacting */
+   MTL4CompilerTaskOptions *capture_options;
+   unsigned gen;
+   pthread_rwlock_t lock;
+   uint32_t unwritten;
+   uint32_t writing;
+   uint32_t written;
+   uint64_t last_built;
+   uint64_t last_written;
+   dispatch_queue_t queue;
+   dispatch_source_t timer;
+}
+@end
+
+@implementation KKPipelineArchives
+- (void)dealloc
+{
+   if (timer) {
+      dispatch_source_cancel(timer);
+      /* The timer's handler runs on the queue and does not retain self */
+      dispatch_sync(queue, ^{});
+      dispatch_release(timer);
+      dispatch_release(queue);
+   }
+   [dir release];
+   [archives release];
+   [serializer release];
+   [capture_options release];
+   pthread_rwlock_destroy(&lock);
+   [super dealloc];
+}
+@end
+
+static char kk_archives_key;
+
+static KKPipelineArchives *
+archives_of(id<MTL4Compiler> compiler)
+{
+   return objc_getAssociatedObject(compiler, &kk_archives_key);
+}
+
+static void start_idle_writes(KKPipelineArchives *archives);
+static void write_archive(KKPipelineArchives *archives);
+
+struct archive_file {
+   NSString *name;
+   unsigned gen, count;
+   uint64_t bytes;
+};
+
+/* Opens the archives in dir, newest first, after dropping the generations a
+ * newer one replaces, and picks the generation new archives go to */
+static void
+open_archives(KKPipelineArchives *archives, id<MTLDevice> dev)
+{
+   NSFileManager *fm = [NSFileManager defaultManager];
+   NSString *dir = archives->dir;
+   [fm createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil];
+
+   /* Named GEN-TIME-PID-SEQ-COUNT.mtl4a, so they sort oldest first */
+   NSArray<NSString *> *names =
+      [[fm contentsOfDirectoryAtPath:dir error:nil] sortedArrayUsingSelector:@selector(compare:)];
+   struct archive_file *files = calloc(names.count + 1, sizeof(*files));
+   unsigned n = 0, newest = 0;
+   for (NSString *name in names) {
+      NSString *path = [dir stringByAppendingPathComponent:name];
+      unsigned gen, count;
+      long time;
+      int pid;
+      unsigned seq;
+      if (![name hasSuffix:@".mtl4a"] ||
+          sscanf([name UTF8String], "%u-%ld-%d-%u-%u.mtl4a", &gen, &time, &pid, &seq, &count) != 5) {
+         /* Left over by a process that ended while writing, or not ours */
+         if ([name hasSuffix:@".tmp"] || [name hasSuffix:@".mtl4a"])
+            [fm removeItemAtPath:path error:nil];
+         continue;
+      }
+      files[n++] = (struct archive_file){
+         .name = name, .gen = gen, .count = count,
+         .bytes = [[fm attributesOfItemAtPath:path error:nil] fileSize],
+      };
+      newest = MAX2(newest, gen);
+   }
+
+   uint64_t newest_count = 0, older_count = 0;
+   for (unsigned i = 0; i < n; i++)
+      *(files[i].gen == newest ? &newest_count : &older_count) += files[i].count;
+
+   /* Oldest first, the files to keep start at first */
+   unsigned first = 0;
+   if (older_count && newest_count * 2 >= older_count) {
+      while (first < n && files[first].gen != newest)
+         first++;
+   }
+   uint64_t bytes = 0;
+   for (unsigned i = first; i < n; i++)
+      bytes += files[i].bytes;
+   while (first < n && files[first].gen != newest &&
+          (n - first > ARCHIVE_MAX_FILES || bytes > ARCHIVE_MAX_BYTES))
+      bytes -= files[first++].bytes;
+   if (n - first > ARCHIVE_MAX_FILES || bytes > ARCHIVE_MAX_BYTES)
+      first = n;
+   for (unsigned i = 0; i < first; i++)
+      [fm removeItemAtPath:[dir stringByAppendingPathComponent:files[i].name] error:nil];
+
+   NSMutableArray<id<MTL4Archive>> *opened = [NSMutableArray array];
+   for (unsigned i = n; i-- > first;) {
+      NSString *path = [dir stringByAppendingPathComponent:files[i].name];
+      id<MTL4Archive> archive = [dev newArchiveWithURL:[NSURL fileURLWithPath:path] error:nil];
+      if (archive) {
+         [opened addObject:archive];
+         [archive release];
+      } else {
+         [fm removeItemAtPath:path error:nil];
+      }
+   }
+   free(files);
+
+   archives->archives = [opened retain];
+   archives->gen = newest;
+   if (opened.count > ARCHIVE_COMPACT_FILES) {
+      archives->gen = newest + 1;
+      archives->capture_options = [MTL4CompilerTaskOptions new];
+      archives->capture_options.lookupArchives = opened;
+   }
+}
+
 /* Compiler */
 mtl_compiler *
-mtl_new_compiler(mtl_device *device)
+mtl_new_compiler(mtl_device *device, const char *archive_dir)
 {
    @autoreleasepool {
       id<MTLDevice> dev = (id<MTLDevice>)device;
 
       MTL4CompilerDescriptor *desc = [[MTL4CompilerDescriptor new] autorelease];
 
+      KKPipelineArchives *archives = nil;
+      if (archive_dir) {
+         archives = [[KKPipelineArchives new] autorelease];
+         archives->dir = [@(archive_dir) retain];
+         open_archives(archives, dev);
+         pthread_rwlock_init(&archives->lock, NULL);
+
+         MTL4PipelineDataSetSerializerDescriptor *sdesc =
+            [[MTL4PipelineDataSetSerializerDescriptor new] autorelease];
+         sdesc.configuration = MTL4PipelineDataSetSerializerConfigurationCaptureBinaries;
+         archives->serializer = [dev newPipelineDataSetSerializerWithDescriptor:sdesc];
+         desc.pipelineDataSetSerializer = archives->serializer;
+         start_idle_writes(archives);
+      }
+
       NSError *error;
       id<MTL4Compiler> compiler = [dev newCompilerWithDescriptor:desc error:&error];
 
       if (compiler == nil) {
          fprintf(stderr, "Failed to create MTL4Compiler: %s\n", [error.localizedDescription UTF8String]);
+      } else if (archives) {
+         objc_setAssociatedObject(compiler, &kk_archives_key, archives, OBJC_ASSOCIATION_RETAIN);
       }
 
       return compiler;
    }
 }
 
+static void
+try_write_archive(KKPipelineArchives *archives)
+{
+   if (!__atomic_exchange_n(&archives->writing, 1, __ATOMIC_ACQUIRE)) {
+      write_archive(archives);
+      __atomic_store_n(&archives->writing, 0, __ATOMIC_RELEASE);
+   }
+}
+
+static void
+start_idle_writes(KKPipelineArchives *archives)
+{
+   archives->queue = dispatch_queue_create("kk.pipeline_archives", DISPATCH_QUEUE_SERIAL);
+   archives->timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, archives->queue);
+   /* Not an object pointer, which the block would retain */
+   void *ptr = archives;
+   dispatch_source_set_event_handler(archives->timer, ^{
+      @autoreleasepool {
+         KKPipelineArchives *a = ptr;
+         int64_t now = time(NULL);
+         if (__atomic_load_n(&a->unwritten, __ATOMIC_RELAXED) &&
+             now - (int64_t)__atomic_load_n(&a->last_built, __ATOMIC_RELAXED) >= ARCHIVE_WRITE_IDLE &&
+             now - (int64_t)__atomic_load_n(&a->last_written, __ATOMIC_RELAXED) >= ARCHIVE_WRITE_GAP)
+            try_write_archive(a);
+      }
+   });
+   dispatch_source_set_timer(archives->timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
+                             NSEC_PER_SEC, NSEC_PER_SEC / 2);
+   dispatch_resume(archives->timer);
+}
+
+static void
+write_archive(KKPipelineArchives *archives)
+{
+   pthread_rwlock_wrlock(&archives->lock);
+   uint32_t count = __atomic_load_n(&archives->unwritten, __ATOMIC_RELAXED);
+   if (count) {
+      NSString *name = [NSString stringWithFormat:@"%04u-%010ld-%d-%u-%u.mtl4a", archives->gen,
+                                                  (long)time(NULL), getpid(), archives->written++, count];
+      NSString *path = [archives->dir stringByAppendingPathComponent:name];
+      NSString *tmp = [path stringByAppendingString:@".tmp"];
+      NSError *error = nil;
+      struct timespec t0, t1;
+      clock_gettime(CLOCK_MONOTONIC, &t0);
+      BOOL ok = [archives->serializer serializeAsArchiveAndFlushToURL:[NSURL fileURLWithPath:tmp] error:&error];
+      if (ok)
+         rename([tmp fileSystemRepresentation], [path fileSystemRepresentation]);
+      else
+         unlink([tmp fileSystemRepresentation]);
+      clock_gettime(CLOCK_MONOTONIC, &t1);
+      if (getenv("MESA_KK_COMPILE_STATS"))
+         fprintf(stderr, "kk: %s %u pipelines to %s in %.2f s\n", ok ? "wrote" : "failed to write",
+                 count, [name UTF8String], (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) / 1e9);
+      __atomic_store_n(&archives->unwritten, 0, __ATOMIC_RELAXED);
+      __atomic_store_n(&archives->last_written, (uint64_t)time(NULL), __ATOMIC_RELAXED);
+   }
+   pthread_rwlock_unlock(&archives->lock);
+}
+
+void
+mtl_compiler_write_archive(mtl_compiler *compiler)
+{
+   @autoreleasepool {
+      KKPipelineArchives *archives = archives_of((id<MTL4Compiler>)compiler);
+      if (archives)
+         try_write_archive(archives);
+   }
+}
+
+static void
+begin_build(KKPipelineArchives *archives)
+{
+   if (archives)
+      pthread_rwlock_rdlock(&archives->lock);
+}
+
+/* Ends a pipeline build, with captured set when the pipeline went to the
+ * capture */
+static void
+end_build(KKPipelineArchives *archives, bool captured)
+{
+   if (!archives)
+      return;
+
+   pthread_rwlock_unlock(&archives->lock);
+   if (!captured)
+      return;
+
+   __atomic_store_n(&archives->last_built, (uint64_t)time(NULL), __ATOMIC_RELAXED);
+   if (__atomic_add_fetch(&archives->unwritten, 1, __ATOMIC_RELAXED) >= ARCHIVE_WRITE_EVERY)
+      try_write_archive(archives);
+}
+
+void
+mtl_compiler_begin_build(mtl_compiler *compiler)
+{
+   begin_build(archives_of((id<MTL4Compiler>)compiler));
+}
+
+void
+mtl_compiler_end_build(mtl_compiler *compiler)
+{
+   end_build(archives_of((id<MTL4Compiler>)compiler), false);
+}
