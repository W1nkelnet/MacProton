+static void
+write_live_archives(void)
+{
+   /* A killed thread may hold it */
+   if (pthread_mutex_trylock(&live_lock))
+      return;
+   for (unsigned i = 0; i < MAX_LIVE_ARCHIVES; i++) {
+      @autoreleasepool {
+         if (live_archives[i])
+            try_write_archive(live_archives[i], true);
+      }
+   }
+   pthread_mutex_unlock(&live_lock);
+}
+
+static void
+write_live_archives_at_exit(void)
+{
+   atexit(write_live_archives);
+}
+
+static void
+list_archives(KKPipelineArchives *archives)
+{
+   static pthread_once_t once = PTHREAD_ONCE_INIT;
+   pthread_once(&once, write_live_archives_at_exit);
+   pthread_mutex_lock(&live_lock);
+   for (unsigned i = 0; i < MAX_LIVE_ARCHIVES; i++) {
+      if (!live_archives[i]) {
+         live_archives[i] = archives;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&live_lock);
+}
+
+static void
+unlist_archives(KKPipelineArchives *archives)
+{
+   pthread_mutex_lock(&live_lock);
+   for (unsigned i = 0; i < MAX_LIVE_ARCHIVES; i++) {
+      if (live_archives[i] == archives)
+         live_archives[i] = nil;
+   }
+   pthread_mutex_unlock(&live_lock);
+}
