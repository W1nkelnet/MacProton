+/* Where Metal keeps the working copies of the pipelines it captures */
+static NSString *
+gpuarchiver_dir(void)
+{
+   char cache[PATH_MAX];
+   if (!confstr(_CS_DARWIN_USER_CACHE_DIR, cache, sizeof(cache)))
+      return nil;
+   NSString *dir = @(cache);
+   NSString *bundle = [[NSBundle mainBundle] bundleIdentifier];
+   if (bundle)
+      dir = [dir stringByAppendingPathComponent:bundle];
+   return [dir stringByAppendingPathComponent:@"com.apple.gpuarchiver"];
+}
+
+/* The AIR folders of a working copy */
+static NSArray<NSString *> *
+air_dirs(NSString *copy)
+{
+   NSMutableArray<NSString *> *dirs = [NSMutableArray array];
+   for (NSString *sub in [[NSFileManager defaultManager] contentsOfDirectoryAtPath:copy error:nil]) {
+      if ([sub hasPrefix:@"air"])
+         [dirs addObject:[copy stringByAppendingPathComponent:sub]];
+   }
+   return dirs;
+}
+
+/* The metallibs of a complete working copy, the only files of its AIR folders
+ * that end so */
+static NSArray<NSString *> *
+copy_metallibs(NSString *copy)
+{
+   NSMutableArray<NSString *> *libs = [NSMutableArray array];
+   for (NSString *dir in air_dirs(copy)) {
+      for (NSString *name in [[NSFileManager defaultManager] contentsOfDirectoryAtPath:dir error:nil]) {
+         if ([name hasSuffix:@".metallib"])
+            [libs addObject:[dir stringByAppendingPathComponent:name]];
+      }
+   }
+   return libs;
+}
+
+/* Removes the working copies nothing changed for COPY_STALE seconds, neither
+ * the folder nor what it holds */
+static void
+remove_stale_copies(NSString *copies)
+{
+   NSFileManager *fm = [NSFileManager defaultManager];
+   NSDate *stale = [NSDate dateWithTimeIntervalSinceNow:-COPY_STALE];
+   for (NSString *name in [fm contentsOfDirectoryAtPath:copies error:nil]) {
+      if (![name hasPrefix:@"gpuarchiver-"])
+         continue;
+      NSString *copy = [copies stringByAppendingPathComponent:name];
+      NSMutableArray<NSString *> *paths = [NSMutableArray arrayWithObject:copy];
+      for (NSString *sub in [fm contentsOfDirectoryAtPath:copy error:nil])
+         [paths addObject:[copy stringByAppendingPathComponent:sub]];
+      bool changed = false;
+      for (NSString *path in paths) {
+         NSDate *modified = [[fm attributesOfItemAtPath:path error:nil] fileModificationDate];
+         changed |= !modified || [modified compare:stale] == NSOrderedDescending;
+      }
+      if (!changed)
+         [fm removeItemAtPath:copy error:nil];
+   }
+}
+
+/* The complete working copies that appeared since the compiler came, ours and
+ * other processes' */
+static NSMutableSet<NSString *> *
+complete_copies(KKPipelineArchives *archives)
+{
+   NSMutableSet<NSString *> *copies = [NSMutableSet set];
+   for (NSString *name in [[NSFileManager defaultManager] contentsOfDirectoryAtPath:archives->copies error:nil]) {
+      if (![name hasPrefix:@"gpuarchiver-"] || [archives->old_copies containsObject:name])
+         continue;
+      NSString *copy = [archives->copies stringByAppendingPathComponent:name];
+      if (copy_metallibs(copy).count)
+         [copies addObject:copy];
+   }
+   return copies;
+}
+
+/* Removes the working copies a write completed, after moving their AIR next
+ * to the archive written as name, when there is one */
+static void
+remove_working_copies(KKPipelineArchives *archives, NSSet<NSString *> *completed, NSString *name)
+{
+   NSFileManager *fm = [NSFileManager defaultManager];
+   unsigned kept = 0;
+   for (NSString *copy in completed) {
+      NSArray<NSString *> *libs = copy_metallibs(copy);
+      if (!libs.count)
+         continue;
+      for (NSString *lib in name ? libs : nil) {
+         NSString *air = [NSString stringWithFormat:@"%@.%u.air", name, kept];
+         if ([fm moveItemAtPath:lib toPath:[archives->dir stringByAppendingPathComponent:air] error:nil])
+            kept++;
+      }
+      [fm removeItemAtPath:copy error:nil];
+   }
+}
+
+/* Waits for the builds to end, at exit a second at most: Wine killed the
+ * process's other threads, maybe in the middle of one */
+static bool
+lock_builds(KKPipelineArchives *archives, bool exiting)
+{
+   if (!exiting)
+      return !pthread_rwlock_wrlock(&archives->lock);
+   for (unsigned i = 0; i < 100; i++) {
+      if (!pthread_rwlock_trywrlock(&archives->lock))
+         return true;
+      usleep(10 * 1000);
+   }
+   return false;
+}
