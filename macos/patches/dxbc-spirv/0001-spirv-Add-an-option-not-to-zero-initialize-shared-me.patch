From 06bc6b881febddb236a0d5ede8ba86f57859c692 Mon Sep 17 00:00:00 2001
From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Thu, 29 Oct 2026 13:08:56 +0100
Subject: [PATCH] spirv: Add an option not to zero-initialize shared memory.

D3D does not guarantee zero-initialized groupshared memory. SPIRV-Cross
zero-initializes it for Metal in a loop over gl_WorkGroupSize without
declaring it, so MoltenVK fails to compile such compute shaders.
---
 spirv/spirv_builder.cpp | 9 +++++++--
 spirv/spirv_builder.h   | 3 +++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/spirv/spirv_builder.cpp b/spirv/spirv_builder.cpp
index edfe431..0ca9ee7 100644
--- a/spirv/spirv_builder.cpp
+++ b/spirv/spirv_builder.cpp
@@ -822,8 +822,13 @@ void SpirvBuilder::emitDclLds(const ir::Op& op) {
   auto typeId = getIdForType(op.getType());
   auto ptrTypeId = getIdForPtrType(typeId, spv::StorageClassWorkgroup);
 
-  pushOp(m_declarations, spv::OpVariable, ptrTypeId, varId,
-    spv::StorageClassWorkgroup, getIdForConstantNull(op.getType()));
+  if (m_options.zeroInitLds) {
+    pushOp(m_declarations, spv::OpVariable, ptrTypeId, varId,
+      spv::StorageClassWorkgroup, getIdForConstantNull(op.getType()));
+  } else {
+    pushOp(m_declarations, spv::OpVariable, ptrTypeId, varId,
+      spv::StorageClassWorkgroup);
+  }
 
   addEntryPointId(varId);
 }
diff --git a/spirv/spirv_builder.h b/spirv/spirv_builder.h
index 9e7e579..c2eead4 100644
--- a/spirv/spirv_builder.h
+++ b/spirv/spirv_builder.h
@@ -58,6 +58,9 @@ public:
     /** Zero-initialize scratch variables. Useful in case games rely on
      *  undefined behaviour, but may cause perf issues in some cases. */
     bool zeroInitializeScratch = false;
+    /** Whether to zero-initialize shared memory. D3D does not guarantee
+     *  it, but some games rely on it. */
+    bool zeroInitLds = true;
   };
 
   explicit SpirvBuilder(const ir::Builder& builder, ResourceMapping& mapping, const Options& options);
-- 
2.56.0

