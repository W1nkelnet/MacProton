From 54e7b5e3eb3f71f7f9ac81066d28fcf609eb1152 Mon Sep 17 00:00:00 2001
From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Wed, 28 Oct 2026 09:59:06 +0100
Subject: [PATCH 4/4] dxvk: Leave shared memory uninitialized on MoltenVK.

SPIRV-Cross zero-initializes shared memory for Metal in a loop over an
undeclared gl_WorkGroupSize, so Metal failed to compile such compute
shaders, e.g. 25 in Town To City (Unreal Engine 5.7).

Requires the dxbc-spirv option zeroInitLds.
---
 src/dxvk/dxvk_device.cpp    | 5 +++++
 src/dxvk/dxvk_shader.h      | 2 ++
 src/dxvk/dxvk_shader_ir.cpp | 1 +
 3 files changed, 8 insertions(+)

diff --git a/src/dxvk/dxvk_device.cpp b/src/dxvk/dxvk_device.cpp
index a505c95..bd8ad03 100644
--- a/src/dxvk/dxvk_device.cpp
+++ b/src/dxvk/dxvk_device.cpp
@@ -824,6 +824,11 @@ namespace dxvk {
     if (m_features.nvRawAccessChains.shaderRawAccessChains)
       m_shaderOptions.spirv.set(DxvkShaderSpirvFlag::SupportsNvRawAccessChains);
 
+    // SPIRV-Cross zero-initializes shared memory for Metal in a loop over
+    // gl_WorkGroupSize without declaring it, so such shaders fail to compile
+    if (m_adapter->matchesDriver(VK_DRIVER_ID_MOLTENVK))
+      m_shaderOptions.spirv.set(DxvkShaderSpirvFlag::NoZeroInitSharedMemory);
+
     // Mesa drivers generally optimize large constant arrays to a buffer, some other
     // drivers do not and suffer a significant performance loss. Enable lowering on
     // those drivers.
diff --git a/src/dxvk/dxvk_shader.h b/src/dxvk/dxvk_shader.h
index 1c6903f..69f1904 100644
--- a/src/dxvk/dxvk_shader.h
+++ b/src/dxvk/dxvk_shader.h
@@ -116,6 +116,8 @@ namespace dxvk {
     SupportsDescriptorHeap      = 21u,
     /// Whether scratch memory should be zeroed.
     ZeroScratchMemory           = 22u,
+    /// Whether to leave shared memory uninitialized
+    NoZeroInitSharedMemory      = 23u,
   };
 
   using DxvkShaderSpirvFlags = Flags<DxvkShaderSpirvFlag>;
diff --git a/src/dxvk/dxvk_shader_ir.cpp b/src/dxvk/dxvk_shader_ir.cpp
index 9fe3682..22d06c4 100644
--- a/src/dxvk/dxvk_shader_ir.cpp
+++ b/src/dxvk/dxvk_shader_ir.cpp
@@ -2094,6 +2094,7 @@ namespace dxvk {
     options.nvRawAccessChains = m_info.options.spirv.test(DxvkShaderSpirvFlag::SupportsNvRawAccessChains);
     options.dualSourceBlending = linkage && linkage->fsDualSrcBlend;
     options.zeroInitializeScratch = m_info.options.spirv.test(DxvkShaderSpirvFlag::ZeroScratchMemory);
+    options.zeroInitLds = !m_info.options.spirv.test(DxvkShaderSpirvFlag::NoZeroInitSharedMemory);
 
     if (m_info.options.spirv.all(DxvkShaderSpirvFlag::IndependentDenormMode,
                                  DxvkShaderSpirvFlag::SupportsRte32,
-- 
