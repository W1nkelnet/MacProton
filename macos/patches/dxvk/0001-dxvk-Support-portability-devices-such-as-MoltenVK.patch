diff --git a/src/dxvk/dxvk_null_resources.cpp b/src/dxvk/dxvk_null_resources.cpp
new file mode 100644
index 0000000..a00aee3
--- /dev/null
+++ b/src/dxvk/dxvk_null_resources.cpp
@@ -0,0 +1,135 @@
+#include "dxvk_context.h"
+#include "dxvk_device.h"
+#include "dxvk_null_resources.h"
+
+namespace dxvk {
+
+  // Large enough for a full D3D constant buffer
+  constexpr VkDeviceSize NullBufferSize = 65536u;
+
+  DxvkNullResources::DxvkNullResources(
+          DxvkDevice*           device,
+          DxvkContext*          context) {
+    DxvkBufferCreateInfo bufferInfo = { };
+    bufferInfo.size   = NullBufferSize;
+    bufferInfo.usage  = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT
+                      | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT
+                      | VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT
+                      | VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT
+                      | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    bufferInfo.stages = device->getShaderPipelineStages()
+                      | VK_PIPELINE_STAGE_TRANSFER_BIT;
+    bufferInfo.access = VK_ACCESS_UNIFORM_READ_BIT
+                      | VK_ACCESS_SHADER_READ_BIT
+                      | VK_ACCESS_SHADER_WRITE_BIT
+                      | VK_ACCESS_TRANSFER_WRITE_BIT;
+    bufferInfo.debugName = "Null descriptor buffer";
+
+    m_buffer = device->createBuffer(bufferInfo, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    context->initBuffer(m_buffer);
+
+    DxvkBufferViewKey viewInfo = { };
+    viewInfo.format = VK_FORMAT_R32_UINT;
+    viewInfo.offset = 0u;
+    viewInfo.size   = NullBufferSize;
+
+    viewInfo.usage = VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT;
+    m_bufferViewUniform = m_buffer->createView(viewInfo);
+
+    viewInfo.usage = VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT;
+    m_bufferViewStorage = m_buffer->createView(viewInfo);
+
+    for (uint32_t i = 0u; i < 2u; i++) {
+      bool storage = i != 0u;
+
+      m_image1D[i] = createImage(device, VK_IMAGE_TYPE_1D, 1u, storage);
+      m_image2D[i] = createImage(device, VK_IMAGE_TYPE_2D, 6u, storage);
+      m_image3D[i] = createImage(device, VK_IMAGE_TYPE_3D, 1u, storage);
+
+      context->initImage(m_image1D[i], VK_IMAGE_LAYOUT_UNDEFINED);
+      context->initImage(m_image2D[i], VK_IMAGE_LAYOUT_UNDEFINED);
+      context->initImage(m_image3D[i], VK_IMAGE_LAYOUT_UNDEFINED);
+
+      m_views[i][VK_IMAGE_VIEW_TYPE_1D]         = createView(m_image1D[i], VK_IMAGE_VIEW_TYPE_1D,         1u, storage);
+      m_views[i][VK_IMAGE_VIEW_TYPE_1D_ARRAY]   = createView(m_image1D[i], VK_IMAGE_VIEW_TYPE_1D_ARRAY,   1u, storage);
+      m_views[i][VK_IMAGE_VIEW_TYPE_2D]         = createView(m_image2D[i], VK_IMAGE_VIEW_TYPE_2D,         1u, storage);
+      m_views[i][VK_IMAGE_VIEW_TYPE_2D_ARRAY]   = createView(m_image2D[i], VK_IMAGE_VIEW_TYPE_2D_ARRAY,   1u, storage);
+      m_views[i][VK_IMAGE_VIEW_TYPE_CUBE]       = createView(m_image2D[i], VK_IMAGE_VIEW_TYPE_CUBE,       6u, storage);
+      m_views[i][VK_IMAGE_VIEW_TYPE_CUBE_ARRAY] = createView(m_image2D[i], VK_IMAGE_VIEW_TYPE_CUBE_ARRAY, 6u, storage);
+      m_views[i][VK_IMAGE_VIEW_TYPE_3D]         = createView(m_image3D[i], VK_IMAGE_VIEW_TYPE_3D,         1u, storage);
+    }
+  }
+
+
+  DxvkNullResources::~DxvkNullResources() {
+
+  }
+
+
+  DxvkLegacyDescriptor DxvkNullResources::bufferDescriptor() const {
+    return m_buffer->getDescriptor(0u, NullBufferSize);
+  }
+
+
+  DxvkLegacyDescriptor DxvkNullResources::bufferViewDescriptor(bool storage) const {
+    const auto& view = storage ? m_bufferViewStorage : m_bufferViewUniform;
+    return view->getDescriptor(false)->legacy;
+  }
+
+
+  DxvkLegacyDescriptor DxvkNullResources::imageViewDescriptor(
+          VkImageViewType       viewType,
+          bool                  storage) const {
+    const auto& view = m_views[storage ? 1u : 0u][uint32_t(viewType)];
+    return view->getDescriptor(viewType)->legacy;
+  }
+
+
+  Rc<DxvkImage> DxvkNullResources::createImage(
+          DxvkDevice*           device,
+          VkImageType           type,
+          uint32_t              layers,
+          bool                  storage) {
+    DxvkImageCreateInfo info = { };
+    info.type         = type;
+    info.format       = storage ? VK_FORMAT_R32_UINT : VK_FORMAT_R8G8B8A8_UNORM;
+    info.flags        = type == VK_IMAGE_TYPE_2D ? VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT : 0u;
+    info.sampleCount  = VK_SAMPLE_COUNT_1_BIT;
+    info.extent       = { 1u, 1u, 1u };
+    info.numLayers    = layers;
+    info.mipLevels    = 1u;
+    info.usage        = VK_IMAGE_USAGE_TRANSFER_DST_BIT
+                      | (storage ? VK_IMAGE_USAGE_STORAGE_BIT : VK_IMAGE_USAGE_SAMPLED_BIT);
+    info.stages       = device->getShaderPipelineStages()
+                      | VK_PIPELINE_STAGE_TRANSFER_BIT;
+    info.access       = VK_ACCESS_SHADER_READ_BIT
+                      | VK_ACCESS_TRANSFER_WRITE_BIT
+                      | (storage ? VK_ACCESS_SHADER_WRITE_BIT : 0u);
+    info.tiling       = VK_IMAGE_TILING_OPTIMAL;
+    info.layout       = VK_IMAGE_LAYOUT_GENERAL;
+    info.debugName    = "Null descriptor image";
+
+    return device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+  }
+
+
+  Rc<DxvkImageView> DxvkNullResources::createView(
+    const Rc<DxvkImage>&        image,
+          VkImageViewType       type,
+          uint32_t              layers,
+          bool                  storage) {
+    DxvkImageViewKey info = { };
+    info.viewType   = type;
+    info.usage      = storage ? VK_IMAGE_USAGE_STORAGE_BIT : VK_IMAGE_USAGE_SAMPLED_BIT;
+    info.format     = image->info().format;
+    info.layout     = VK_IMAGE_LAYOUT_GENERAL;
+    info.aspects    = VK_IMAGE_ASPECT_COLOR_BIT;
+    info.mipIndex   = 0u;
+    info.mipCount   = 1u;
+    info.layerIndex = 0u;
+    info.layerCount = layers;
+
+    return image->createView(info);
+  }
+
+}
diff --git a/src/dxvk/dxvk_null_resources.h b/src/dxvk/dxvk_null_resources.h
new file mode 100644
index 0000000..bb9ba4d
--- /dev/null
+++ b/src/dxvk/dxvk_null_resources.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include "dxvk_buffer.h"
+#include "dxvk_descriptor.h"
+#include "dxvk_image.h"
+
+namespace dxvk {
+
+  class DxvkContext;
+  class DxvkDevice;
+
+  /**
+   * \brief Dummy resources for unbound descriptors
+   *
+   * Used in place of null descriptors on devices that do not
+   * support the \c nullDescriptor feature, e.g. MoltenVK. All
+   * resources are zero-initialized, so reads return zero just
+   * like they do for unbound resources in D3D. Writes go to the
+   * dummy resources and are discarded.
+   */
+  class DxvkNullResources {
+
+  public:
+
+    /**
+     * \brief Creates and initializes dummy resources
+     *
+     * \param [in] device DXVK device
+     * \param [in] context Context used to zero-initialize the
+     *    resources. Initialization is recorded into the context's
+     *    init command buffer, so the resources can be used right away.
+     */
+    DxvkNullResources(
+            DxvkDevice*           device,
+            DxvkContext*          context);
+
+    ~DxvkNullResources();
+
+    /**
+     * \brief Descriptor for an unbound uniform or storage buffer
+     * \returns Buffer descriptor covering the dummy buffer
+     */
+    DxvkLegacyDescriptor bufferDescriptor() const;
+
+    /**
+     * \brief Descriptor for an unbound texel buffer
+     *
+     * \param [in] storage Whether a storage texel buffer is needed
+     * \returns Buffer view descriptor
+     */
+    DxvkLegacyDescriptor bufferViewDescriptor(bool storage) const;
+
+    /**
+     * \brief Descriptor for an unbound image
+     *
+     * \param [in] viewType Image view type expected by the shader
+     * \param [in] storage Whether a storage image is needed
+     * \returns Image descriptor
+     */
+    DxvkLegacyDescriptor imageViewDescriptor(
+            VkImageViewType       viewType,
+            bool                  storage) const;
+
+  private:
+
+    Rc<DxvkBuffer>      m_buffer;
+    Rc<DxvkBufferView>  m_bufferViewUniform;
+    Rc<DxvkBufferView>  m_bufferViewStorage;
+
+    Rc<DxvkImage>       m_image1D[2];
+    Rc<DxvkImage>       m_image2D[2];
+    Rc<DxvkImage>       m_image3D[2];
+
+    std::array<Rc<DxvkImageView>, 7> m_views[2];
+
+    Rc<DxvkImage> createImage(
+            DxvkDevice*           device,
+            VkImageType           type,
+            uint32_t              layers,
+            bool                  storage);
+
+    Rc<DxvkImageView> createView(
+      const Rc<DxvkImage>&        image,
+            VkImageViewType       type,
+            uint32_t              layers,
+            bool                  storage);
+
+  };
+
+}
diff --git a/src/dxvk/dxvk_shader.cpp b/src/dxvk/dxvk_shader.cpp
index a133519..f0accd0 100644
--- a/src/dxvk/dxvk_shader.cpp
+++ b/src/dxvk/dxvk_shader.cpp
@@ -400,8 +400,11 @@ namespace dxvk {
     rsInfo.polygonMode        = VK_POLYGON_MODE_FILL;
     rsInfo.lineWidth          = 1.0f;
 
-    // Only use the fixed depth clip state if we can't make it dynamic
-    if (!m_device->features().extExtendedDynamicState3.extendedDynamicState3DepthClipEnable) {
+    // Only use the fixed depth clip state if we can't make it dynamic.
+    // Without depth clip support, disabling depth clamp enables clipping.
+    if (!m_device->features().extDepthClipEnable.depthClipEnable) {
+      rsInfo.depthClampEnable = VK_FALSE;
+    } else if (!m_device->features().extExtendedDynamicState3.extendedDynamicState3DepthClipEnable) {
       rsDepthClipInfo.pNext = std::exchange(rsInfo.pNext, &rsDepthClipInfo);
       rsDepthClipInfo.depthClipEnable = VK_TRUE;
     }
