From 7008d3d0c768e3f768361a55e27aa97f7f840240 Mon Sep 17 00:00:00 2001
From: W1nkelm4nn <mrmarkap61@gmail.com>
Date: Wed, 28 Oct 2026 20:32:02 +0100
Subject: [PATCH] MSL: Keep color image arrays that are sampled with depth
 compare.

Vulkan ignores the Depth operand of OpTypeImage, and dxil-spirv samples
bindless color image declarations with SampleCmp and GatherCmp too.
Marking the whole variable as a comparison image declared every texture
in the array as depth2d, so normal samples in the same shader returned
the red channel only. In argument buffers, keep the color declaration
and reinterpret the descriptor as the depth type where it is compared.
---
 spirv_msl.cpp | 71 ++++++++++++++++++++++++++++++++++++++++++++++-----
 spirv_msl.hpp |  6 +++++
 2 files changed, 70 insertions(+), 7 deletions(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 9758a3ca..fe5d9a8f 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -1743,6 +1743,7 @@ string CompilerMSL::compile()
 	build_function_control_flow_graphs_and_analyze();
 	update_active_builtins();
 	analyze_image_and_sampler_usage();
+	demote_compare_color_images();
 	analyze_sampled_image_usage();
 	analyze_interlocked_resource_usage();
 	analyze_workgroup_variables();
@@ -6764,6 +6765,19 @@ void CompilerMSL::emit_custom_functions()
 			statement("");
 			break;
 
+		case SPVFuncImplCastToDepth:
+			statement("// Reinterprets a color texture descriptor as the depth texture it refers to.");
+			for (const char *space : { "constant", "device", "thread" })
+			{
+				statement("template<typename D, typename T>");
+				statement("inline const ", space, " D& spvAsDepth(const ", space, " T& t)");
+				begin_scope();
+				statement("return reinterpret_cast<const ", space, " D&>(t);");
+				end_scope();
+			}
+			statement("");
+			break;
+
 		case SPVFuncImplGatherCompareSwizzle:
 			statement("// Wrapper function that swizzles depth texture gathers.");
 			statement("template<typename Tex, typename... Ts>");
@@ -12307,8 +12321,6 @@ string CompilerMSL::to_function_name(const TextureFunctionNameArguments &args)
 		return is_compare ? "spvGatherCompareConstOffsets" : "spvGatherConstOffsets";
 	}
 
-	auto *combined = maybe_get<SPIRCombinedImageSampler>(img);
-
 	// Texture reference
 	string fname;
 	if (needs_chroma_reconstruction(constexpr_sampler) && !is_dynamic_img_sampler)
@@ -12417,7 +12429,7 @@ string CompilerMSL::to_function_name(const TextureFunctionNameArguments &args)
 	}
 	else
 	{
-		fname = to_expression(combined ? combined->image : img) + ".";
+		fname = to_texture_expression(img, args.has_dref) + ".";
 
 		// Texture function and sampler
 		if (args.base.is_fetch)
@@ -12434,6 +12446,52 @@ string CompilerMSL::to_function_name(const TextureFunctionNameArguments &args)
 	return fname;
 }
 
+// Vulkan ignores the Depth operand of OpTypeImage, so dxil-spirv samples bindless color image declarations with
+// depth compare too. Promoting such an array to depth textures would sample every color texture in it as depth,
+// which returns the red channel only. Keep the color declaration and reinterpret the descriptor where compared.
+void CompilerMSL::demote_compare_color_images()
+{
+	if (!msl_options.argument_buffers)
+		return;
+
+	ir.for_each_typed_id<SPIRVariable>([&](uint32_t, SPIRVariable &var) {
+		if (var.storage != StorageClassUniformConstant || !comparison_ids.count(var.self))
+			return;
+		auto &type = get_variable_data_type(var);
+		if (type.basetype != SPIRType::Image || type.image.depth || type.image.sampled == 2)
+			return;
+		if (!descriptor_set_is_argument_buffer(get_decoration(var.self, DecorationDescriptorSet)))
+			return;
+		comparison_ids.erase(var.self);
+		compare_color_images.insert(var.self);
+	});
+}
+
+bool CompilerMSL::is_compare_color_image(uint32_t id)
+{
+	if (compare_color_images.empty())
+		return false;
+	auto *var = maybe_get<SPIRVariable>(id);
+	if (!var)
+		var = maybe_get_backing_variable(id);
+	return var && compare_color_images.count(var->basevariable ? uint32_t(var->basevariable) : uint32_t(var->self));
+}
+
+string CompilerMSL::to_texture_expression(uint32_t img, bool dref)
+{
+	auto *combined = maybe_get<SPIRCombinedImageSampler>(img);
+	uint32_t image_id = combined ? uint32_t(combined->image) : img;
+	string expr = to_expression(image_id);
+	if (!dref || !is_compare_color_image(image_id))
+		return expr;
+
+	SPIRType depth_type = expression_type(image_id);
+	depth_type.image.depth = true;
+	depth_type.image.format = ImageFormatUnknown;
+	add_spv_func_and_recompile(SPVFuncImplCastToDepth);
+	return join("spvAsDepth<", image_type_glsl(depth_type, 0, false), ">(", expr, ")");
+}
+
 string CompilerMSL::convert_to_f32(const string &expr, uint32_t components)
 {
 	SPIRType t { components > 1 ? OpTypeVector : OpTypeFloat };
@@ -12483,13 +12541,12 @@ string CompilerMSL::to_function_args(const TextureFunctionArguments &args, bool
 		else if ((!constexpr_sampler || !constexpr_sampler->ycbcr_conversion_enable) &&
 		         msl_options.swizzle_texture_samples && args.base.is_gather)
 		{
-			auto *combined = maybe_get<SPIRCombinedImageSampler>(img);
-			farg_str += to_expression(combined ? combined->image : img);
+			farg_str += to_texture_expression(img, args.dref != 0);
 		}
 
 		// Gathers with constant offsets call a special function, so include the texture.
 		if (args.has_array_offsets)
-			farg_str += to_expression(img);
+			farg_str += to_texture_expression(img, args.dref != 0);
 
 		// Sampler reference
 		if (!args.base.is_fetch)
@@ -17426,7 +17483,7 @@ string CompilerMSL::image_type_glsl(const SPIRType &type, uint32_t id, bool memb
 
 	auto &img_type = type.image;
 
-	if (is_depth_image(type, id))
+	if (is_depth_image(type, id) && !is_compare_color_image(id))
 	{
 		switch (img_type.dim)
 		{
diff --git a/spirv_msl.hpp b/spirv_msl.hpp
index de8608f6..f921b476 100644
--- a/spirv_msl.hpp
+++ b/spirv_msl.hpp
@@ -829,6 +829,7 @@ protected:
 		SPVFuncImplGatherCompareReturn,
 		SPVFuncImplGatherSwizzle,
 		SPVFuncImplGatherCompareSwizzle,
+		SPVFuncImplCastToDepth,
 		SPVFuncImplGatherConstOffsets,
 		SPVFuncImplGatherCompareConstOffsets,
 		SPVFuncImplSubgroupBroadcast,
@@ -957,6 +958,9 @@ protected:
 	std::string to_name(uint32_t id, bool allow_alias = true) const override;
 	std::string to_function_name(const TextureFunctionNameArguments &args) override;
 	std::string to_function_args(const TextureFunctionArguments &args, bool *p_forward) override;
+	std::string to_texture_expression(uint32_t img, bool dref);
+	void demote_compare_color_images();
+	bool is_compare_color_image(uint32_t id);
 	std::string to_initializer_expression(const SPIRVariable &var) override;
 	std::string to_zero_initialized_expression(uint32_t type_id) override;
 
@@ -1322,6 +1326,8 @@ protected:
 	const MSLConstexprSampler *find_constexpr_sampler(uint32_t id) const;
 
 	std::unordered_set<uint32_t> buffers_requiring_array_length;
+	// Color image variables in argument buffers that are also sampled with depth compare
+	std::unordered_set<uint32_t> compare_color_images;
 	SmallVector<uint32_t> buffer_aliases_discrete;
 	std::unordered_set<uint32_t> atomic_image_vars_emulated; // Emulate texture2D atomic operations
 	std::unordered_set<uint32_t> pull_model_inputs;
